        </svg></span><span>Orders</span></a></li>
      <li><a href="/tezgrani/category-management"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="m260-520 220-360 220 360H260ZM700-80q-75 0-127.5-52.5T520-260q0-75 52.5-127.5T700-440q75 0 127.5 52.5T880-260q0 75-52.5 127.5T700-80Zm-580-20v-320h320v320H120Zm580-60q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Zm-500-20h160v-160H200v160Zm202-420h156l-78-126-78 126Zm78 0ZM360-340Zm340 80Z" />
        </svg></span><span>Category</span></a></li>
      <li><a href="/tezgrani/product-management"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="M200-80q-33 0-56.5-23.5T120-160v-451q-18-11-29-28.5T80-680v-120q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v120q0 23-11 40.5T840-611v451q0 33-23.5 56.5T760-80H200Zm0-520v440h560v-440H200Zm-40-80h640v-120H160v120Zm200 280h240v-80H360v80Zm120 20Z" />
        </svg></span><span>Products</span></a></li>
      <li><a href="/tezgrani/user-management"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="M0-240v-63q0-43 44-70t116-27q13 0 25 .5t23 2.5q-14 21-21 44t-7 48v65H0Zm240 0v-65q0-32 17.5-58.5T307-410q32-20 76.5-30t96.5-10q53 0 97.5 10t76.5 30q32 20 49 46.5t17 58.5v65H240Zm540 0v-65q0-26-6.5-49T754-397q11-2 22.5-2.5t23.5-.5q72 0 116 26.5t44 70.5v63H780Zm-455-80h311q-10-20-55.5-35T480-370q-55 0-100.5 15T325-320ZM160-440q-33 0-56.5-23.5T80-520q0-34 23.5-57t56.5-23q34 0 57 23t23 57q0 33-23 56.5T160-440Zm640 0q-33 0-56.5-23.5T720-520q0-34 23.5-57t56.5-23q34 0 57 23t23 57q0 33-23 56.5T800-440Zm-320-40q-50 0-85-35t-35-85q0-51 35-85.5t85-34.5q51 0 85.5 34.5T600-600q0 50-34.5 85T480-480Zm0-80q17 0 28.5-11.5T520-600q0-17-11.5-28.5T480-640q-17 0-28.5 11.5T440-600q0 17 11.5 28.5T480-560Zm1 240Zm-1-280Z" />
        </svg></span><span>Users</span></a></li>
      <li><a href="/tezgrani/deals-management"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="M160-280v80h640v-80H160Zm0-440h88q-5-9-6.5-19t-1.5-21q0-50 35-85t85-35q30 0 55.5 15.5T460-826l20 26 20-26q18-24 44-39t56-15q50 0 85 35t35 85q0 11-1.5 21t-6.5 19h88q33 0 56.5 23.5T880-640v440q0 33-23.5 56.5T800-120H160q-33 0-56.5-23.5T80-200v-440q0-33 23.5-56.5T160-720Zm0 320h640v-240H596l84 114-64 46-136-184-136 184-64-46 82-114H160v240Zm200-320q17 0 28.5-11.5T400-760q0-17-11.5-28.5T360-800q-17 0-28.5 11.5T320-760q0 17 11.5 28.5T360-720Zm240 0q17 0 28.5-11.5T640-760q0-17-11.5-28.5T600-800q-17 0-28.5 11.5T560-760q0 17 11.5 28.5T600-720Z" />
        </svg></span><span>Deals</span></a></li>
      <li class="active"><a href="/tezgrani/return-management"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="M360-240 120-480l240-240 56 56-144 144h488v-160h80v240H272l144 144-56 56Z" />
        </svg></span><span>Returns</span></a></li>
      <li><a href="/tezgrani/sales-report"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="M640-160v-280h160v280H640Zm-240 0v-640h160v640H400Zm-240 0v-440h160v440H160Z" />
        </svg></span><span>Sales Report</span></a></li>
      <li><a href="/tezgrani/gallery-management"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm0-80h640v-480H160v480Zm80-80h480L570-520 450-360l-90-120-120 160Zm-80 80v-480 480Z" />
        </svg></span><span>Gallery</span></a></li>
      <li><a href="#" onclick="showLogoutModal()"><span class="icon-svg"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
          <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z" />
        </svg></span><span>Log-out</span></a></li>
    </ul>
    <button class="floating-toggle-btn" onclick="toggleSidebar()">
      <svg id="drawer-icon" xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#fff">
        <path d="M360-120v-720h80v720h-80Zm160-160v-400l200 200-200 200Z" />
      </svg>
    </button>
  </div>

  <div class="content">
    <div class="table-container">
      <div class="table-wrapper">
        <div class="table-header">
          <h2 class="table-title">Return Management</h2>
          <div class="buttons">
            <button class="sort-btn" id="sortByDate">Sort by Date</button>
          </div>
        </div>
        <div class="table-body">
          <table class="product-table" id="ordersTable">
            <thead>
              <tr>
                <th>SI. NO.</th>
                <th>ORDER ID</th>
                <th>USER NAME</th>
                <th>Qty</th>
                <th>Date</th>
                <th>Total Amount</th>
                <th>STATUS</th>
                <th>ACTION</th>
              </tr>
            </thead>
            <tbody>
              <% if (orders.length === 0) { %>
              <tr>
                <td colspan="8">
                  <div style="width: 105%; display: flex; align-items: center; justify-content: center; font-weight: 500; font-size: 1.9rem; color: #666;">
                    No Return found.
                  </div>
                </td>
              </tr>
              <% } else { %>
              <% orders.forEach((order, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= order.orderId.slice(0,6).toUpperCase() %></td>
                <td><%= order.userName %></td>
                <td><%= order.orderedItems.reduce((sum, item) => sum + item.quantity, 0) %></td>
                <td><%= new Date(order.invoiceDate).toISOString().split('T')[0] %></td>
                <td><%= order.finalAmount %>₹</td>
                <td><span class="status-text"><%= order.status %></span></td>
                <td class="actions">
                  <% if (order.status !== 'Request Declined' && order.status !== 'Returned') { %>
                  <div class="tooltip"><a href="#" class="btn view-btn" onclick="showStatusModal('<%= order.orderId %>', '<%= order.returnReason %>')"><span class="material-symbols-outlined">mystery</span></a><span class="tooltiptext">Review</span></div>
                  <% } %>
                  <div class="tooltip"><a href="/tezgrani/order-details/<%= order.orderId %>" class="btn view-btn"><span class="material-symbols-outlined">visibility</span></a><span class="tooltiptext">View</span></div>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <nav aria-label="Admin page navigation" class="custom-pagination">
      <ul class="pagination-list">
        <li class="pagination-item <%= currentPage === 1 ? 'disabled' : '' %>">
          <span class="pagination-link" href="/tezgrani/return-management?page=<%= currentPage - 1 %>&search=<%= searchQuery || '' %>&sortDate=<%= sortDate || '' %>" <%= currentPage === 1 ? 'tabindex="-1" aria-disabled="true"' : '' %>>Previous</>
        </li>
        <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="pagination-item <%= currentPage === i ? 'active' : '' %>">
          <a class="pagination-link" href="/tezgrani/return-management?page=<%= i %>&search=<%= searchQuery || '' %>&sortDate=<%= sortDate || '' %>"><%= i %></a>
        </li>
        <% } %>
        <li class="pagination-item <%= currentPage === totalPages ? 'disabled' : '' %>">
          <span class="pagination-link" href="/tezgrani/return-management?page=<%= currentPage + 1 %>&search=<%= searchQuery || '' %>&sortDate=<%= sortDate || '' %>" <%= currentPage === totalPages ? 'tabindex="-1" aria-disabled="true"' : '' %>>Next</>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Status Modal -->
  <div id="status-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 style="margin-bottom: 0; font-weight: 500;">Confirm Action</h3>
        <span class="close-modal" onclick="document.getElementById('status-modal').style.display='none'">×</span>
      </div>
      <div class="modal-body">
        <h4>Reason for return:</h4><br>
        <p id="return-reason"></p>
      </div>
      <div class="modal-footer">
        <button id="approve-btn" class="btn-yes" style="margin-top: 10px;">Approve</button>
        <button id="decline-btn" class="btn-no" style="margin-top: 10px; margin-left: 10px;">Decline</button>
      </div>
    </div>
  </div>

  <!-- Logout Modal -->
  <div id="logout-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3 style="font-size: 1.7rem !important; font-weight: 500;">Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-logout" class="btn-no">NO</button>
        <button id="confirm-logout" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <script>
    window.updateOrderStatus = function(orderId, action) {
      fetch('/tezgrani/update-return-status', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            orderId,
            action
          }),
        })
        .then(response => {
          if (!response.ok) throw new Error('Network response was not ok');
          return response.json();
        })
        .then(data => {
          toastr.success(data.message || `Order status updated to ${action === 'approve' ? 'Returned' : 'Request Declined'}`);
          setTimeout(() => location.reload(), 1600);
        })
        .catch(error => {
          toastr.error('Failed to update status: ' + error.message);
        });
    };

    document.addEventListener("DOMContentLoaded", function() {
      // Sidebar Toggle Logic
      const sidebar = document.getElementById("adminSidebar");
      const icon = document.getElementById("drawer-icon");
      const toggleBtn = document.querySelector(".floating-toggle-btn");

      function toggleSidebar() {
        sidebar.classList.toggle("collapsed");
        icon.style.transform = sidebar.classList.contains("collapsed") ? "rotate(0deg)" : "rotate(180deg)";
      }

      toggleBtn.addEventListener("click", toggleSidebar);

      // Logout Modal Logic
      const logoutModal = document.getElementById("logout-modal");
      const confirmLogoutBtn = document.getElementById("confirm-logout");
      const cancelLogoutBtn = document.getElementById("cancel-logout");

      window.showLogoutModal = function() {
        logoutModal.style.display = "flex";
      };

      confirmLogoutBtn.addEventListener("click", function() {
        logoutModal.style.display = "none";
        window.location.href = "/tezgrani/logout";
      });

      cancelLogoutBtn.addEventListener("click", function() {
        logoutModal.style.display = "none";
      });

      window.addEventListener("click", function(e) {
        if (e.target === logoutModal) logoutModal.style.display = "none";
      });

      // Status Modal Logic
      const statusModal = document.getElementById("status-modal");
      const approveBtn = document.getElementById("approve-btn");
      const declineBtn = document.getElementById("decline-btn");
      let currentOrderId, currentReturnReason;

      window.showStatusModal = function(orderId, returnReason) {
        currentOrderId = orderId;
        currentReturnReason = returnReason;
        document.getElementById("return-reason").textContent = currentReturnReason || 'No reason provided';
        statusModal.style.display = "flex";
      };

      approveBtn.addEventListener("click", function() {
        statusModal.style.display = "none";
        updateOrderStatus(currentOrderId, 'approve');
      });

      declineBtn.addEventListener("click", function() {
        statusModal.style.display = "none";
        updateOrderStatus(currentOrderId, 'decline');
      });

      window.addEventListener("click", function(e) {
        if (e.target === statusModal) statusModal.style.display = "none";
      });

      // Flatpickr Date Picker Logic
      const sortBtn = document.getElementById('sortByDate');
      let flatpickrInstance = null;

      sortBtn.addEventListener('click', function() {
        if (!flatpickrInstance) {
          flatpickrInstance = flatpickr(sortBtn, {
            dateFormat: 'd-m-Y',
            onChange: function(selectedDates, dateStr, instance) {
              if (selectedDates.length > 0) {
                sortBtn.textContent = dateStr;
                $('input[name="sortDate"]').val(dateStr);
                $('form.search-bar').submit();
              }
            },
            onClose: function(selectedDates, dateStr, instance) {
              if (selectedDates.length === 0) {
                sortBtn.textContent = 'Sort by Date';
                $('input[name="sortDate"]').val('');
                $('form.search-bar').submit();
              }
            }
          });
        }
        flatpickrInstance.open();
      });
    });
  </script>
</body>

</html>