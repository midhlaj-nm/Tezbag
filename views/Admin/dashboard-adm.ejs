          </svg>
        </span>
        <span>Sales Report</span>
      </li>

      <li>
        <span class="icon-svg">
          <!-- Banners -->
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
            <path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm0-80h640v-480H160v480Zm80-80h480L570-520 450-360l-90-120-120 160Zm-80 80v-480 480Z"/>
          </svg>
        </span>
        <span>Banners</span>
      </li>

      <li>
        <span class="icon-svg">
          <!-- Log-out -->
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
            <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z"/>
          </svg>
        </span>
        <span>Log-out</span>
      </li>
    </ul>

    <!-- Floating Toggle Button -->
    <button class="floating-toggle-btn" onclick="toggleSidebar()">
      <svg id="drawer-icon" xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" fill="#000000">
        <path d="M360-120v-720h80v720h-80Zm160-160v-400l200 200-200 200Z"/>
      </svg>
    </button>
  </div>

  <!-- Content Area -->
  <div class="content">
    <h1>Welcome <span style="color: #00B207;"><%= name %></span> to Admin Dashboard</h1>
    
    <div class="login-reg-container">
      <div class="login-reg">
        <div class="punch-box">
          <div class="date-time">
            <h3 id="greeting">Good Morning, <span style="color: #00B207;"><%= name %></span>!</h3>
            <p id="current-day-date">Friday, April 18, 2025</p>
            <p id="current-time" style="font-size:2rem;">09:15:23 AM</p>
          </div>
        
          <div class="punch-status">
            <p id="punch-info">You have not punched in yet.</p>
            <button id="punchBtn" onclick="togglePunch()" style="font-family:'Poppins', sans-serif;">Punch In</button>
          </div>
        </div>        
      </div>
      <div class="last-logins">
        <div class="card">
          <div class="card-header">
            <h3>Users</h3>
            <a href="/tezgrani/logins" class="view-all">View All</a>
          </div>
        
          <table class="table">
            <thead>
              <tr>
                <th>NAME</th>
                <th>EMAIL</th>
                <th>CREATED_ON</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentLogins.length === 0) { %>
                <tr>
                  <td colspan="3" style="text-align:center; height: 200px; font-weight: 500; vertical-align: middle;">
                    No data to show
                  </td>
                </tr>
              <% } else { %>
                <% recentLogins.forEach(user => { %>
                  <tr>
                    <td><%= user.f_Name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.createdOn ? new Date(user.createdOn).toLocaleDateString() : 'N/A' %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>        
      </div>
      <div class="recently-sold-container">
        <div class="header-row">
          <h3 class="heading">Recently Sold Items</h3>
          <a href="#" class="view-all">View All</a>
        </div>
        
        <div class="table-container">
          <table class="sales-table">
            <thead style="background-color: #e9ecef;">
              <tr>
                <th>PRODUCT_ID</th>
                <th>DATE</th>
                <th>QUANTITY</th>
                <th>TOTAL AMOUNT</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentOrders.length === 0) { %>
                <tr>
                  <td colspan="4">
                    <div style="
                      height: 360px;
                      display: flex;
                      align-items: center;
                      justify-content: center;
                      font-weight: 500;
                      font-size: 1.1rem;
                      color: #666;
                    ">
                      No data to show right now!
                    </div>
                  </td>
                </tr>
              <% } else { %>
                <% recentOrders.forEach(order => { %>
                  <tr>
                    <td>#<%= order._id.toString().slice(-4) %></td>
                    <td><%= new Date(order.createdOn).toLocaleDateString() %></td>
                    <td><%= order.orderedItems.reduce((sum, item) => sum + item.quantity, 0) %> nos</td>
                    <td><%= order.finalAmount.toFixed(2) %> ₹</td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
                        
          </table>
        </div>
      </div>      
    </div>
  </div>

  <!-- JavaScript -->
  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById("adminSidebar");
      const icon = document.getElementById("drawer-icon");

      sidebar.classList.toggle("collapsed");

      if (sidebar.classList.contains("collapsed")) {
        icon.style.transform = "rotate(180deg)";
      } else {
        icon.style.transform = "rotate(0deg)";
      }
    }
    
  // Function to update time and greeting dynamically
      function updateDateTime() {
        const now = new Date();
      
        // Day and date
        const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August',
                        'September', 'October', 'November', 'December'];
        const day = days[now.getDay()];
        const date = `${day}, ${months[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;
        document.getElementById('current-day-date').innerText = date;
      
        // Time
        let hours = now.getHours();
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const seconds = now.getSeconds().toString().padStart(2, '0');
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12 || 12;
        const timeStr = `${hours}:${minutes}:${seconds} ${ampm}`;
        document.getElementById('current-time').innerText = timeStr;
      
        // Greeting
        let greeting = '';
        const hour = now.getHours();
        if (hour < 12) greeting = 'Good Morning';
        else if (hour < 17) greeting = 'Good Afternoon';
        else greeting = 'Good Evening';
        document.getElementById('greeting').innerHTML = `${greeting}, <span style="color: #00B207;"><%= name %></span>!`;
      }
    
      // Initial call and interval
      updateDateTime();
      setInterval(updateDateTime, 1000);
    
      // Load punch state from localStorage
      let isPunchedIn = false;
      window.onload = function () {
        const storedDate = localStorage.getItem('punchDate');
        const storedStatus = localStorage.getItem('isPunchedIn') === 'true';
        const today = new Date().toDateString();
      
        if (storedDate === today && storedStatus) {
          isPunchedIn = true;
          updatePunchUI('in', localStorage.getItem('punchTime'), storedDate);
        } else {
          localStorage.removeItem('punchDate');
          localStorage.setItem('isPunchedIn', 'false');
          isPunchedIn = false;
          updatePunchUI('out');
        }
      };
    
      // Toggle punch in/out
      function togglePunch() {
        isPunchedIn = !isPunchedIn;
      
        const now = new Date();
        const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const date = now.toDateString(); // e.g., "Fri Apr 19 2025"
      
        localStorage.setItem('isPunchedIn', isPunchedIn);
        localStorage.setItem('punchDate', date);
        localStorage.setItem('punchTime', time);
      
        if (isPunchedIn) {
          updatePunchUI('in', time, date);

          fetch('/tezgrani/punch-in', {
            method: 'PATCH',
          })
          .then(response => {
            if (!response.ok) throw new Error("Punch-in failed");
            return response.json();
          })
          .then(data => {
            console.log("🎉 Punch-in success:", data);
            toastr.success('You have successfully punched in!');
          })
          .catch(err => {
            console.error("❌ Error during punch-in:", err);
            toastr.error('Something went wrong while punching in.', 'Error');
          });

        } else {
          updatePunchUI('out', time, date);

          fetch('/tezgrani/punch-out', {
            method: 'PATCH',
          })
          .then(response => {
            if (!response.ok) throw new Error("Punch-out failed");
            return response.json();
          })
          .then(data => {
            console.log("📤 Punch-out success:", data);
            toastr.success('You have successfully punched out!', 'Punch-Out');
          })
          .catch(err => {
            console.error("❌ Error during punch-out:", err);
            toastr.error('Something went wrong while punching out.', 'Error');
          });
        }
      }
    
      // UI update function
      function updatePunchUI(status, time = '', date = '') {
        const punchInfo = document.getElementById('punch-info');
        const punchBtn = document.getElementById('punchBtn');
      
        if (status === 'in') {
          punchInfo.innerText = `You punched in at ${time} on ${date}`;
          punchBtn.innerText = 'Punch Out';
          punchBtn.style.backgroundColor = '#dc3545'; // red
        } else if (status === 'out' && time && date) {
          punchInfo.innerText = `You punched out at ${time} on ${date}`;
          punchBtn.innerText = 'Punch In';
          punchBtn.style.backgroundColor = '#00B207'; // green
        } else {
          punchInfo.innerText = 'You have not punched in yet.';
          punchBtn.innerText = 'Punch In';
          punchBtn.style.backgroundColor = '#00B207'; // green
        }
      }



  </script>

</body>
</html>
