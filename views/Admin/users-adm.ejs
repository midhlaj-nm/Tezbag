  <!-- Content Area -->
  <div class="content">
    <div class="table-container">
      <div class="table-wrapper">
  
        <!-- Moved heading inside wrapper -->
        <div class="table-header">
          <h2 class="table-title">Users</h2>
        </div>
  
        <table class="user-table">
          <thead>
            <tr>
              <th>F-NAME</th>
              <th>L-NAME</th>
              <th>EMAIL</th>
              <th>STATUS</th>
              <th>CREATED ON</th>
              <th style="text-align: left;">ACTIONS</th>
            </tr>
          </thead>
          <tbody>
            <% if (!users || users.length === 0) { %>
              <tr>
                <td colspan="5" style="padding: 1rem;">
                  <div style="
                    width: 124%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 500;
                    font-size: 1.1rem;
                    color: #666;
                  ">
                    No data to show right now!
                  </div>
                </td>
              </tr>
            <% } %>
            <% users.forEach(user => { %>
              <tr>
                <td><%= user.f_Name %></td>
                <td><%= user.l_Name %></td>
                <td><%= user.email %></td>
                <td class="status <%= user.isBlocked ? 'inactive' : 'active' %>">
                  <%= user.isBlocked ? 'Blocked ❌' : 'Active ✅' %>
                </td>
                <td><%= user.createdOn.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                <td class="actions">
                    <a href="#" class="btn block-toggle" data-userid="<%= user._id %>" data-status="<%= user.isBlocked %>">
                        <%= user.isBlocked ? 'UNBLOCK' : 'BLOCK' %>
                    </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="pagination">
      <% const total = Math.max(totalPages, 3); %>
      <% for (let i = 1; i <= total; i++) { %>
        <% if (i <= totalPages) { %>
          <a href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">
            <div class="dot <%= currentPage === i ? 'active' : '' %>"></div>
          </a>
        <% } else { %>
          <div class="dot inactive"></div>
        <% } %>
      <% } %>
    </div>
  </div>
  



<!-- ======================== logout modal ================================= -->
<div id="logout-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3>Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-logout" class="btn-no">NO</button>
        <button id="confirm-logout" class="btn-yes">YES</button>
      </div>
    </div>
</div>
  

<script>
    function toggleSidebar() {
      const sidebar = document.getElementById("adminSidebar");
      const icon = document.getElementById("drawer-icon");

      sidebar.classList.toggle("collapsed");

      if (sidebar.classList.contains("collapsed")) {
        icon.style.transform = "rotate(0deg)";
      } else {
        icon.style.transform = "rotate(180deg)";
      }
    }


    document.addEventListener("DOMContentLoaded", function () {
    const toggleButtons = document.querySelectorAll(".block-toggle");
    const modal = document.getElementById("logout-modal");
    const cancelBtn = document.getElementById("cancel-logout");
    const confirmBtn = document.getElementById("confirm-logout");

    let selectedUserId = null;
    let selectedButton = null;
    let selectedCurrentStatus = null;

    toggleButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        e.preventDefault();

        selectedUserId = button.dataset.userid;
        selectedCurrentStatus = button.dataset.status === "true";
        selectedButton = button;

        modal.style.display = "flex"; // Show the confirmation modal
      });
    });

    cancelBtn.addEventListener("click", function () {
      modal.style.display = "none"; // Just close the modal
      selectedUserId = null;
      selectedButton = null;
    });

    confirmBtn.addEventListener("click", async function () {
      try {
        const response = await fetch(`/tezgrani/user/block-toggle/${selectedUserId}`, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ isBlocked: !selectedCurrentStatus }),
        });

        const result = await response.json();

        if (result.success) {
          // Update button text
          selectedButton.textContent = selectedCurrentStatus ? "BLOCK" : "UNBLOCK";
          selectedButton.dataset.status = (!selectedCurrentStatus).toString();

          // Update status text and class
          const row = selectedButton.closest("tr");
          const statusCell = row.querySelector(".status");
          statusCell.textContent = !selectedCurrentStatus ? "Blocked ❌" : "Active ✅";
          statusCell.className = "status " + (!selectedCurrentStatus ? "inactive" : "active");
        } else {
          alert("Failed to update user status.");
        }
      } catch (error) {
        console.error("Toggle error:", error);
        alert("Something went wrong");
      }

      // Reset & close modal
      modal.style.display = "none";
      selectedUserId = null;
      selectedButton = null;
    });

    // Close modal if clicked outside
    window.addEventListener("click", function (e) {
      if (e.target === modal) {
        modal.style.display = "none";
        selectedUserId = null;
        selectedButton = null;
      }
    });
  });
</script>

</body>
</html>