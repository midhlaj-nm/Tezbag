<!-- Content Area -->
<div class="content">
  <h1 style="font-weight: 500;">Sales Report</h1>

  <!-- Filter Section -->
  <div class="filter-section">
    <div class="filter-group">
      <div class="date-controls">
        <div class="date-item">
          <label for="start-date">Start:</label>
          <button id="start-date-btn" onclick="openStartDatePicker()">Start Date</button>
        </div>
        <div class="date-item">
          <label for="end-date">To:</label>
          <button id="end-date-btn" onclick="openEndDatePicker()">End Date</button>
        </div>
      </div>
      <div class="sort-item">
        <label for="sort-btn">Sort By:</label>
        <select id="sort-btn" onchange="applySort()">
          <option value="today">Today</option>
          <option value="1day">1 Day</option>
          <option value="week">Week</option>
          <option value="month">Month</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Split Screen Layout -->
  <div class="split-screen">
    <!-- Upper Half: Scrollable Chart Boxes -->
    <div class="report-upper">
      <h2>Sales Summary</h2>
      <div class="chart-container">
        <div class="chart-box">
          <h3>Discount & Coupons Deduction</h3>
          <canvas id="couponChart"></canvas>
        </div>
        <div class="chart-box">
          <h3>Overall Sales Count</h3>
          <canvas id="salesCountChart"></canvas>
        </div>
        <div class="chart-box">
          <h3>Overall Order Amount</h3>
          <canvas id="orderAmountChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Lower Half: Chart -->
    <div class="report-lower">
      <h2>Overall Sales In Website</h2>
      <canvas id="salesChart"></canvas>
    </div>
  </div>
</div>

<!-- Logout Modal -->
<div id="logout-modal" class="modal" style="display:none;">
  <div class="modal-content">
    <h3 style="font-size: 1.75rem; font-weight: 500;">Are you sure?</h3>
    <div class="modal-buttons">
      <button id="cancel-logout" class="btn-no">NO</button>
      <button id="confirm-logout" class="btn-yes">YES</button>
    </div>
  </div>
</div>

<!-- JavaScript -->
<script>
  // Sidebar Toggle
  function toggleSidebar() {
    const sidebar = document.getElementById("adminSidebar");
    const icon = document.getElementById("drawer-icon");
    sidebar.classList.toggle("collapsed");
    if (sidebar.classList.contains("collapsed")) {
      icon.style.transform = "rotate(0deg)";
    } else {
      icon.style.transform = "rotate(180deg)";
    }
  }

  // Show logout modal
  function showLogoutModal() {
    const logoutModal = document.getElementById('logout-modal');
    logoutModal.style.display = 'flex';
  }

  // Setup event listeners for logout modal buttons
  document.addEventListener('DOMContentLoaded', function() {
    const logoutModal = document.getElementById('logout-modal');
    const confirmLogoutButton = document.getElementById('confirm-logout');
    const cancelLogoutButton = document.getElementById('cancel-logout');
    confirmLogoutButton.addEventListener('click', () => {
      logoutModal.style.display = 'none';
      window.location.href = '/tezgrani/logout';
    });
    cancelLogoutButton.addEventListener('click', () => {
      logoutModal.style.display = 'none';
    });
  });

  // Initialize flatpickr with inline mode on hidden containers
  let startDatePicker = flatpickr(document.createElement('div'), {
    inline: true,
    dateFormat: "d-m-Y",
    onChange: function(selectedDates, dateStr) {
      if (selectedDates.length > 0) {
        document.getElementById('start-date-btn').textContent = dateStr;
        endDatePicker.setDate(selectedDates[0]);
        endDatePicker.set("minDate", selectedDates[0]);
      }
    }
  }).calendarContainer;

  let endDatePicker = flatpickr(document.createElement('div'), {
    inline: true,
    dateFormat: "d-m-Y",
    onChange: function(selectedDates, dateStr) {
      if (selectedDates.length > 0) {
        document.getElementById('end-date-btn').textContent = dateStr;
      }
    }
  }).calendarContainer;

  // Append calendars to body with positioning
  document.body.appendChild(startDatePicker);
  document.body.appendChild(endDatePicker);
  startDatePicker.style.display = 'none';
  startDatePicker.className = 'date-picker';
  endDatePicker.style.display = 'none';
  endDatePicker.className = 'date-picker';

  // Open date pickers on button click with positioning
  function openStartDatePicker() {
    const btn = document.getElementById('start-date-btn');
    const rect = btn.getBoundingClientRect();
    startDatePicker.style.display = 'block';
    startDatePicker.style.position = 'absolute';
    startDatePicker.style.left = `${rect.left}px`;
    startDatePicker.style.top = `${rect.bottom + window.scrollY}px`;
    startDatePicker.focus();
  }

  function openEndDatePicker() {
    const btn = document.getElementById('end-date-btn');
    const rect = btn.getBoundingClientRect();
    endDatePicker.style.display = 'block';
    endDatePicker.style.position = 'absolute';
    endDatePicker.style.left = `${rect.left}px`;
    endDatePicker.style.top = `${rect.bottom + window.scrollY}px`;
    endDatePicker.focus();
  }

  // Hide calendars when clicking outside
  document.addEventListener('click', function(event) {
    if (!startDatePicker.contains(event.target) && event.target.id !== 'start-date-btn') {
      startDatePicker.style.display = 'none';
    }
    if (!endDatePicker.contains(event.target) && event.target.id !== 'end-date-btn') {
      endDatePicker.style.display = 'none';
    }
  });

  // Apply sorting based on selection
  function applySort() {
    const sortValue = document.getElementById('sort-btn').value;
    const today = new Date();
    let startDate, endDate;

    switch (sortValue) {
      case 'today':
        startDate = new Date(today);
        endDate = new Date(today);
        break;
      case '1day':
        startDate = new Date(today);
        endDate = new Date(today);
        startDate.setDate(today.getDate() - 1);
        break;
      case 'week':
        startDate = new Date(today);
        startDate.setDate(today.getDate() - 7);
        endDate = new Date(today);
        break;
      case 'month':
        startDate = new Date(today);
        startDate.setMonth(today.getMonth() - 1);
        endDate = new Date(today);
        break;
    }

    const startDateStr = startDate.toLocaleDateString('en-GB').split('/').reverse().join('-');
    const endDateStr = endDate.toLocaleDateString('en-GB').split('/').reverse().join('-');
    document.getElementById('start-date-btn').textContent = startDateStr;
    document.getElementById('end-date-btn').textContent = endDateStr;
    startDatePicker.setDate(startDate);
    endDatePicker.setDate(endDate);
    endDatePicker.set("minDate", startDate);
  }

  // Initialize static charts
  document.addEventListener('DOMContentLoaded', () => {
    // Static Coupon Chart
    const couponCtx = document.getElementById('couponChart').getContext('2d');
    new Chart(couponCtx, {
      type: 'bar',
      data: {
        labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July'],
        datasets: [{
          label: 'Customers Using Coupons',
          data: [15, 20, 25, 30, 35, 40, 45],
          backgroundColor: 'rgba(0, 178, 7, 0.6)',
          borderColor: 'rgba(0, 178, 7, 1)',
          borderWidth: 1
        }]
      },
      options: {
        scales: { y: { beginAtZero: true } },
        maintainAspectRatio: false
      }
    });

    // Static Sales Count Chart
    const salesCountCtx = document.getElementById('salesCountChart').getContext('2d');
    new Chart(salesCountCtx, {
      type: 'bar',
      data: {
        labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July'],
        datasets: [{
          label: 'Products Sold',
          data: [50, 75, 100, 125, 150, 175, 200],
          backgroundColor: 'rgba(0, 178, 7, 0.6)',
          borderColor: 'rgba(0, 178, 7, 1)',
          borderWidth: 1
        }]
      },
      options: {
        scales: { y: { beginAtZero: true } },
        maintainAspectRatio: false
      }
    });

    // Static Order Amount Chart
    const orderAmountCtx = document.getElementById('orderAmountChart').getContext('2d');
    new Chart(orderAmountCtx, {
      type: 'bar',
      data: {
        labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July'],
        datasets: [{
          label: 'Turnover ($)',
          data: [1000, 1500, 2000, 2500, 3000, 3500, 4000],
          backgroundColor: 'rgba(0, 178, 7, 0.6)',
          borderColor: 'rgba(0, 178, 7, 1)',
          borderWidth: 1
        }]
      },
      options: {
        scales: { y: { beginAtZero: true } },
        maintainAspectRatio: false
      }
    });

    // Static Sales Chart
    const salesCtx = document.getElementById('salesChart').getContext('2d');
    new Chart(salesCtx, {
      type: 'bar',
      data: {
        labels: ['July 07', 'July 08', 'July 09', 'July 10', 'July 11', 'July 12', 'July 13'],
        datasets: [{
          label: 'Sales Amount ($)',
          data: [500, 600, 700, 800, 900, 1000, 1100],
          backgroundColor: 'rgba(0, 178, 7, 0.6)',
          borderColor: 'rgba(0, 178, 7, 1)',
          borderWidth: 1
        }]
      },
      options: {
        scales: { y: { beginAtZero: true } },
        maintainAspectRatio: false
      }
    });
  });
</script>
</html>