  <div class="content">
    <div class="filter-section">
      <div class="filter-group">
        <div class="date-controls">
          <div class="date-item">
            <label for="start-date">Start:</label>
            <button id="start-date-btn" onclick="openStartDatePicker()"></button>
          </div>
          <div class="date-item">
            <label for="end-date">To:</label>
            <button id="end-date-btn" onclick="openEndDatePicker()"></button>
          </div>
        </div>
        <div class="sort-item">
          <label for="sort-btn">Sort By:</label>
          <select id="sort-btn" onchange="applySort()">
            <option value="today" <%= sort === 'today' ? 'selected' : '' %>>Today</option>
            <option value="1day" <%= sort === '1day' ? 'selected' : '' %>>1 Day</option>
            <option value="week" <%= sort === 'week' ? 'selected' : '' %>>Week</option>
            <option value="month" <%= sort === 'month' ? 'selected' : '' %>>Month</option>
          </select>
        </div>
      </div>
    </div>

    <div class="table-container">
      <div class="table-wrapper">
        <div class="table-header-inside">
          <h1 class="table-title">Sales Report</h1>
          <button class="download-btn" onclick="downloadReport()">Download</button>
        </div>
        
        <table class="sales-table">
          <thead>
            <tr>
              <th>Metric</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="font-size: 18px;">Total Orders</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.totalOrders %></td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Pending Orders</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.pendingOrders %></td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Total Order Amount</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.totalOrderAmount.toLocaleString('en-IN') %>₹</td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Total Discounts Given</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.totalDiscountGiven.toLocaleString('en-IN') %>₹</td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Coupon Discounts</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.couponDiscounts.toLocaleString('en-IN') %>₹</td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Product/Category Offers</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.productOffers.toLocaleString('en-IN') %>₹</td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Refunds</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.refunds.toLocaleString('en-IN') %>₹</td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Net Revenue</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.netRevenue.toLocaleString('en-IN') %>₹</td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Avg Order Value</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.avgOrderValue.toLocaleString('en-IN') %>₹</td>
            </tr>
            <tr>
              <td style="font-size: 18px;">Top Payment Methods</td>
              <td class="metric-value" style="font-size: 18px;"><%= salesData.topPaymentMethod %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="logout-modal" class="modal">
    <div class="modal-content">
      <h3 style="font-size: 1.7rem !important; font-weight: 500;">Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-logout" class="btn-no">NO</button>
        <button id="confirm-logout" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <script>
    // Sidebar Toggle
    function toggleSidebar() {
      const sidebar = document.getElementById("adminSidebar");
      const icon = document.getElementById("drawer-icon");
      sidebar.classList.toggle("collapsed");
      if (sidebar.classList.contains("collapsed")) {
        icon.style.transform = "rotate(0deg)";
      } else {
        icon.style.transform = "rotate(180deg)";
      }
    }

    // Show logout modal
    function showLogoutModal() {
      const logoutModal = document.getElementById('logout-modal');
      logoutModal.style.display = 'flex';
    }

    // Setup event listeners for logout modal buttons
    document.addEventListener('DOMContentLoaded', function() {
      const logoutModal = document.getElementById('logout-modal');
      const confirmLogoutButton = document.getElementById('confirm-logout');
      const cancelLogoutButton = document.getElementById('cancel-logout');
      confirmLogoutButton.addEventListener('click', () => {
        logoutModal.style.display = 'none';
        window.location.href = '/tezgrani/logout';
      });
      cancelLogoutButton.addEventListener('click', () => {
        logoutModal.style.display = 'none';
      });

      // Format and set initial dates
      const startDateBtn = document.getElementById('start-date-btn');
      const endDateBtn = document.getElementById('end-date-btn');

      // Helper function to format date
      function formatDate(dateString) {
          if (!dateString) return '';
          const date = new Date(dateString);
          const day = String(date.getDate()).padStart(2, '0');
          const month = String(date.getMonth() + 1).padStart(2, '0'); // Months are 0-indexed
          const year = date.getFullYear();
          return `${day}-${month}-${year}`;
      }

      startDateBtn.textContent = formatDate("<%= start %>");
      endDateBtn.textContent = formatDate("<%= end %>");
    });

    // Initialize flatpickr with inline mode on hidden containers
    let startDatePickerInstance = flatpickr(document.createElement('div'), {
      inline: true,
      dateFormat: "Y-m-d",
      defaultDate: "<%= start %>",
      onChange: function(selectedDates, dateStr) {
        if (selectedDates.length > 0) {
          const formattedDate = new Date(selectedDates[0]).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }).replace(/\//g, '-');
          document.getElementById('start-date-btn').textContent = formattedDate;
          endDatePickerInstance.setDate(selectedDates[0]);
          endDatePickerInstance.set("minDate", selectedDates[0]);
          applyFilters();
        }
      }
    });
    let endDatePickerInstance = flatpickr(document.createElement('div'), {
      inline: true,
      dateFormat: "Y-m-d",
      defaultDate: "<%= end %>",
      onChange: function(selectedDates, dateStr) {
        if (selectedDates.length > 0) {
          const formattedDate = new Date(selectedDates[0]).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }).replace(/\//g, '-');
          document.getElementById('end-date-btn').textContent = formattedDate;
          applyFilters();
        }
      }
    });

    // Store the calendar containers
    let startDatePicker = startDatePickerInstance.calendarContainer;
    let endDatePicker = endDatePickerInstance.calendarContainer;

    // Append calendars to body with positioning
    document.body.appendChild(startDatePicker);
    document.body.appendChild(endDatePicker);
    startDatePicker.style.display = 'none';
    startDatePicker.className = 'date-picker';
    endDatePicker.style.display = 'none';
    endDatePicker.className = 'date-picker';

    // Open date pickers on button click with positioning
    function openStartDatePicker() {
      const btn = document.getElementById('start-date-btn');
      const rect = btn.getBoundingClientRect();
      startDatePicker.style.display = 'block';
      startDatePicker.style.position = 'absolute';
      startDatePicker.style.left = `${rect.left}px`;
      startDatePicker.style.top = `${rect.bottom + window.scrollY}px`;
      startDatePicker.focus();
    }

    function openEndDatePicker() {
      const btn = document.getElementById('end-date-btn');
      const rect = btn.getBoundingClientRect();
      endDatePicker.style.display = 'block';
      endDatePicker.style.position = 'absolute';
      endDatePicker.style.left = `${rect.left}px`;
      endDatePicker.style.top = `${rect.bottom + window.scrollY}px`;
      endDatePicker.focus();
    }

    // Hide calendars when clicking outside
    document.addEventListener('click', function(event) {
      if (!startDatePicker.contains(event.target) && event.target.id !== 'start-date-btn') {
        startDatePicker.style.display = 'none';
      }
      if (!endDatePicker.contains(event.target) && event.target.id !== 'end-date-btn') {
        endDatePicker.style.display = 'none';
      }
    });

    // Apply filters and reload page with query parameters
    function applyFilters() {
      const startDate = startDatePickerInstance.selectedDates[0] ? flatpickr.formatDate(startDatePickerInstance.selectedDates[0], "Y-m-d") : "<%= start %>";
      const endDate = endDatePickerInstance.selectedDates[0] ? flatpickr.formatDate(endDatePickerInstance.selectedDates[0], "Y-m-d") : "<%= end %>";
      const sort = document.getElementById('sort-btn').value;
      window.location.href = `/tezgrani/sales-report?start=${startDate}&end=${endDate}&sort=${sort}`;
    }

    // Apply sorting based on selection
    function applySort() {
      const sortValue = document.getElementById('sort-btn').value;
      const today = new Date();
      let startDate, endDate;

      switch (sortValue) {
        case 'today':
          startDate = new Date(today);
          endDate = new Date(today);
          break;
        case '1day':
          startDate = new Date(today);
          endDate = new Date(today);
          startDate.setDate(today.getDate() - 1);
          break;
        case 'week':
          startDate = new Date(today);
          startDate.setDate(today.getDate() - 7);
          endDate = new Date(today);
          break;
        case 'month':
          startDate = new Date(today);
          startDate.setMonth(today.getMonth() - 1);
          endDate = new Date(today);
          break;
      }
      
      // Update the flatpickr instances with the new dates
      startDatePickerInstance.setDate(startDate);
      endDatePickerInstance.setDate(endDate);
      endDatePickerInstance.set("minDate", startDate);

      // Format for display on buttons
      document.getElementById('start-date-btn').textContent = startDate.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }).replace(/\//g, '-');
      document.getElementById('end-date-btn').textContent = endDate.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }).replace(/\//g, '-');

      applyFilters();
    }

    // Download report function
    function downloadReport() {
      const table = document.querySelector('.sales-table');
      const wb = XLSX.utils.table_to_book(table, { sheet: "Sales Report" });
      XLSX.writeFile(wb, 'sales_report.xlsx');
    }
  </script>
</body>
</html>