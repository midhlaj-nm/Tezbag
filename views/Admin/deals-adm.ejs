        </a>
      </li>
      <li>
        <a href="/tezgrani/sales-report">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M640-160v-280h160v280H640Zm-240 0v-640h160v640H400Zm-240 0v-440h160v440H160Z"/>
            </svg>
          </span>
          <span>Sales Report</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/gallery-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm0-80h640v-480H160v480Zm80-80h480L570-520 450-360l-90-120-120 160Zm-80 80v-480 480Z"/>
            </svg>
          </span>
          <span>Gallery</span>
        </a>
      </li>
      <li>
        <a href="#" onclick="showLogoutModal()">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z"/>
            </svg>
          </span>
          <span>Log-out</span>
        </a>
      </li>
    </ul>
    <button class="floating-toggle-btn" onclick="toggleSidebar()">
      <svg id="drawer-icon" xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" fill="#000000">
        <path d="M360-120v-720h80v720h-80Zm160-160v-400l200 200-200 200Z"/>
      </svg>
    </button>
  </div>

  <div class="content">
    <div class="table-container">
      <div class="table-wrapper">
        <div class="table-header">
          <h2 class="table-title">Deals Management</h2>
          <div class="buttons">
            <a href="#" class="add-product-btn" id="openPopup">Add Deal</a>
          </div>
        </div>

        <!-- Tabbed Interface for Deals -->
        <div class="table-body">
          <!-- Tab Buttons -->
          <div class="tab-container">
            <button class="tab-btn active" data-tab="percentage-offer">Percentage Discount</button>
            <button class="tab-btn" data-tab="coupon-offer">Coupon Offer</button>
          </div>

          <!-- Percentage Offer Tab -->
          <div class="tab-content active" id="percentage-offer">
            <table class="product-table">
              <thead>
                <tr>
                  <th>SI.NO</th>
                  <th>OFFER NAME</th>
                  <th>APPLIED TO</th>
                  <th>DISCOUNT</th>
                  <th>START DATE</th>
                  <th>END DATE</th>
                  <th>STATUS</th>
                  <th>ACTIONS</th>
                </tr>
              </thead>
              <tbody>
                <% const percentageDeals = deals.filter(deal => deal.offerType.toLowerCase() === 'percentage'); %>
                <% if (!percentageDeals || percentageDeals.length === 0) { %>
                  <tr>
                    <td colspan="8" style="padding: 1rem;">
                      <div style="
                        width: 105%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-weight: 500;
                        font-size: 1.1rem;
                        color: #666;
                      ">
                        No Percentage Offers to show right now!
                      </div>
                    </td>
                  </tr>
                <% } else { %>
                  <% percentageDeals.forEach((deal, index) => { %>
                    <tr>
                      <td><%= (currentPage - 1) * 10 + index + 1 %></td>
                      <td><%= deal.name %></td>
                      <td><%= deal.appliedTo ? deal.appliedTo.charAt(0).toUpperCase() + deal.appliedTo.slice(1) : 'N/A' %></td>
                      <td><%= deal.offerPrice %>%</td>
                      <td><%= new Date(deal.createdOn).toLocaleDateString('en-GB') %></td>
                      <td><%= new Date(deal.expireOn).toLocaleDateString('en-GB') %></td>
                      <td class="status <%= deal.status.toLowerCase().replace(' ', '-') %>">
                        <%= deal.status %>
                      </td>
                      <td class="actions">
                        <a href="#" class="btn edit-btn" 
                           data-dealid="<%= deal._id %>"
                           data-name="<%= deal.name %>"
                           data-offertype="<%= deal.offerType %>"
                           data-offerprice="<%= deal.offerPrice %>"
                           data-startdate="<%= deal.createdOn ? new Date(deal.createdOn.getTime() + (5.5 * 60 * 60 * 1000)).toISOString().split('T')[0] : '' %>"
                           data-enddate="<%= deal.expireOn ? new Date(deal.expireOn.getTime() + (5.5 * 60 * 60 * 1000)).toISOString().split('T')[0] : '' %>"
                           data-selectedtype="<%= deal.appliedTo || '' %>"
                           data-selecteditems='<%= JSON.stringify(deal.selectedItems || []) %>'>
                          EDIT
                        </a>
                        <a href="#" class="btn delete-btn toggle-status" 
                           data-dealid="<%= deal._id %>">
                          DELETE
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Coupon Offer Tab -->
          <div class="tab-content" id="coupon-offer">
            <table class="product-table">
              <thead>
                <tr>
                  <th>SI.NO</th>
                  <th>COUPON NAME</th>
                  <th>DISCOUNT</th>
                  <th>START DATE</th>
                  <th>END DATE</th>
                  <th>STATUS</th>
                  <th>ACTIONS</th>
                </tr>
              </thead>
              <tbody>
                <% const couponDeals = deals.filter(deal => deal.offerType.toLowerCase() === 'coupon'); %>
                <% if (!couponDeals || couponDeals.length === 0) { %>
                  <tr>
                    <td colspan="7" style="padding: 1rem;">
                      <div style="
                        width: 105%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-weight: 500;
                        font-size: 1.1rem;
                        color: #666;
                      ">
                        No Coupon Offers to show right now!
                      </div>
                    </td>
                  </tr>
                <% } else { %>
                  <% couponDeals.forEach((deal, index) => { %>
                    <tr>
                      <td><%= (currentPage - 1) * 10 + index + 1 %></td>
                      <td><%= deal.name %></td>
                      <td><%= deal.offerPrice %></td>
                      <td><%= new Date(deal.createdOn).toLocaleDateString('en-GB') %></td>
                      <td><%= new Date(deal.expireOn).toLocaleDateString('en-GB') %></td>
                      <td class="status <%= deal.status.toLowerCase().replace(' ', '-') %>">
                        <%= deal.status %>
                      </td>
                      <td class="actions">
                        <a href="#" class="btn edit-btn" 
                           data-dealid="<%= deal._id %>"
                           data-name="<%= deal.name %>"
                           data-offertype="coupon"
                           data-offerprice="<%= deal.offerPrice %>"
                           data-startdate="<%= deal.createdOn ? new Date(deal.createdOn.getTime() + (5.5 * 60 * 60 * 1000)).toISOString().split('T')[0] : '' %>"
                           data-enddate="<%= deal.expireOn ? new Date(deal.expireOn.getTime() + (5.5 * 60 * 60 * 1000)).toISOString().split('T')[0] : '' %>"
                           data-minpurchase="<%= deal.minPrice || 0 %>"
                           data-maxpurchase="<%= deal.maxPrice || 0 %>">
                          EDIT
                        </a>
                        <a href="#" class="btn delete-btn toggle-status" 
                           data-dealid="<%= deal._id %>">
                          DELETE
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- End Deals Table -->
      </div>
    </div>

    <% if (totalPages >= 1) { %>
      <nav aria-label="Admin page navigation" class="custom-pagination">
        <ul class="pagination-list">
          <li class="pagination-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <% if (currentPage === 1) { %>
              <span class="pagination-link">Previous</span>
            <% } else { %>
              <a class="pagination-link" href="?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">Previous</a>
            <% } %>
          </li>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="pagination-item <%= currentPage === i ? 'active' : '' %>">
              <a class="pagination-link" href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"><%= i %></a>
            </li>
          <% } %>
          <li class="pagination-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <% if (currentPage === totalPages) { %>
              <span class="pagination-link">Next</span>
            <% } else { %>
              <a class="pagination-link" href="?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">Next</a>
            <% } %>
          </li>
        </ul>
      </nav>
    <% } %>
  </div>

  <!-- Add Deal Popup -->
  <div class="overlay hidden" id="popupOverlay">
    <div class="popup">
      <div class="popup-header">
        <h2 class="popup-title" id="popupTitle">Add Deal</h2>
        <button class="close-btn" id="closePopup">×</button>
      </div>
      <div class="popup-content">
        <!-- Percentage Offer Form -->
        <form id="percentageForm" style="display: block;" novalidate>
          <input type="hidden" id="dealIdPercentage" name="dealId">
          <input type="hidden" name="offerType" value="percentage">
          <div class="form-group">
            <label for="offerNamePercentage">Offer Name</label>
            <input type="text" id="offerNamePercentage" name="offerName" placeholder="Enter Offer Name">
            <div id="errOfferNamePercentage" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="offerTypePercentage">Offer Type</label>
            <select id="offerTypePercentage" name="selectedType">
              <option value="" disabled selected hidden>Select Offer Type</option>
              <option value="category">Category</option>
              <option value="products">Products</option>
            </select>
            <div id="errOfferTypePercentage" class="errr-msg"></div>
          </div>
          <div class="form-group" id="categoryGroupPercentage" style="display: none;">
            <label>Categories</label>
            <div class="checkbox-container" id="categoriesMenuPercentage">
              <div class="checkbox-item">
                <input type="checkbox" class="category-checkbox" value="all" id="allCategoriesPercentage">
                <label for="allCategoriesPercentage">All Categories</label>
              </div>
              <% if (typeof categories !== 'undefined') { %>
                <% categories.forEach(category => { %>
                  <div class="checkbox-item">
                    <input type="checkbox" class="category-checkbox" name="selectedItems" value="<%= category._id %>" id="category-percentage-<%= category._id %>">
                    <label for="category-percentage-<%= category._id %>"><%= category.name %></label>
                  </div>
                <% }) %>
              <% } %>
            </div>
            <div id="errCategoriesPercentage" class="errr-msg"></div>
          </div>
          <div class="form-group" id="productsGroupPercentage" style="display: none;">
            <label>Products</label>
            <div class="checkbox-container" id="productsMenuPercentage">
              <div class="checkbox-item">
                <input type="checkbox" class="product-checkbox" value="all" id="allProductsPercentage">
                <label for="allProductsPercentage">All Products</label>
              </div>
              <% if (typeof products !== 'undefined') { %>
                <% products.forEach(product => { %>
                  <div class="checkbox-item">
                    <input type="checkbox" class="product-checkbox" name="selectedItems" value="<%= product._id %>" id="product-percentage-<%= product._id %>">
                    <label for="product-percentage-<%= product._id %>"><%= product.productName %></label>
                  </div>
                <% }) %>
              <% } %>
            </div>
            <div id="errProductsPercentage" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="discountPercentage">Discount Percentage</label>
            <input type="number" id="discountPercentage" name="discountPercentage" placeholder="Enter Discount Percentage" step="1.00" min="0" max="100">
            <div id="errDiscountPercentage" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="startDatePercentage">Start Date</label>
            <input type="date" id="startDatePercentage" name="startDate">
            <div id="errStartDatePercentage" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="endDatePercentage">End Date</label>
            <input type="date" id="endDatePercentage" name="endDate">
            <div id="errEndDatePercentage" class="errr-msg"></div>
          </div>
        </form>

        <!-- Coupon Offer Form -->
        <form id="couponForm" style="display: none;" novalidate>
          <input type="hidden" id="dealIdCoupon" name="dealId">
          <input type="hidden" name="offerType" value="coupon">
          <div class="form-group">
            <label for="couponName">Coupon Name</label>
            <input type="text" id="couponName" name="couponName" placeholder="Enter Coupon Name">
            <div id="errCouponName" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="discountValue">Discount Value</label>
            <input type="number" id="discountValue" name="discountValue" placeholder="Enter Discount Value" step="1.00" min="0">
            <div id="errDiscountValue" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="startDateCoupon">Start Date</label>
            <input type="date" id="startDateCoupon" name="startDate">
            <div id="errStartDateCoupon" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="endDateCoupon">End Date</label>
            <input type="date" id="endDateCoupon" name="endDate">
            <div id="errEndDateCoupon" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="minPurchase">Minimum Purchase Amount</label>
            <input type="number" id="minPurchase" name="minPurchase" placeholder="Enter Minimum Purchase Amount" step="1.00" min="0">
            <div id="errMinPurchase" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="maxPurchase">Maximum Purchase Amount</label>
            <input type="number" id="maxPurchase" name="maxPurchase" placeholder="Enter Maximum Purchase Amount" step="1.00" min="0">
            <div id="errMaxPurchase" class="errr-msg"></div>
          </div>
        </form>
      </div>
      <div class="popup-footer">
        <button type="button" class="btn btn-primary" id="saveDealBtn">ADD</button>
      </div>
    </div>
  </div>

  <!-- Activate/Deactivate Confirmation Modal -->
  <div id="confirm-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3>Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-action" class="btn-no">NO</button>
        <button id="confirm-action" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <!-- Logout Modal -->
  <div id="logout-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3>Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-logout" class="btn-no">NO</button>
        <button id="confirm-logout" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

<script>
document.addEventListener("DOMContentLoaded", function () {

  // Sidebar Toggle
  const sidebar = document.getElementById("adminSidebar");
  const icon = document.getElementById("drawer-icon");
  window.toggleSidebar = function () {
    sidebar.classList.toggle("collapsed");
    icon.style.transform = sidebar.classList.contains("collapsed") ? "rotate(0deg)" : "rotate(180deg)";
  };

  // Tab Switching Logic with Persistence
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  // ======= Start: Tab Persistence Logic =======
  // Function to save the active tab to localStorage
  function saveActiveTab(tabId) {
    localStorage.setItem('activeTab', tabId);
  }

  // Function to restore the active tab from localStorage
  function restoreActiveTab() {
    // Get the saved tab from localStorage, default to 'percentage-offer' if not set
    const activeTab = localStorage.getItem('activeTab') || 'percentage-offer';
    
    // Remove active class from all buttons and contents
    tabButtons.forEach(btn => btn.classList.remove('active'));
    tabContents.forEach(content => content.classList.remove('active'));

    // Find the button and content corresponding to the saved tab
    const targetButton = Array.from(tabButtons).find(btn => btn.getAttribute('data-tab') === activeTab);
    const targetContent = document.getElementById(activeTab);

    // Activate the saved tab if found, otherwise default to the first tab
    if (targetButton && targetContent) {
      targetButton.classList.add('active');
      targetContent.classList.add('active');
    } else {
      // Fallback to the first tab if the saved tab is invalid
      tabButtons[0].classList.add('active');
      tabContents[0].classList.add('active');
    }
  }

  // Add click event listeners to save and switch tabs
  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Remove active class from all buttons and contents
      tabButtons.forEach(btn => btn.classList.remove('active'));
      tabContents.forEach(content => content.classList.remove('active'));

      // Activate the clicked tab
      button.classList.add('active');
      const tabId = button.getAttribute('data-tab');
      document.getElementById(tabId).classList.add('active');

      // Save the active tab to localStorage
      saveActiveTab(tabId);
    });
  });

  // Restore the active tab on page load
  restoreActiveTab();
  // ======= End: Tab Persistence Logic =======

  // Popup Open/Close Logic
  const openPopupBtn = document.getElementById("openPopup");
  const closePopupBtn = document.getElementById("closePopup");
  const popupOverlay = document.getElementById("popupOverlay");
  const saveDealBtn = document.getElementById("saveDealBtn");
  const percentageForm = document.getElementById("percentageForm");
  const couponForm = document.getElementById("couponForm");
  const popupTitle = document.getElementById("popupTitle");
  const dealIdPercentageInput = document.getElementById("dealIdPercentage");
  const dealIdCouponInput = document.getElementById("dealIdCoupon");
  
  // Percentage Form Elements
  const offerNamePercentageInput = document.getElementById("offerNamePercentage");
  const offerTypePercentageSelect = document.getElementById("offerTypePercentage");
  const categoryGroupPercentage = document.getElementById("categoryGroupPercentage");
  const productsGroupPercentage = document.getElementById("productsGroupPercentage");
  const allCategoriesPercentageCheckbox = document.getElementById("allCategoriesPercentage");
  const allProductsPercentageCheckbox = document.getElementById("allProductsPercentage");
  const discountPercentageInput = document.getElementById("discountPercentage");
  const startDatePercentageInput = document.getElementById("startDatePercentage");
  const endDatePercentageInput = document.getElementById("endDatePercentage");
  const errOfferNamePercentage = document.getElementById("errOfferNamePercentage");
  const errOfferTypePercentage = document.getElementById("errOfferTypePercentage");
  const errCategoriesPercentage = document.getElementById("errCategoriesPercentage");
  const errProductsPercentage = document.getElementById("errProductsPercentage");
  const errDiscountPercentage = document.getElementById("errDiscountPercentage");
  const errStartDatePercentage = document.getElementById("errStartDatePercentage");
  const errEndDatePercentage = document.getElementById("errEndDatePercentage");

  // Coupon Form Elements
  const couponNameInput = document.getElementById("couponName");
  const discountValueInput = document.getElementById("discountValue");
  const startDateCouponInput = document.getElementById("startDateCoupon");
  const endDateCouponInput = document.getElementById("endDateCoupon");
  const minPurchaseInput = document.getElementById("minPurchase");
  const maxPurchaseInput = document.getElementById("maxPurchase");
  const errCouponName = document.getElementById("errCouponName");
  const errDiscountValue = document.getElementById("errDiscountValue");
  const errStartDateCoupon = document.getElementById("errStartDateCoupon");
  const errEndDateCoupon = document.getElementById("errEndDateCoupon");
  const errMinPurchase = document.getElementById("errMinPurchase");
  const errMaxPurchase = document.getElementById("errMaxPurchase");

  // Handle Offer Type Selection for Percentage Form
  offerTypePercentageSelect.addEventListener("change", function () {
    const selectedType = offerTypePercentageSelect.value;
    categoryGroupPercentage.style.display = "none";
    productsGroupPercentage.style.display = "none";
    errCategoriesPercentage.textContent = "";
    errProductsPercentage.textContent = "";
    errCategoriesPercentage.style.display = "none";
    errProductsPercentage.style.display = "none";

    // Reset checkboxes
    document.querySelectorAll('.category-checkbox').forEach(checkbox => checkbox.checked = false);
    document.querySelectorAll('.product-checkbox').forEach(checkbox => checkbox.checked = false);

    if (selectedType === "category") {
      categoryGroupPercentage.style.display = "block";
    } else if (selectedType === "products") {
      productsGroupPercentage.style.display = "block";
    }
  });

  // Handle "All Categories" Checkbox for Percentage Form
  allCategoriesPercentageCheckbox.addEventListener("change", function () {
    const categoryCheckboxes = document.querySelectorAll('.category-checkbox[name="selectedItems"]');
    categoryCheckboxes.forEach(checkbox => {
      checkbox.checked = allCategoriesPercentageCheckbox.checked;
    });
  });

  // Handle Individual Category Checkboxes for Percentage Form
  document.querySelectorAll('.category-checkbox[name="selectedItems"]').forEach(checkbox => {
    checkbox.addEventListener("change", function () {
      const categoryCheckboxes = document.querySelectorAll('.category-checkbox[name="selectedItems"]');
      const allChecked = Array.from(categoryCheckboxes).every(category => category.checked);
      allCategoriesPercentageCheckbox.checked = allChecked;
    });
  });

  // Handle "All Products" Checkbox for Percentage Form
  allProductsPercentageCheckbox.addEventListener("change", function () {
    const productCheckboxes = document.querySelectorAll('.product-checkbox[name="selectedItems"]');
    productCheckboxes.forEach(checkbox => {
      checkbox.checked = allProductsPercentageCheckbox.checked;
    });
  });

  // Handle Individual Product Checkboxes for Percentage Form
  document.querySelectorAll('.product-checkbox[name="selectedItems"]').forEach(checkbox => {
    checkbox.addEventListener("change", function () {
      const productCheckboxes = document.querySelectorAll('.product-checkbox[name="selectedItems"]');
      const allChecked = Array.from(productCheckboxes).every(product => product.checked);
      allProductsPercentageCheckbox.checked = allChecked;
    });
  });

  const closePopup = () => {
    popupOverlay.classList.add("hidden");
    resetForms();
  };

  const resetForms = () => {
    percentageForm.reset();
    couponForm.reset();
    dealIdPercentageInput.value = "";
    dealIdCouponInput.value = "";
    popupTitle.textContent = "Add Deal";
    saveDealBtn.textContent = "ADD";
    categoryGroupPercentage.style.display = "none";
    productsGroupPercentage.style.display = "none";
    document.querySelectorAll('.category-checkbox').forEach(checkbox => checkbox.checked = false);
    document.querySelectorAll('.product-checkbox').forEach(checkbox => checkbox.checked = false);
    [
      errOfferNamePercentage, errOfferTypePercentage, errCategoriesPercentage, errProductsPercentage,
      errDiscountPercentage, errStartDatePercentage, errEndDatePercentage,
      errCouponName, errDiscountValue, errStartDateCoupon, errEndDateCoupon,
      errMinPurchase, errMaxPurchase
    ].forEach(err => {
      err.textContent = "";
      err.style.display = "none";
    });
  };

  openPopupBtn.addEventListener("click", (e) => {
    e.preventDefault();
    const activeTab = document.querySelector('.tab-btn.active').getAttribute('data-tab');
    if (activeTab === 'percentage-offer') {
      percentageForm.style.display = "block";
      couponForm.style.display = "none";
      popupTitle.textContent = "Add Percentage Offer";
    } else if (activeTab === 'coupon-offer') {
      percentageForm.style.display = "none";
      couponForm.style.display = "block";
      popupTitle.textContent = "Add Coupon Offer";
    }
    popupOverlay.classList.remove("hidden");
    resetForms();
  });

  closePopupBtn.addEventListener("click", closePopup);
  popupOverlay.addEventListener("click", (e) => {
    if (e.target === popupOverlay) closePopup();
  });

  // Form Validation
  const validateInput = (input, errorElement, msg, maxLength = null, minValue = null, maxValue = null) => {
    const val = input.value.trim();
    if (!val) {
      errorElement.textContent = msg;
      errorElement.style.display = "block";
      return false;
    }
    if (maxLength && val.length > maxLength) {
      errorElement.textContent = `Must be ${maxLength} characters or less`;
      errorElement.style.display = "block";
      return false;
    }
    if (minValue !== null && !isNaN(minValue) && (parseFloat(val) <= minValue || isNaN(val))) {
      errorElement.textContent = msg;
      errorElement.style.display = "block";
      return false;
    }
    if (maxValue !== null && !isNaN(maxValue) && (parseFloat(val) > maxValue || isNaN(val))) {
      errorElement.textContent = `Must be less than or equal to ${maxValue}`;
      errorElement.style.display = "block";
      return false;
    }
    errorElement.textContent = "";
    errorElement.style.display = "none";
    return true;
  };

  // Validate Date Range
  const validateDateRange = (startInput, endInput, errStart, errEnd) => {
    const startDate = new Date(startInput.value);
    const endDate = new Date(endInput.value);
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const isEditing = dealIdPercentageInput.value || dealIdCouponInput.value; // Check if editing

    if (!startInput.value) {
      errStart.textContent = "Start Date is required.";
      errStart.style.display = "block";
      return false;
    }
    if (!endInput.value) {
      errEnd.textContent = "End Date is required.";
      errEnd.style.display = "block";
      return false;
    }

    // When adding a new deal, ensure startDate is not in the past
    if (!isEditing && startDate < today) {
      errStart.textContent = "Start Date cannot be in the past.";
      errStart.style.display = "block";
      return false;
    }

    if (endDate < today) {
      errEnd.textContent = "End Date cannot be in the past.";
      errEnd.style.display = "block";
      return false;
    }

    if (endDate < startDate) {
      errEnd.textContent = "End Date must be after Start Date.";
      errEnd.style.display = "block";
      return false;
    }

    errStart.textContent = "";
    errEnd.textContent = "";
    errStart.style.display = "none";
    errEnd.style.display = "none";
    return true;
  };

  // Validate Purchase Range
  const validatePurchaseRange = () => {
    const minPurchase = parseFloat(minPurchaseInput.value) || 0;
    const maxPurchase = parseFloat(maxPurchaseInput.value) || 0;
    const discountValue = parseFloat(discountValueInput.value) || 0;

    if (!minPurchaseInput.value) {
      errMinPurchase.textContent = "Minimum Purchase Amount is required.";
      errMinPurchase.style.display = "block";
      return false;
    }
    if (!maxPurchaseInput.value) {
      errMaxPurchase.textContent = "Maximum Purchase Amount is required.";
      errMaxPurchase.style.display = "block";
      return false;
    }
    if (minPurchase < 0) {
      errMinPurchase.textContent = "Minimum Purchase Amount cannot be negative.";
      errMinPurchase.style.display = "block";
      return false;
    }
    if (maxPurchase < 0) {
      errMaxPurchase.textContent = "Maximum Purchase Amount cannot be negative.";
      errMaxPurchase.style.display = "block";
      return false;
    }
    if (minPurchase > 0 && maxPurchase > 0 && maxPurchase < minPurchase) {
      errMaxPurchase.textContent = "Maximum Purchase must be greater than or equal to Minimum Purchase.";
      errMaxPurchase.style.display = "block";
      return false;
    }
    if (minPurchase <= discountValue) {
      errMinPurchase.textContent = "Minimum Purchase Amount must be greater than the Discount Value.";
      errMinPurchase.style.display = "block";
      return false;
    }

    errMinPurchase.textContent = "";
    errMaxPurchase.textContent = "";
    errMinPurchase.style.display = "none";
    errMaxPurchase.style.display = "none";
    return true;
  };

  // Form Submission
  saveDealBtn.addEventListener("click", async (e) => {
    e.preventDefault();

    const activeTab = document.querySelector('.tab-btn.active').getAttribute('data-tab');
    let isValid = true;

    if (activeTab === 'percentage-offer') {
      const isOfferNameValid = validateInput(offerNamePercentageInput, errOfferNamePercentage, "Offer Name is required", 50);
      const isOfferTypeValid = validateInput(offerTypePercentageSelect, errOfferTypePercentage, "Offer Type is required");
      const isDiscountValid = validateInput(discountPercentageInput, errDiscountPercentage, "Discount Percentage is required", null, 0, 100);

      const selectedType = offerTypePercentageSelect.value;
      let selectedItems = [];

      if (selectedType === "category") {
        const categoryCheckboxes = document.querySelectorAll('.category-checkbox[name="selectedItems"]:checked');
        if (allCategoriesPercentageCheckbox.checked) {
          selectedItems = Array.from(document.querySelectorAll('.category-checkbox[name="selectedItems"]')).map(category => category.value);
        } else {
          selectedItems = Array.from(categoryCheckboxes).map(category => category.value);
        }
        if (selectedItems.length === 0) {
          errCategoriesPercentage.textContent = "At least one category must be selected.";
          errCategoriesPercentage.style.display = "block";
          isValid = false;
        } else {
          errCategoriesPercentage.textContent = "";
          errCategoriesPercentage.style.display = "none";
        }
      } else if (selectedType === "products") {
        const productCheckboxes = document.querySelectorAll('.product-checkbox[name="selectedItems"]:checked');
        if (allProductsPercentageCheckbox.checked) {
          selectedItems = Array.from(document.querySelectorAll('.product-checkbox[name="selectedItems"]')).map(product => product.value);
        } else {
          selectedItems = Array.from(productCheckboxes).map(product => product.value);
        }
        if (selectedItems.length === 0) {
          errProductsPercentage.textContent = "At least one product must be selected.";
          errProductsPercentage.style.display = "block";
          isValid = false;
        } else {
          errProductsPercentage.textContent = "";
          errProductsPercentage.style.display = "none";
        }
      } else {
        errOfferTypePercentage.textContent = "Offer Type is required.";
        errOfferTypePercentage.style.display = "block";
        isValid = false;
      }

      const isDateRangeValid = validateDateRange(startDatePercentageInput, endDatePercentageInput, errStartDatePercentage, errEndDatePercentage);
      isValid = isValid && isOfferNameValid && isOfferTypeValid && isDiscountValid && isDateRangeValid;

      if (!isValid) return;

      const formData = new FormData(percentageForm);
      const formObject = Object.fromEntries(formData);
      formObject.selectedItems = selectedItems;     
      const jsonData = JSON.stringify(formObject);

      // Debug: Log FormData contents
      console.log("FormData for Percentage Offer:");
      for (let [key, value] of formData.entries()) {
        console.log(`${key}: ${value}`);
      }

      const dealId = dealIdPercentageInput.value;
      const url = dealId ? `/tezgrani/deals/edit/${dealId}` : "/tezgrani/deals/save";
      const method = dealId ? "PATCH" : "POST";

      try {
        saveDealBtn.disabled = true;
        saveDealBtn.textContent = dealId ? "Updating..." : "Adding...";
        const response = await fetch(url, {
          method: method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: jsonData,
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Unknown error');
        }

        toastr.success(dealId ? "Deal updated successfully!" : "Deal added successfully!");
        closePopup();
        setTimeout(() => { // Added delay for better UX
          window.location.reload();
        }, 1000);
      } catch (err) {
        toastr.error(`${err.message || 'Unknown error'}`);
      } finally {
        saveDealBtn.disabled = false;
        saveDealBtn.textContent = dealId ? "UPDATE" : "ADD";
      }
    } else if (activeTab === 'coupon-offer') {
      const isCouponNameValid = validateInput(couponNameInput, errCouponName, "Coupon Name is required", 50);
      const isDiscountValueValid = validateInput(discountValueInput, errDiscountValue, "Discount Value is required", null, 0);

      const isDateRangeValid = validateDateRange(startDateCouponInput, endDateCouponInput, errStartDateCoupon, errEndDateCoupon);
      const isPurchaseRangeValid = validatePurchaseRange();

      isValid = isCouponNameValid && isDiscountValueValid && isDateRangeValid && isPurchaseRangeValid;

      if (!isValid) return;

      const formData = new FormData(couponForm);
      const formObject = Object.fromEntries(formData);
      const jsonData = JSON.stringify(formObject);

      // Debug: Log FormData contents
      console.log("FormData for Coupon Offer:");
      for (let [key, value] of formData.entries()) {
        console.log(`${key}: ${value}`);
      }

      const dealId = dealIdCouponInput.value;
      const url = dealId ? `/tezgrani/deals/edit/${dealId}` : "/tezgrani/deals/save";
      const method = dealId ? "PATCH" : "POST";

      try {
        saveDealBtn.disabled = true;
        saveDealBtn.textContent = dealId ? "Updating..." : "Adding...";
        const response = await fetch(url, {
          method: method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: jsonData,
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Unknown error');
        }

        toastr.success(dealId ? "Coupon updated successfully!" : "Coupon added successfully!");
        closePopup();
        setTimeout(() => { // Added delay for better UX
          window.location.reload();
        }, 1000);
      } catch (err) {
        toastr.error(`${err.message || 'Unknown error'}`);
      } finally {
        saveDealBtn.disabled = false;
        saveDealBtn.textContent = dealId ? "UPDATE" : "ADD";
      }
    }
  });

  // Edit Deal
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const dealId = btn.getAttribute('data-dealid');
      const name = btn.getAttribute('data-name');
      const offerType = btn.getAttribute('data-offertype');
      const discount = btn.getAttribute('data-offerprice');
      const startDate = btn.getAttribute('data-startdate');
      const endDate = btn.getAttribute('data-enddate');

      popupTitle.textContent = "Edit Deal";
      saveDealBtn.textContent = "UPDATE";

      if (offerType.toLowerCase() === 'percentage') {
        const selectedType = btn.getAttribute('data-selectedtype');
        let selectedItems = [];
        try {
          selectedItems = JSON.parse(btn.getAttribute('data-selecteditems') || '[]');
        } catch (error) {
          console.error('Error parsing selectedItems:', error);
          selectedItems = [];
        }

        // Extract just the _id values from selectedItems
        const selectedItemIds = selectedItems.map(item => item._id.toString());

        percentageForm.style.display = "block";
        couponForm.style.display = "none";
        dealIdPercentageInput.value = dealId;
        offerNamePercentageInput.value = name;
        offerTypePercentageSelect.value = selectedType || "";
        discountPercentageInput.value = discount;
        startDatePercentageInput.value = startDate.split('T')[0];
        endDatePercentageInput.value = endDate.split('T')[0];

        // Reset checkbox selections
        document.querySelectorAll('.category-checkbox').forEach(checkbox => checkbox.checked = false);
        document.querySelectorAll('.product-checkbox').forEach(checkbox => checkbox.checked = false);
        categoryGroupPercentage.style.display = "none";
        productsGroupPercentage.style.display = "none";

        // Populate checkboxes based on selected type
        if (selectedType === "category") {
          categoryGroupPercentage.style.display = "block";
          const categoryCheckboxes = document.querySelectorAll('.category-checkbox[name="selectedItems"]');
          const allCategories = Array.from(categoryCheckboxes).map(category => category.value);
          const allSelected = allCategories.every(id => selectedItemIds.includes(id));
          allCategoriesPercentageCheckbox.checked = allSelected;
          categoryCheckboxes.forEach(checkbox => {
            checkbox.checked = selectedItemIds.includes(checkbox.value);
          });
        } else if (selectedType === "products") {
          productsGroupPercentage.style.display = "block";
          const productCheckboxes = document.querySelectorAll('.product-checkbox[name="selectedItems"]');
          const allProducts = Array.from(productCheckboxes).map(product => product.value);
          const allSelected = allProducts.every(id => selectedItemIds.includes(id));
          allProductsPercentageCheckbox.checked = allSelected;
          productCheckboxes.forEach(checkbox => {
            checkbox.checked = selectedItemIds.includes(checkbox.value);
          });
        }
      } else if (offerType.toLowerCase() === 'coupon') {
        const minPurchase = btn.getAttribute('data-minpurchase');
        const maxPurchase = btn.getAttribute('data-maxpurchase');

        percentageForm.style.display = "none";
        couponForm.style.display = "block";
        dealIdCouponInput.value = dealId;
        couponNameInput.value = name;
        discountValueInput.value = discount;
        startDateCouponInput.value = startDate.split('T')[0];
        endDateCouponInput.value = endDate.split('T')[0];
        minPurchaseInput.value = minPurchase;
        maxPurchaseInput.value = maxPurchase;
      }

      popupOverlay.classList.remove('hidden');
    });
  });

  // Delete/Confirm Delete Modal
  const confirmModal = document.getElementById('confirm-modal');
  const cancelAction = document.getElementById('cancel-action');
  const confirmAction = document.getElementById('confirm-action');

  cancelAction.addEventListener('click', () => {
    confirmModal.style.display = 'none';
  });

  confirmAction.addEventListener('click', async () => {
    if (confirmModal.dataset.dealId) {
      const dealId = confirmModal.dataset.dealId;

      confirmModal.style.display = 'none';
      confirmModal.removeAttribute('data-dealId');
      confirmModal.removeAttribute('data-newListedStatus');

      try {
        const response = await fetch(`/tezgrani/deals/delete/${dealId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
          toastr.success("Deal deleted successfully!");
          setTimeout(() => { // Added delay for better UX
            window.location.reload();
          }, 1000);
        } else {
          toastr.error(`${data.message || 'No message provided'}`);
        }
      } catch (err) {
        toastr.error(`Error deleting deal: ${err.message || 'Unknown error'}`);
      }
    }
  });

  document.querySelectorAll('.toggle-status').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const dealId = btn.getAttribute('data-dealid');

      confirmModal.dataset.dealId = dealId;
      confirmModal.style.display = 'block';
    });
  });

  window.addEventListener("click", (e) => {
    if (e.target === confirmModal) {
      confirmModal.style.display = "none";
      confirmModal.removeAttribute('data-dealId');
      confirmModal.removeAttribute('data-newListedStatus');
    }
  });

  // Logout Modal Logic
  const logoutModal = document.getElementById("logout-modal");
  const confirmLogoutBtn = document.getElementById("confirm-logout");
  const cancelLogoutBtn = document.getElementById("cancel-logout");

  window.showLogoutModal = function() {
    logoutModal.style.display = "flex";
  };

  confirmLogoutBtn.addEventListener("click", () => {
    logoutModal.style.display = "none";
    window.location.href = "/tezgrani/logout";
  });

  cancelLogoutBtn.addEventListener("click", () => {
    logoutModal.style.display = "none";
  });

  window.addEventListener("click", (e) => {
    if (e.target === logoutModal) {
      logoutModal.style.display = "none";
    }
  });

});
</script>
</body>
</html>