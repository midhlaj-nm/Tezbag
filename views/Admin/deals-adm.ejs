<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Deals Management</title>
  <link rel="stylesheet" href="/Admin-css/deals-adm.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
  <style>
    /* Styling for checkbox menus */
    .checkbox-container {
      max-height: fit-content;
      overflow-y: auto;
      border: 1px solid #ccc;
      border-radius: 4px;
      padding: 10px;
    }

    .checkbox-item {
      display: grid;
      grid-template-columns: auto 1fr;
      margin-bottom: 8px;
      padding: 5px 0;
    }

    .checkbox-item input[type="checkbox"] {
      grid-column: 1;
      justify-self: start;
      margin-left: 20px; /* Adjust this value as needed */
      cursor: pointer;
      width: 18px; /* Increase checkbox size */
      height: 18px; /* Increase checkbox size */
    }

    .checkbox-item label {
      grid-column: 2;
      justify-self: start;
      padding-left: 10px;
      font-size: 14px;
      color: #333;
      cursor: pointer;
    }

    .form-group select {
      width: 100%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 14px;
    }

    /* Updated Status Colors with Background */
    .status.scheduled {
      color: #ffa000; 
      padding: 2px 6px;
      border-radius: 4px;
    }
    .status.active {
      color: #28A745; 
      padding: 2px 6px;
      border-radius: 4px;
    }
    .status.expired {
      color: #DC3545; 
      padding: 2px 6px;
      border-radius: 4px;
    }

    /* Delete Button Styling */
    .btn.delete-btn {
      background-color: red;
      color: white;
      border: none;
      padding: 5px 10px;
      border-radius: 4px;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div id="middle" class="container-fluid">
    <div class="logo">
      <img width="250" src="/Admin-css/Logo-Admins.jpg" alt="Logo">
    </div>

    <form action="/tezgrani/deals-management" method="GET" class="search-bar">
      <div class="input-wrapper">
        <input 
          type="text" 
          name="search" 
          value="<%= typeof search !== 'undefined' ? search : '' %>" 
          placeholder="Search by deal name..."
          class="search-input">
        
        <% if (typeof search !== 'undefined' && search.trim() !== '') { %>
          <a href="/tezgrani/deals-management" class="clear-icon">
            <span class="material-symbols-outlined">cancel</span>
          </a>
        <% } %>
      </div>
      <button type="submit" class="search-btn">Search</button>
    </form>
  </div>

  <div class="sidebar" id="adminSidebar">
    <ul class="sidebar-links">
      <li>
        <a href="/tezgrani/dashboard">
          <span class="icon-svg">
