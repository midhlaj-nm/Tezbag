<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Management</title>
  <link rel="stylesheet" href="/Admin-css/product-adm.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
</head>

<body>
  <div id="middle" class="container-fluid">
    <div class="logo">
      <img width="250" src="/Admin-css/Logo-Admins.jpg" alt="Logo">
    </div>

    <form action="/tezgrani/product-management" method="GET" class="search-bar">
      <div class="input-wrapper">
        <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search by product name..." class="search-input">

        <% if (typeof search !== 'undefined' && search.trim() !== '') { %>
        <a href="/tezgrani/product-management" class="clear-icon">
          <span class="material-symbols-outlined">cancel</span>
        </a>
        <% } %>
      </div>
      <button type="submit" class="search-btn">Search</button>
    </form>
  </div>

  <div class="sidebar" id="adminSidebar">
    <ul class="sidebar-links">
      <li>
