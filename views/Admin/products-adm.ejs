  <div class="content">
    <div class="table-container">
      <div class="table-wrapper">
        <div class="table-header">
            <h2 class="table-title">Product Management</h2>
            <div class="buttons">
              <a href="#" class="add-product-btn" id="openPopup">Add Product</a>
            </div>
          </div>
      </div>
    </div>
  </div>

  <!-- Popup with overlay -->
  <div class="overlay hidden" id="popupOverlay">
    <div class="popup">
      <div class="popup-header">
        <h2 class="popup-title">Add Product</h2>
        <button class="close-btn" id="closePopup">×</button>
      </div>
      <div class="popup-content">
        <form id="productForm" action="" enctype="multipart/form-data">
          <div class="form-group">
            <label for="productName">Product Name</label>
            <input type="text" id="productName" name="productName" placeholder="Enter Product Name">
            <div id="errProductName" class="errr-msg"></div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="category">Category</label>
              <select id="category" name="category">
                <option value="">Select Category</option>
                <% if (typeof categories !== 'undefined') { %>
                  <% categories.forEach(category => { %>
                    <option value="<%= category._id %>"><%= category.name %></option>
                  <% }) %>
                <% } %>
              </select>
              <div id="errCategory" class="errr-msg"></div>
            </div>
            <div class="form-group">
              <label for="price">Price</label>
              <input type="number" id="price" name="price" placeholder="Enter Price" step="0.01" min="0">
              <div id="errPrice" class="errr-msg"></div>
            </div>
            <div class="form-group">
              <label for="mrp">MRP</label>
              <input type="number" id="mrp" name="mrp" placeholder="Enter MRP" step="0.01" min="0">
              <div id="errMrp" class="errr-msg"></div>
            </div>
          </div>
          <div class="form-group">
            <label for="qty">Qty</label>
            <input type="number" id="qty" name="qty" placeholder="Enter Quantity" min="0">
            <div id="errQty" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" placeholder="Enter Product Description"></textarea>
            <div id="errDescription" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label>Images</label>
            <div class="image-upload-container">
              <input type="file" id="image1" name="images" accept="image/*" class="image-input" style="display: none;">
              <div class="image-placeholder" onclick="document.getElementById('image1').click()">
                <span class="material-icons"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f"><path d="M480-480ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h320v80H200v560h560v-320h80v320q0 33-23.5 56.5T760-120H200Zm40-160h480L570-480 450-320l-90-120-120 160Zm440-320v-80h-80v-80h80v-80h80v80h80v80h-80v80h-80Z"/></svg>
                </span>
              </div>
              <input type="file" id="image2" name="images" accept="image/*" class="image-input" style="display: none;">
              <div class="image-placeholder" onclick="document.getElementById('image2').click()">
                <span class="material-icons"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f"><path d="M480-480ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h320v80H200v560h560v-320h80v320q0 33-23.5 56.5T760-120H200Zm40-160h480L570-480 450-320l-90-120-120 160Zm440-320v-80h-80v-80h80v-80h80v80h80v80h-80v80h-80Z"/></svg>
                </span>
              </div>
              <input type="file" id="image3" name="images" accept="image/*" class="image-input" style="display: none;">
              <div class="image-placeholder" onclick="document.getElementById('image3').click()">
                <span class="material-icons"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f"><path d="M480-480ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h320v80H200v560h560v-320h80v320q0 33-23.5 56.5T760-120H200Zm40-160h480L570-480 450-320l-90-120-120 160Zm440-320v-80h-80v-80h80v-80h80v80h80v80h-80v80h-80Z"/></svg>
                </span>
              </div>
            </div>
            <div id="errImage" class="errr-msg"></div>
          </div>
        </form>
      </div>
      <div class="popup-footer">
        <button type="button" class="btn btn-primary" id="saveProductBtn">ADD</button>
      </div>
    </div>
  </div>
</body>


<script>
document.addEventListener("DOMContentLoaded", function () {
  // ==================== Sidebar Toggle ====================
  const sidebar = document.getElementById("adminSidebar");
  const icon = document.getElementById("drawer-icon");
  window.toggleSidebar = function () {
    sidebar.classList.toggle("collapsed");
    icon.style.transform = sidebar.classList.contains("collapsed") ? "rotate(0deg)" : "rotate(180deg)";
  };

  // ================ Popup Open/Close ================
  const openPopupBtn = document.getElementById("openPopup");
  const closePopupBtn = document.getElementById("closePopup");
  const popupOverlay = document.getElementById("popupOverlay");
  const saveProductBtn = document.getElementById("saveProductBtn");
  const productForm = document.getElementById("productForm");
  const productNameInput = document.getElementById("productName");
  const categoryInput = document.getElementById("category");
  const priceInput = document.getElementById("price");
  const mrpInput = document.getElementById("mrp");
  const qtyInput = document.getElementById("qty");
  const descriptionInput = document.getElementById("description");
  const imageInputs = [document.getElementById("image1"), document.getElementById("image2"), document.getElementById("image3")];
  const errProductName = document.getElementById("errProductName");
  const errCategory = document.getElementById("errCategory");
  const errPrice = document.getElementById("errPrice");
  const errMrp = document.getElementById("errMrp");
  const errQty = document.getElementById("errQty");
  const errDescription = document.getElementById("errDescription");
  const errImage = document.getElementById("errImage");

  toastr.options = {
    closeButton: true,
    progressBar: true,
    positionClass: "toast-top-right",
    timeOut: "3000",
  };

  const closePopup = () => {
    popupOverlay.classList.add("hidden");
    resetForm();
  };

  const resetForm = () => {
    productForm.reset();
    [errProductName, errCategory, errPrice, errMrp, errQty, errDescription, errImage].forEach(err => {
      err.textContent = "";
      err.style.display = "none";
    });
  };

  openPopupBtn.addEventListener("click", () => {
    popupOverlay.classList.remove("hidden");
    resetForm();
  });

  closePopupBtn.addEventListener("click", closePopup);
  popupOverlay.addEventListener("click", (e) => {
    if (e.target === popupOverlay) closePopup();
  });

  const validateInput = (input, errorElement, msg, maxLength = null, minValue = null) => {
    const val = input.value.trim();
    if (!val && input.type !== "file") {
      errorElement.textContent = msg;
      errorElement.style.display = "block";
      return false;
    }
    if (maxLength && val.length > maxLength) {
      errorElement.textContent = `Must be ${maxLength} characters or less`;
      errorElement.style.display = "block";
      return false;
    }
    if (minValue !== null && !isNaN(minValue) && (parseFloat(val) <= minValue || isNaN(val))) {
      errorElement.textContent = msg;
      errorElement.style.display = "block";
      return false;
    }
    if (input.type === "file" && !input.files.length) {
      errorElement.textContent = msg;
      errorElement.style.display = "block";
      return false;
    }
    errorElement.textContent = "";
    errorElement.style.display = "none";
    return true;
  };

  saveProductBtn.addEventListener("click", async (e) => {
    e.preventDefault();
    const isProductNameValid = validateInput(productNameInput, errProductName, "Product Name is required", 50);
    const isCategoryValid = validateInput(categoryInput, errCategory, "Category is required");
    const isPriceValid = validateInput(priceInput, errPrice, "Valid Price is required (greater than 0)", null, 0);
    const isMrpValid = validateInput(mrpInput, errMrp, "Valid MRP is required (greater than 0)", null, 0);
    const isQtyValid = validateInput(qtyInput, errQty, "Valid Quantity is required (greater than 0)", null, 0);
    const isDescriptionValid = validateInput(descriptionInput, errDescription, "Description is required", 200);
    const isImageValid = imageInputs.every(input => validateInput(input, errImage, "All three images are required"));

    if (!isProductNameValid || !isCategoryValid || !isPriceValid || !isMrpValid || !isQtyValid || !isDescriptionValid || !isImageValid) return;

    const formData = new FormData();
    formData.append("productName", productNameInput.value.trim());
    formData.append("category", categoryInput.value);
    formData.append("price", priceInput.value);
    formData.append("mrp", mrpInput.value);
    formData.append("qty", qtyInput.value);
    formData.append("description", descriptionInput.value.trim());
    imageInputs.forEach((input, index) => {
      if (input.files.length > 0) {
        formData.append(`images`, input.files[0]);
      }
    });
  });
}); 
</script>


</html>