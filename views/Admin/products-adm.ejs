  <div class="content">
    <div class="table-container">
      <div class="table-wrapper">

        <div class="table-header">
          <h2 class="table-title">Product Management</h2>
          <div class="buttons">
            <a href="#" class="add-product-btn" id="openPopupBtn">Add Product</a>
          </div>
        </div>

        <!-- Product Table -->
        <div class="table-body">
          <table class="product-table">
            <thead>
              <tr>
                <th>SI. NO.</th>
                <th>IMAGES</th>
                <th>NAME</th>
                <th>CATEGORY</th>
                <th>PRICE</th>
                <th>MRP</th>
                <th>STOCK</th>
                <th>STATUS</th>
                <th>ACTION</th>
              </tr>
            </thead>
            <tbody>
              <% if (!products || products.length === 0) { %>
              <tr>
                <td colspan="9" style="padding: 1rem;">
                  <div style="
                      width: 105%;
                      display: flex;
                      align-items: center;
                      justify-content: center;
                      font-weight: 500;
                      font-size: 1.1rem;
                      color: #666;
                    ">
                    No Products to show right now!
                  </div>
                </td>
              </tr>
              <% } else { %>
              <% products.forEach((product, index) => { %>
              <tr>
                <td><%= (currentPage - 1) * 6 + index + 1 %></td>
                <td class="product-info">
                  <img src="<%= product.productImage[0] %>" alt="Product Image" class="product-thumbnail">
                </td>
                <td><%= product.productName %></td>
                <td><%= product.category?.name %></td>
                <td><%= product.regularPrice %>₹</td>
                <td><%= product.salePrice %> ₹</td>
                <td><%= product.quantity %></td>
                <td class="status <%= product.status === 'Available' ? 'active' : 'inactive' %>">
                  <%= product.status %>
                </td>
                <td class="actions">
                  <a href="#" class="btn edit-btn" data-productid="<%= product._id %>" data-name="<%= product.productName %>" data-description="<%= product.description %>" data-isblocked="<%= product.isBlocked %>" data-categoryid="<%= product.category._id %>" data-price="<%= product.regularPrice %>" data-mrp="<%= product.salePrice %>" data-stock="<%= product.quantity %>" data-images='<%= JSON.stringify(product.productImage) %>'>
                    EDIT
                  </a>
                  <a href="#" class="btn list-toggle" data-productid="<%= product._id %>" data-status="<%= product.isBlocked %>">
                    <%= product.isBlocked ? 'UNBLOCK' : 'BLOCK' %>
                  </a>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
        <!-- End Product Table -->

      </div>
    </div>
    <% if (totalPages >= 1) { %>
    <nav aria-label="Admin page navigation" class="custom-pagination">
      <ul class="pagination-list">
        <li class="pagination-item <%= currentPage === 1 ? 'disabled' : '' %>">
          <% if (currentPage === 1) { %>
          <span class="pagination-link">Previous</span>
          <% } else { %>
          <a class="pagination-link" href="?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">Previous</a>
          <% } %>
        </li>
        <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="pagination-item <%= currentPage === i ? 'active' : '' %>">
          <a class="pagination-link" href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"><%= i %></a>
        </li>
        <% } %>
        <li class="pagination-item <%= currentPage === totalPages ? 'disabled' : '' %>">
          <% if (currentPage === totalPages) { %>
          <span class="pagination-link">Next</span>
          <% } else { %>
          <a class="pagination-link" href="?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">Next</a>
          <% } %>
        </li>
      </ul>
    </nav>
    <% } %>
  </div>

  <div class="overlay hidden" id="popupOverlay">
    <div class="popup">
      <div class="popup-header">
        <h2 class="popup-title" id="popupTitle">Add Product</h2>
        <button class="close-btn" id="closePopup">×</button>
      </div>
      <div class="popup-content">
        <form id="productForm" enctype="multipart/form-data" novalidate>
          <input type="hidden" id="productId" name="productId">
          <!-- Hidden fields to track existing and deleted images -->
          <div id="existingImagesContainer" style="display: none;"></div>
          <div id="deletedImagesContainer" style="display: none;"></div>
          <div class="form-group">
            <label for="productName">Product Name</label>
            <input type="text" id="productName" name="productName" placeholder="Enter Product Name">
            <div id="errProductName" class="errr-msg"></div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="category">Category</label>
              <select id="category" name="category">
                <option value="" disabled selected hidden>Select Category</option>
                <% if (typeof categories !== 'undefined') { %>
                <% categories.forEach(category => { %>
                <option value="<%= category._id %>" data-name="<%= category.name %>"><%= category.name %></option>
                <% }) %>
                <% } %>
              </select>
              <div id="errCategory" class="errr-msg"></div>
            </div>
            <div class="form-group">
              <label for="price">Price</label>
              <input type="number" id="price" name="price" placeholder="Enter Price" step="1.00" min="0">
              <div id="errPrice" class="errr-msg"></div>
            </div>
            <div class="form-group">
              <label for="mrp">MRP</label>
              <input type="number" id="mrp" name="mrp" placeholder="Enter MRP" step="1.00" min="0">
              <div id="errMrp" class="errr-msg"></div>
            </div>
          </div>
          <div class="form-group" id="cutStyleGroup" style="display: none; width: 100%;">
            <label>Cutting Styles</label>
            <div class="checkbox-container" id="cutStylesContainer">
              <!-- Checkboxes will be populated dynamically -->
            </div>
            <div id="errCutStyles" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="qty">Qty</label>
            <input type="number" id="qty" name="qty" placeholder="Enter Quantity" min="0">
            <div id="errQty" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" placeholder="Enter Product Description"></textarea>
            <div id="errDescription" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label>Images <span id="imageCounter">0/5</span>&nbsp;&nbsp;<span style="opacity:0.8;">(Maximum 10mb)</span></label>
            <div id="image-upload-container" class="image-upload-container"></div>
            <div id="errImage" class="errr-msg"></div>
          </div>
        </form>
      </div>
      <div class="popup-footer">
        <button type="submit" class="btn btn-primary" id="saveProductBtn" form="productForm">ADD</button>
      </div>
    </div>
  </div>

  <!-- Cropping Modal -->
  <div class="overlay hidden" id="cropModal">
    <div class="popup">
      <div class="popup-header">
        <h2 class="popup-title">Crop Image</h2>
        <button class="close-btn" id="closeCropModal">×</button>
      </div>
      <div class="popup-content">
        <div>
          <img id="cropImage" src="" alt="Image to crop" style="max-width: 100%; max-height: 400px;">
        </div>
      </div>
      <div class="popup-footer">
        <button type="button" class="btn btn-primary" id="cropDoneBtn">Done</button>
      </div>
    </div>
  </div>

  <!-- Block/Unblock Confirmation Modal -->
  <div id="confirm-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3>Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-action" class="btn-no">NO</button>
        <button id="confirm-action" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <!-- Logout Modal -->
  <div id="logout-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3 style="font-size: 1.75rem; font-weight: 500;">Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-logout" class="btn-no">NO</button>
        <button id="confirm-logout" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Define cutting styles for Meat and Fish, including "None"
      const meatCutStyles = [
        "None",
        "Curry Cut",
        "Biriyani Cut",
        "Soup Cut",
        "Bone Cut",
        "Boneless Cut",
        "Chops",
        "Liver",
        "Steak Cut",
        "Heart",
        "Keema (Minced)",
        "Dry Fry Cut",
        "Neck Cut",
        "Full Chicken"
      ];
      const fishCutStyles = [
        "None",
        "Whole Fish",
        "Sliced Cut",
        "Steak Cut",
        "Curry Cut",
        "Fillet Cut",
        "Head & Tail Removed",
        "Butterfly Cut",
        "Finger Cut",
      ];

      // ==================== Sidebar Toggle ====================
      const sidebar = document.getElementById("adminSidebar");
      const icon = document.getElementById("drawer-icon");
      window.toggleSidebar = function() {
        sidebar.classList.toggle("collapsed");
        icon.style.transform = sidebar.classList.contains("collapsed") ? "rotate(0deg)" : "rotate(180deg)";
      };

      // ==================== Add/Edit Product Popup Logic ====================
      const popup = document.getElementById("popupOverlay");
      const openPopupBtn = document.getElementById("openPopupBtn");
      const closePopupBtn = document.getElementById("closePopup");
      const productForm = document.getElementById("productForm");
      const saveProductBtn = document.getElementById("saveProductBtn");
      const popupTitle = document.getElementById("popupTitle");
      const imageUploadContainer = document.getElementById("image-upload-container");
      const imageCounter = document.getElementById("imageCounter");
      const existingImagesContainer = document.getElementById("existingImagesContainer");
      const deletedImagesContainer = document.getElementById("deletedImagesContainer");
      const categorySelect = document.getElementById("category");
      const cutStyleGroup = document.getElementById("cutStyleGroup");
      const cutStylesContainer = document.getElementById("cutStylesContainer");

      let deletedImages = new Set(); // Track deleted images to avoid duplicates

      // Function to populate Cut Styles checkboxes based on category
      function populateCutStyles(categoryName) {
        cutStylesContainer.innerHTML = ""; // Clear existing checkboxes
        let styles = [];
        if (categoryName === "Meat") {
          styles = meatCutStyles;
        } else if (categoryName === "Fish") {
          styles = fishCutStyles;
        }

        styles.forEach(style => {
          const checkboxDiv = document.createElement("div");
          checkboxDiv.className = "checkbox-item";

          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.name = "cutStyles";
          checkbox.value = style;
          checkbox.id = `cutStyle-${style.replace(/\s+/g, '-')}`; // Unique ID for each checkbox

          const label = document.createElement("label");
          label.htmlFor = checkbox.id;
          label.textContent = style;

          checkboxDiv.appendChild(checkbox);
          checkboxDiv.appendChild(label);
          cutStylesContainer.appendChild(checkboxDiv);

          // Add event listener for "None" checkbox
          if (style === "None") {
            checkbox.addEventListener("change", function() {
              if (this.checked) {
                // Uncheck all other checkboxes if "None" is selected
                const otherCheckboxes = cutStylesContainer.querySelectorAll('input[name="cutStyles"]:not([value="None"])');
                otherCheckboxes.forEach(cb => {
                  cb.checked = false;
                });
              }
            });
          } else {
            // Uncheck "None" if any other option is selected
            checkbox.addEventListener("change", function() {
              if (this.checked) {
                const noneCheckbox = cutStylesContainer.querySelector('input[value="None"]');
                if (noneCheckbox) {
                  noneCheckbox.checked = false;
                }
              }
            });
          }
        });
      }

      // Show/Hide Cut Styles checkboxes and populate options based on category
      categorySelect.addEventListener("change", function() {
        const selectedOption = categorySelect.options[categorySelect.selectedIndex];
        const categoryName = selectedOption.getAttribute("data-name");
        if (categoryName === "Meat" || categoryName === "Fish") {
          cutStyleGroup.style.display = "block";
          populateCutStyles(categoryName);
        } else {
          cutStyleGroup.style.display = "none";
          cutStylesContainer.innerHTML = ""; // Clear checkboxes
          document.getElementById("errCutStyles").textContent = ""; // Clear error
        }
      });

      // Open modal for adding a new product
      openPopupBtn.addEventListener("click", () => {
        popupTitle.textContent = "Add Product";
        saveProductBtn.textContent = "ADD";
        productForm.reset();
        document.getElementById("productId").value = "";
        existingImagesContainer.innerHTML = "";
        deletedImagesContainer.innerHTML = "";
        deletedImages.clear();
        clearErrors();
        initializePlaceholders();
        updateImageCounter();
        cutStyleGroup.style.display = "none"; // Reset Cut Styles visibility
        cutStylesContainer.innerHTML = ""; // Reset Cut Styles checkboxes
        popup.classList.remove("hidden");
      });

      // Open modal for editing a product
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          popupTitle.textContent = "Edit Product";
          saveProductBtn.textContent = "UPDATE";

          // Populate form fields with product data
          const productId = btn.getAttribute('data-productid');
          const name = btn.getAttribute('data-name');
          const description = btn.getAttribute('data-description');
          const categoryId = btn.getAttribute('data-categoryid');
          const price = btn.getAttribute('data-price');
          const mrp = btn.getAttribute('data-mrp');
          const stock = btn.getAttribute('data-stock');
          const images = JSON.parse(btn.getAttribute('data-images') || '[]');

          document.getElementById('productId').value = productId;
          document.getElementById('productName').value = name;
          document.getElementById('description').value = description;
          document.getElementById('category').value = categoryId;
          document.getElementById('price').value = price;
          document.getElementById('mrp').value = mrp;
          document.getElementById('qty').value = stock;

          // Populate existing images as hidden inputs
          existingImagesContainer.innerHTML = "";
          deletedImagesContainer.innerHTML = "";
          deletedImages.clear();
          images.forEach((url, index) => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = `existingImages[${index}]`;
            input.value = url;
            existingImagesContainer.appendChild(input);
          });

          // Populate images in placeholders
          imageUploadContainer.innerHTML = "";
          images.forEach((imageUrl, index) => {
            createPlaceholder(index + 1, imageUrl);
          });
          if (images.length < 5) {
            createPlaceholder(images.length + 1);
          }
          addImageChangeListeners();
          updateImageCounter();

          // Show/Hide Cut Styles checkboxes based on category
          const selectedOption = categorySelect.options[categorySelect.selectedIndex];
          const categoryName = selectedOption.getAttribute("data-name");
          if (categoryName === "Meat" || categoryName === "Fish") {
            cutStyleGroup.style.display = "block";
            populateCutStyles(categoryName);
          } else {
            cutStyleGroup.style.display = "none";
            cutStylesContainer.innerHTML = "";
          }

          popup.classList.remove("hidden");
        });
      });

      closePopupBtn.addEventListener("click", () => {
        popup.classList.add("hidden");
        productForm.reset();
        clearErrors();
        resetPlaceholders();
        existingImagesContainer.innerHTML = "";
        deletedImagesContainer.innerHTML = "";
        deletedImages.clear();
        cutStyleGroup.style.display = "none"; // Reset Cut Styles visibility
        cutStylesContainer.innerHTML = ""; // Reset Cut Styles checkboxes
        updateImageCounter();
      });

      // Handle form submission
      saveProductBtn.addEventListener("click", function(event) {
        event.preventDefault();

        clearErrors();

        if (validateForm()) {
          console.log("Validation passed. Submitting the form via AJAX...");
          saveProductBtn.disabled = true;
          saveProductBtn.textContent = productForm.productId.value ? "Updating..." : "Adding...";

          // Append deleted images to FormData
          const formData = new FormData(productForm);
          Array.from(deletedImages).forEach((url, index) => {
            formData.append(`deletedImages[${index}]`, url);
          });


          const productId = document.getElementById("productId").value;
          const url = productId ? `/tezgrani/product/edit/${productId}` : "/tezgrani/product/save";
          const method = productId ? "PATCH" : "POST";

          $.ajax({
            url: url,
            type: method,
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
              toastr.success(productId ? "Product updated successfully!" : "Product added successfully!");
              productForm.reset();
              clearErrors();
              resetPlaceholders();
              existingImagesContainer.innerHTML = "";
              deletedImagesContainer.innerHTML = "";
              deletedImages.clear();
              popup.classList.add("hidden");
              saveProductBtn.disabled = false;
              saveProductBtn.textContent = productId ? "UPDATE" : "ADD";
              window.location.reload();
            },
            error: function(xhr, status, error) {
              const errorMsg = xhr.responseJSON?.message || "Unknown error";
              toastr.error(`Failed to ${productId ? 'update' : 'add'} product: ${errorMsg}`);
              saveProductBtn.disabled = false;
              saveProductBtn.textContent = productId ? "UPDATE" : "ADD";
            },
          });
        } else {
          console.log("Validation failed - errors should be displayed");
        }
      });

      // ==================== Cropping Modal Logic ====================
      const cropModal = document.getElementById("cropModal");
      const closeCropModalBtn = document.getElementById("closeCropModal");
      const cropDoneBtn = document.getElementById("cropDoneBtn");
      let cropper;
      let currentImageInput;
      let currentPlaceholder;

      closeCropModalBtn.addEventListener("click", () => {
        cropModal.classList.add("hidden");
        if (cropper) {
          cropper.destroy();
          cropper = null;
        }
      });

      cropDoneBtn.addEventListener("click", () => {
        if (cropper) {
          const canvas = cropper.getCroppedCanvas();
          if (canvas) {
            canvas.toBlob((blob) => {
              const file = new File([blob], currentImageInput.files[0]?.name || `cropped-image-${currentImageInput.id.replace('image', '')}.jpg`, {
                type: "image/jpeg"
              });
              const dataTransfer = new DataTransfer();
              dataTransfer.items.add(file);
              currentImageInput.files = dataTransfer.files;

              currentPlaceholder.innerHTML = `
              <img src="${canvas.toDataURL()}" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
              <div class="image-hover-controls">
                <button type="button" class="control-btn edit-btn" onclick="event.stopPropagation(); editImage(${currentImageInput.id.replace('image', '')})">
                  <span class="material-symbols-outlined">edit</span>
                </button>
                <button type="button" class="control-btn delete-btn" onclick="event.stopPropagation(); deleteImage(${currentImageInput.id.replace('image', '')})">
                  <span class="material-symbols-outlined">delete</span>
                </button>
              </div>`;
              document.getElementById("errImage").textContent = "";
              updateImageCounter();
            }, "image/jpeg");
          }
          cropper.destroy();
          cropper = null;
          cropModal.classList.add("hidden");

          addNewPlaceholderIfNeeded();
        }
      });

      // ==================== Real-Time Price vs MRP Validation ====================
      const priceInput = document.getElementById("price");
      const mrpInput = document.getElementById("mrp");

      function validatePriceVsMrp() {
        const price = parseFloat(priceInput.value);
        const mrp = parseFloat(mrpInput.value);

        if (!isNaN(price) && !isNaN(mrp) && price > mrp) {
          displayError("errPrice", "Price cannot be greater than MRP.");
          displayError("errMrp", "Price cannot be greater than MRP.");
        } else {
          document.getElementById("errPrice").textContent = "";
          document.getElementById("errMrp").textContent = "";
        }
      }

      priceInput.addEventListener("input", validatePriceVsMrp);
      mrpInput.addEventListener("input", validatePriceVsMrp);

      function clearErrors() {
        document.querySelectorAll(".errr-msg").forEach(el => {
          el.textContent = "";
          el.style.display = "block";
        });
      }

      function initializePlaceholders() {
        imageUploadContainer.innerHTML = "";
        createPlaceholder(1);
        addImageChangeListeners();
        updateImageCounter();
      }

      function resetPlaceholders() {
        initializePlaceholders();
      }

      function createPlaceholder(index, imageUrl = null) {
        const inputId = `image${index}`;
        const placeholderId = `placeholder${index}`;
        const placeholderDiv = document.createElement("div");
        placeholderDiv.className = "image-placeholder-wrapper";
        let placeholderContent = `
        <input type="file" id="${inputId}" name="images" accept="image/*" class="image-input" style="display: none;">
        <div class="image-placeholder" onclick="document.getElementById('${inputId}').click()" id="${placeholderId}">
          <span class="material-icons">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M480-480ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h320v80H200v560h560v-320h80v320q0 33-23.5 56.5T760-120H200Zm40-160h480L570-480 450-320l-90-120-120 160Zm440-320v-80h-80v-80h80v-80h80v80h80v80h-80v80h-80Z"/>
            </svg>
          </span>
        </div>`;

        if (imageUrl) {
          placeholderContent = `
          <input type="file" id="${inputId}" name="images" accept="image/*" class="image-input" style="display: none;">
          <div class="image-placeholder" id="${placeholderId}">
            <img src="${imageUrl}" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
            <div class="image-hover-controls">
              <button type="button" class="control-btn edit-btn" onclick="event.stopPropagation(); editImage(${index})">
                <span class="material-symbols-outlined">edit</span>
              </button>
              <button type="button" class="control-btn delete-btn" onclick="event.stopPropagation(); deleteImage(${index}, '${imageUrl}')">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>`;
        }

        placeholderDiv.innerHTML = placeholderContent;
        imageUploadContainer.appendChild(placeholderDiv);
      }

      function addNewPlaceholderIfNeeded() {
        const placeholders = document.querySelectorAll(".image-placeholder-wrapper");
        if (placeholders.length < 5) {
          createPlaceholder(placeholders.length + 1);
          addImageChangeListeners();
        }
      }

      function getImageCount() {
        const placeholders = document.querySelectorAll(".image-placeholder");
        let count = 0;
        placeholders.forEach(placeholder => {
          if (placeholder.querySelector("img")) {
            count++;
          }
        });
        return count;
      }

      function updateImageCounter() {
        const count = getImageCount();
        imageCounter.textContent = `${count}/5`;
        imageCounter.style.color = count < 3 ? "red" : "green";
      }

      function addImageChangeListeners() {
        const inputs = document.querySelectorAll(".image-input");
        inputs.forEach(input => {
          // Remove existing listeners to prevent duplicates
          input.removeEventListener("change", handleImageChange);
          input.addEventListener("change", handleImageChange);
        });
      }

      function handleImageChange(event) {
        const imageInput = event.target;
        const placeholder = document.getElementById(`placeholder${imageInput.id.replace('image', '')}`);

        if (imageInput.files && imageInput.files[0]) {
          const file = imageInput.files[0];

          if (!file.type.match('image.*')) {
            displayError("errImage", "Please select a valid image file (e.g., JPEG, PNG).");
            imageInput.value = '';
            return;
          }

          currentImageInput = imageInput;
          currentPlaceholder = placeholder;
          const reader = new FileReader();
          reader.onload = function(e) {
            const cropImage = document.getElementById("cropImage");
            cropImage.src = e.target.result;
            cropModal.classList.remove("hidden");

            if (cropper) {
              cropper.destroy();
            }
            cropper = new Cropper(cropImage, {
              aspectRatio: 1,
              viewMode: 1,
              autoCropArea: 1,
            });
          };
          reader.readAsDataURL(file);
        }
      }

      function displayError(elementId, message) {
        const errorElement = document.getElementById(elementId);
        if (errorElement) {
          errorElement.textContent = message;
          errorElement.style.display = "block";
          console.log(`Setting error for ${elementId}: ${message}`);
        } else {
          console.error(`Error element not found: ${elementId}`);
        }
      }

      function validateForm() {
        let isValid = true;

        const productName = document.getElementById("productName");
        const category = document.getElementById("category");
        const price = document.getElementById("price");
        const mrp = document.getElementById("mrp");
        const qty = document.getElementById("qty");
        const description = document.getElementById("description");
        const cutStyles = Array.from(cutStylesContainer.querySelectorAll('input[name="cutStyles"]:checked')).map(cb => cb.value);

        if (!productName.value.trim()) {
          isValid = false;
          displayError("errProductName", "Product name is required.");
        }

        if (!category.value) {
          isValid = false;
          displayError("errCategory", "Please select a category.");
        }

        // Validate Cut Styles if visible (i.e., category is Meat or Fish)
        const selectedOption = category.options[category.selectedIndex];
        const categoryName = selectedOption ? selectedOption.getAttribute("data-name") : "";
        if (categoryName === "Meat" || categoryName === "Fish") {
          if (cutStyles.length === 0) {
            isValid = false;
            displayError("errCutStyles", "Please select at least one cutting style or 'None'.");
          } else if (cutStyles.includes("None") && cutStyles.length > 1) {
            isValid = false;
            displayError("errCutStyles", "If 'None' is selected, no other cutting styles should be selected.");
          }
        }

        if (!price.value.trim()) {
          isValid = false;
          displayError("errPrice", "Price is required.");
        } else if (isNaN(parseFloat(price.value)) || parseFloat(price.value) < 0) {
          isValid = false;
          displayError("errPrice", "Price must be a positive number.");
        }

        if (!mrp.value.trim()) {
          isValid = false;
          displayError("errMrp", "MRP is required.");
        } else if (isNaN(parseFloat(mrp.value)) || parseFloat(mrp.value) < 0) {
          isValid = false;
          displayError("errMrp", "MRP must be a positive number.");
        } else if (parseFloat(mrp.value) < parseFloat(price.value)) {
          isValid = false;
          displayError("errPrice", "Price cannot be greater than MRP.");
          displayError("errMrp", "Price cannot be greater than MRP.");
        }

        if (!qty.value.trim()) {
          isValid = false;
          displayError("errQty", "Quantity is required.");
        } else if (isNaN(parseInt(qty.value)) || parseInt(qty.value) < 0) {
          isValid = false;
          displayError("errQty", "Quantity must be a positive number.");
        }

        if (!description.value.trim()) {
          isValid = false;
          displayError("errDescription", "Description is required.");
        }

        const imageCount = getImageCount();
        if (imageCount < 3) {
          isValid = false;
          displayError("errImage", `Please upload at least 3 images. Currently, you have ${imageCount}.`);
        } else if (imageCount > 5) {
          isValid = false;
          displayError("errImage", `You can upload a maximum of 5 images. Currently, you have ${imageCount}.`);
        }

        return isValid;
      }

      // ==================== Image Edit and Delete Functions ====================
      window.editImage = function(imageIndex) {
        console.log(`Editing image ${imageIndex}`);
        const placeholder = document.getElementById(`placeholder${imageIndex}`);
        const imageInput = document.getElementById(`image${imageIndex}`);

        const imgElement = placeholder.querySelector("img");
        if (imgElement) {
          currentImageInput = imageInput;
          currentPlaceholder = placeholder;

          const cropImage = document.getElementById("cropImage");
          cropImage.src = imgElement.src;
          cropModal.classList.remove("hidden");

          if (cropper) {
            cropper.destroy();
          }
          cropper = new Cropper(cropImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
          });
        }
      };

      window.deleteImage = function(imageIndex, imageUrl = null) {
        console.log(`Deleting image ${imageIndex}`);
        const placeholderWrapper = document.getElementById(`placeholder${imageIndex}`).parentElement;
        placeholderWrapper.remove();

        // If this is an existing image, mark it for deletion
        if (imageUrl) {
          deletedImages.add(imageUrl);
        }

        // Re-index remaining placeholders
        const remainingWrappers = document.querySelectorAll(".image-placeholder-wrapper");
        remainingWrappers.forEach((wrapper, idx) => {
          const newIndex = idx + 1;
          const input = wrapper.querySelector(".image-input");
          const placeholder = wrapper.querySelector(".image-placeholder");
          input.id = `image${newIndex}`;
          placeholder.id = `placeholder${newIndex}`;
          placeholder.setAttribute("onclick", `document.getElementById('image${newIndex}').click()`);

          const img = placeholder.querySelector("img");
          if (img) {
            const editBtn = placeholder.querySelector(".edit-btn");
            const deleteBtn = placeholder.querySelector(".delete-btn");
            editBtn.setAttribute("onclick", `event.stopPropagation(); editImage(${newIndex})`);
            deleteBtn.setAttribute("onclick", `event.stopPropagation(); deleteImage(${newIndex}, '${img.src}')`);
          }
        });

        // Add a new placeholder if none exist
        if (remainingWrappers.length === 0) {
          createPlaceholder(1);
          addImageChangeListeners();
        }

        updateImageCounter();
      };

      // Initialize with 1 placeholder
      initializePlaceholders();

      // List/Unlist (Block/Unblock) button with confirmation modal
      const confirmModal = document.getElementById('confirm-modal');
      const cancelAction = document.getElementById('cancel-action');
      const confirmAction = document.getElementById('confirm-action');

      // Single event listeners for modal buttons
      cancelAction.addEventListener('click', () => {
        confirmModal.style.display = 'none';
      });

      confirmAction.addEventListener('click', async () => {
        if (confirmModal.dataset.productId) {
          const productId = confirmModal.dataset.productId;
          const newStatus = confirmModal.dataset.newStatus === 'true';

          confirmModal.style.display = 'none';
          confirmModal.removeAttribute('data-productId');
          confirmModal.removeAttribute('data-newStatus');

          try {
            console.log('Toggling productId:', productId, 'with status:', newStatus);
            const response = await fetch(`/tezgrani/product/toggle-block/${productId}`, {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                isBlocked: newStatus
              })
            });
            const data = await response.json();
            console.log('Server response:', data);
            if (data.success) {
              toastr.success(newStatus ? "Product blocked successfully!" : "Product unblocked successfully!");
              window.location.reload();
            } else {
              toastr.error(`Failed to update product status: ${data.message || 'No message provided'}`);
            }
          } catch (err) {
            console.error('Error toggling product status:', err);
            toastr.error(`Error occurred: ${err.message || 'Unknown error'}`);
          }
        }
      });

      document.querySelectorAll('.list-toggle').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const productId = btn.getAttribute('data-productid');
          const currentStatus = btn.getAttribute('data-status') === 'true';
          const newStatus = !currentStatus;

          // Store data in modal dataset
          confirmModal.dataset.productId = productId;
          confirmModal.dataset.newStatus = newStatus;
          confirmModal.style.display = 'block';
        });
      });

      // Logout Modal Logic
      const logoutModal = document.getElementById("logout-modal");
      const confirmLogoutBtn = document.getElementById("confirm-logout");
      const cancelLogoutBtn = document.getElementById("cancel-logout");

      window.showLogoutModal = function() {
        logoutModal.style.display = "flex";
      };

      confirmLogoutBtn.addEventListener("click", function() {
        logoutModal.style.display = "none";
        window.location.href = "/tezgrani/logout";
      });

      cancelLogoutBtn.addEventListener("click", function() {
        logoutModal.style.display = "none";
      });

      window.addEventListener("click", function(e) {
        if (e.target === logoutModal) {
          logoutModal.style.display = "none";
        }
      });

      // Add click outside handler for block/unblock modal
      window.addEventListener("click", function(e) {
        if (e.target === confirmModal) {
          confirmModal.style.display = "none";
          confirmModal.removeAttribute('data-productId');
          confirmModal.removeAttribute('data-newStatus');
        }
      });
    });
  </script>
</body>

</html>