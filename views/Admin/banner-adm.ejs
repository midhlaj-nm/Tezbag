<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gallery Management</title>
  <link rel="stylesheet" href="/Admin-css/banner-adm.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
</head>

<body>
  <div id="middle" class="container-fluid">
    <div class="logo">
      <img width="250" src="/Admin-css/Logo-Admins.jpg" alt="Logo">
    </div>
  </div>

  <!-- Sidebar -->
  <div class="sidebar" id="adminSidebar">
    <ul class="sidebar-links">
      <li>
        <a href="/tezgrani/dashboard">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#5f5f5f">
              <path d="M520-600v-240h320v240H520ZM120-440v-400h320v400H120Zm400 320v-400h320v400H520Zm-400 0v-240h320v240H120Zm80-400h160v-240H200v240Zm400 320h160v-240H600v240Zm0-480h160v-80H600v80ZM200-200h160v-80H200v80Zm160-320Zm240-160Zm0 240ZM360-280Z" />
            </svg>
          </span>
          <span>Dashboard</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/order-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM246-720l96 200h280l110-200H246Zm-38-80h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Zm134 280h280-280Z" />
            </svg>
          </span>
          <span>Orders</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/category-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="m260-520 220-360 220 360H260ZM700-80q-75 0-127.5-52.5T520-260q0-75 52.5-127.5T700-440q75 0 127.5 52.5T880-260q0 75-52.5 127.5T700-80Zm-580-20v-320h320v320H120Zm580-60q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Zm-500-20h160v-160H200v160Zm202-420h156l-78-126-78 126Zm78 0ZM360-340Zm340 80Z" />
            </svg>
          </span>
          <span>Category</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/product-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M200-80q-33 0-56.5-23.5T120-160v-451q-18-11-29-28.5T80-680v-120q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v120q0 23-11 40.5T840-611v451q0 33-23.5 56.5T760-80H200Zm0-520v440h560v-440H200Zm-40-80h640v-120H160v120Zm200 280h240v-80H360v80Zm120 20Z" />
            </svg>
          </span>
          <span>Products</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/user-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M0-240v-63q0-43 44-70t116-27q13 0 25 .5t23 2.5q-14 21-21 44t-7 48v65H0Zm240 0v-65q0-32 17.5-58.5T307-410q32-20 76.5-30t96.5-10q53 0 97.5 10t76.5 30q32 20 49 46.5t17 58.5v65H240Zm540 0v-65q0-26-6.5-49T754-397q11-2 22.5-2.5t23.5-.5q72 0 116 26.5t44 70.5v63H780Zm-455-80h311q-10-20-55.5-35T480-370q-55 0-100.5 15T325-320ZM160-440q-33 0-56.5-23.5T80-520q0-34 23.5-57t56.5-23q34 0 57 23t23 57q0 33-23 56.5T160-440Zm640 0q-33 0-56.5-23.5T720-520q0-34 23.5-57t56.5-23q34 0 57 23t23 57q0 33-23 56.5T800-440Zm-320-40q-50 0-85-35t-35-85q0-51 35-85.5t85-34.5q51 0 85.5 34.5T600-600q0 50-34.5 85T480-480Zm0-80q17 0 28.5-11.5T520-600q0-17-11.5-28.5T480-640q-17 0-28.5 11.5T440-600q0 17 11.5 28.5T480-560Zm1 240Zm-1-280Z" />
            </svg>
          </span>
          <span>Users</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/deals-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M160-280v80h640v-80H160Zm0-440h88q-5-9-6.5-19t-1.5-21q0-50 35-85t85-35q30 0 55.5 15.5T460-826l20 26 20-26q18-24 44-39t56-15q50 0 85 35t35 85q0 11-1.5 21t-6.5 19h88q33 0 56.5 23.5T880-640v440q0 33-23.5 56.5T800-120H160q-33 0-56.5-23.5T80-200v-440q0-33 23.5-56.5T160-720Zm0 320h640v-240H596l84 114-64 46-136-184-136 184-64-46 82-114H160v240Zm200-320q17 0 28.5-11.5T400-760q0-17-11.5-28.5T360-800q-17 0-28.5 11.5T320-760q0 17 11.5 28.5T360-720Zm240 0q17 0 28.5-11.5T640-760q0-17-11.5-28.5T600-800q-17 0-28.5 11.5T560-760q0 17 11.5 28.5T600-720Z" />
            </svg>
          </span>
          <span>Deals</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/return-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M360-240 120-480l240-240 56 56-144 144h488v-160h80v240H272l144 144-56 56Z" />
            </svg>
          </span>
          <span>Returns</span>
        </a>
      </li>
      <li>
        <a href="/tezgrani/sales-report">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M640-160v-280h160v280H640Zm-240 0v-640h160v640H400Zm-240 0v-440h160v440H160Z" />
            </svg>
          </span>
          <span>Sales Report</span>
        </a>
      </li>
      <li class="active">
        <a href="/tezgrani/gallery-management">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm0-80h640v-480H160v480Zm80-80h480L570-520 450-360l-90-120-120 160Zm-80 80v-480 480Z" />
            </svg>
          </span>
          <span>Gallery</span>
        </a>
      </li>
      <li>
        <a href="#" onclick="showLogoutModal()">
          <span class="icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z" />
            </svg>
          </span>
          <span>Log-out</span>
        </a>
      </li>
    </ul>
    <button class="floating-toggle-btn" onclick="toggleSidebar()">
      <svg id="drawer-icon" xmlns="http://www.w3.org/2000/svg" height="28px" viewBox="0 -960 960 960" width="28px" fill="#000000">
        <path d="M360-120v-720h80v720h-80Zm160-160v-400l200 200-200 200Z" />
      </svg>
    </button>
  </div>

  <!-- Content Area -->
  <div class="content">
    <div class="gallery-management-container">
      <h3 class="gallery-heading">Gallery Management</h3>
      <button class="upload-banner-btn" id="openUploadModal">Upload Banner</button>
    </div>
    <div class="banner-preview-container">
      <% banners.forEach(banner => { %>
        <div class="banner-preview">
          <div class="banner-image" style="background-image: url('<%= banner.image %>'); width: 307px; height: 150px; border-radius: 8px; background-size: cover; background-position: center;"></div>
          <div class="banner-details">
            <p class="banner-name"><%= banner.title %></p>
            <p class="banner-position"><%= banner.position %></p>
            <div class="banner-actions">
              <button class="status-btn <%= banner.status === 'Active' ? 'active' : '' %>" data-banner-id="<%= banner._id %>" data-status="<%= banner.status %>"><%= banner.status %></button>
              <button class="delete-btn" data-banner-id="<%= banner._id %>">Delete Banner</button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Upload Banner Modal -->
  <div class="overlay hidden" id="popupOverlay">
    <div class="popup">
      <div class="popup-header">
        <h2 class="popup-title" id="popupTitle">Upload Banner</h2>
        <button class="close-btn" id="closePopup">×</button>
      </div>
      <div class="popup-content">
        <form id="bannerForm" enctype="multipart/form-data" novalidate>
          <div class="form-group">
            <label for="bannerName">Banner Name</label>
            <input type="text" id="bannerName" name="bannerName" placeholder="Enter Banner Name">
            <div id="errBannerName" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label for="position">Position</label>
            <select id="position" name="position">
              <option value="" disabled selected hidden>Select Position</option>
              <option value="homepage top">Homepage Top</option>
              <option value="homepage bottom">Homepage Bottom</option>
              <option value="shop page">Shop Page</option>
            </select>
            <div id="errPosition" class="errr-msg"></div>
          </div>
          <div class="form-group">
            <label>Image <span id="imageCounter">0/1</span>&nbsp;&nbsp;<span style="opacity:0.8;">(Maximum 10mb)</span></label>
            <div id="image-upload-container" class="image-upload-container"></div>
            <div id="errImage" class="errr-msg"></div>
          </div>
        </form>
      </div>
      <div class="popup-footer">
        <button type="submit" class="btn btn-primary" id="saveBannerBtn" form="bannerForm">SAVE</button>
      </div>
    </div>
  </div>

  <!-- Logout Modal -->
  <div id="logout-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3 style="font-size: 1.75rem; font-weight: 500;">Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-logout" class="btn-no">NO</button>
        <button id="confirm-logout" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <!-- Confirmation Modal for Delete -->
  <div id="confirmation-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3 style="font-size: 1.75rem; font-weight: 500;">Are you sure?</h3>
      <div class="modal-buttons">
        <button id="cancel-confirmation" class="btn-no">NO</button>
        <button id="confirm-confirmation" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <!-- JavaScript -->
  <script>
    toastr.options = {
      "debug": false,
      "preventDuplicates": false,
      "onclick": null,
      "showDuration": "300",
      "hideDuration": "1000",
      "timeOut": "5000",
      "extendedTimeOut": "1000",
      "showEasing": "swing",
      "hideEasing": "linear",
      "showMethod": "fadeIn",
      "hideMethod": "fadeOut"
    }

    function toggleSidebar() {
      const sidebar = document.getElementById("adminSidebar");
      const icon = document.getElementById("drawer-icon");
      sidebar.classList.toggle("collapsed");
      icon.style.transform = sidebar.classList.contains("collapsed") ? "rotate(0deg)" : "rotate(180deg)";
    }

    function showLogoutModal() {
      const logoutModal = document.getElementById('logout-modal');
      logoutModal.style.display = 'flex';
    }

    // Handle Confirmation Modal for Delete
    function showConfirmationModal(bannerId) {
      const confirmationModal = document.getElementById('confirmation-modal');
      confirmationModal.style.display = 'flex';
      confirmationModal.setAttribute('data-banner-id', bannerId); // Store banner ID in modal

      const cancelConfirmationBtn = document.getElementById('cancel-confirmation');
      const confirmConfirmationBtn = document.getElementById('confirm-confirmation');

      cancelConfirmationBtn.addEventListener('click', () => {
        confirmationModal.style.display = 'none';
      });

      confirmConfirmationBtn.addEventListener('click', async () => {
        const bannerId = confirmationModal.getAttribute('data-banner-id');
        try {
          const response = await fetch(`/tezgrani/banner/delete/${bannerId}`, {
            method: 'DELETE',
          });
          if (!response.ok) throw new Error('Network response was not ok');
          const data = await response.json();
          toastr.success("Banner deleted successfully!");
          $(`[data-banner-id="${bannerId}"]`).closest('.banner-preview').remove();
        } catch (error) {
          toastr.error("Failed to delete banner.");
        }
        confirmationModal.style.display = 'none';
      });
    }

    // Handle Upload Banner Modal
    const popup = document.getElementById("popupOverlay");
    const openUploadModalBtn = document.getElementById("openUploadModal");
    const closePopupBtn = document.getElementById("closePopup");
    const bannerForm = document.getElementById("bannerForm");
    const saveBannerBtn = document.getElementById("saveBannerBtn");
    const popupTitle = document.getElementById("popupTitle");
    const imageUploadContainer = document.getElementById("image-upload-container");
    const imageCounter = document.getElementById("imageCounter");

    // Initialize placeholders
    function initializePlaceholders() {
      imageUploadContainer.innerHTML = "";
      createPlaceholder(1);
      addImageChangeListeners();
      updateImageCounter();
    }

    function createPlaceholder(index, imageUrl = null) {
      const inputId = `image${index}`;
      const placeholderId = `placeholder${index}`;
      const placeholderDiv = document.createElement("div");
      placeholderDiv.className = "image-placeholder-wrapper";
      let placeholderContent = `
        <input type="file" id="${inputId}" name="bannerImage" accept="image/*" class="image-input" style="display: none;">
        <div class="image-placeholder" onclick="document.getElementById('${inputId}').click()" id="${placeholderId}">
          <span class="material-icons">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5f5f5f">
              <path d="M480-480ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h320v80H200v560h560v-320h80v320q0 33-23.5 56.5T800-120H200Zm40-160h480L570-520 450-360l-90-120-120 160Zm440-320v-80h-80v-80h80v-80h80v80h80v80h-80v80h-80Z"/>
            </svg>
          </span>
        </div>`;

      if (imageUrl) {
        placeholderContent = `
          <input type="file" id="${inputId}" name="bannerImage" accept="image/*" class="image-input" style="display: none;">
          <div class="image-placeholder" id="${placeholderId}">
            <img src="${imageUrl}" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
          </div>`;
      }

      placeholderDiv.innerHTML = placeholderContent;
      imageUploadContainer.appendChild(placeholderDiv);
    }

    function addImageChangeListeners() {
      const inputs = document.querySelectorAll(".image-input");
      inputs.forEach(input => {
        input.removeEventListener("change", handleImageChange);
        input.addEventListener("change", handleImageChange);
      });
    }

    function handleImageChange(event) {
      const imageInput = event.target;
      const placeholder = document.getElementById(`placeholder${imageInput.id.replace('image', '')}`);

      if (imageInput.files && imageInput.files[0]) {
        const file = imageInput.files[0];
        if (!file.type.match('image.*')) {
          displayError("errImage", "Please select a valid image file (e.g., JPEG, PNG, WEBP).");
          imageInput.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          displayError("errImage", "Image size must be less than 10MB.");
          imageInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
          placeholder.innerHTML = `
            <img src="${e.target.result}" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">`;
          document.getElementById("errImage").textContent = "";
          updateImageCounter();
        };
        reader.readAsDataURL(file);
      }
    }

    function deleteImage(imageIndex, imageUrl = null) {
      const placeholderWrapper = document.getElementById(`placeholder${imageIndex}`).parentElement;
      placeholderWrapper.remove();
      updateImageCounter();
      if (imageUrl) {
        // Handle deletion of existing images (e.g., send to backend)
        console.log(`Deleted existing image: ${imageUrl}`);
      }
      if (document.querySelectorAll(".image-placeholder-wrapper").length === 0) {
        createPlaceholder(1);
        addImageChangeListeners();
      }
    }

    function updateImageCounter() {
      const count = document.querySelectorAll(".image-placeholder img").length;
      imageCounter.textContent = `${count}/1`;
      imageCounter.style.color = count === 1 ? "green" : "red";
    }

    // Open modal for adding a new banner
    openUploadModalBtn.addEventListener("click", () => {
      popupTitle.textContent = "Upload Banner";
      saveBannerBtn.textContent = "SAVE";
      bannerForm.reset();
      clearErrors();
      initializePlaceholders();
      popup.classList.remove("hidden");
    });

    closePopupBtn.addEventListener("click", () => {
      popup.classList.add("hidden");
      bannerForm.reset();
      clearErrors();
      initializePlaceholders();
    });

    // Handle form submission
    saveBannerBtn.addEventListener("click", async function(event) {
      event.preventDefault();
      clearErrors();

      if (validateForm()) {
        const formData = new FormData(bannerForm);
        saveBannerBtn.disabled = true;
        saveBannerBtn.textContent = "Saving...";

        try {
          const response = await fetch('/tezgrani/banner/save', {
            method: 'POST',
            body: formData,
          });
          if (!response.ok) throw new Error('Network response was not ok');

          // Show success message and refresh page to reflect the new banner
          toastr.success("Banner uploaded successfully!");
          bannerForm.reset();
          clearErrors();
          initializePlaceholders();
          popup.classList.add("hidden");
          saveBannerBtn.disabled = false;
          saveBannerBtn.textContent = "SAVE";
          location.reload(); // Refresh the page to show updated gallery
        } catch (error) {
          const errorMsg = error.message || "Unknown error";
          toastr.error(`Failed to upload banner: ${errorMsg}`);
          saveBannerBtn.disabled = false;
          saveBannerBtn.textContent = "SAVE";
        }
      }
    });

    // Handle delete banner with confirmation modal
    document.querySelectorAll('.delete-btn').forEach(button => {
      button.addEventListener('click', function() {
        const bannerId = this.getAttribute('data-banner-id');
        showConfirmationModal(bannerId);
      });
    });

    // Handle toggle status
    document.querySelectorAll('.status-btn').forEach(button => {
      button.addEventListener('click', async function() {
        const bannerId = this.getAttribute('data-banner-id');
        const currentStatus = this.getAttribute('data-status');
        const newStatus = currentStatus === 'Active' ? 'Inactive' : 'Active';

        try {
          const response = await fetch(`/tezgrani/banner/toggle-status/${bannerId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ status: newStatus }),
          });
          if (!response.ok) throw new Error('Network response was not ok');
          const data = await response.json();

          // Update button text and class
          this.textContent = newStatus;
          this.setAttribute('data-status', newStatus);
          this.className = `status-btn ${newStatus === 'Active' ? 'active' : ''}`;
          toastr.success(`Banner status updated to ${newStatus}!`);
        } catch (error) {
          toastr.error(`Failed to update banner status: ${error.message}`);
        }
      });
    });

    function clearErrors() {
      document.querySelectorAll(".errr-msg").forEach(el => {
        el.textContent = "";
        el.style.display = "block";
      });
    }

    function displayError(elementId, message) {
      const errorElement = document.getElementById(elementId);
      if (errorElement) {
        errorElement.textContent = message;
        errorElement.style.display = "block";
      }
    }

    function validateForm() {
      let isValid = true;

      const bannerName = document.getElementById("bannerName");
      const position = document.getElementById("position");
      const imageCount = document.querySelectorAll(".image-placeholder img").length;

      if (!bannerName.value.trim()) {
        isValid = false;
        displayError("errBannerName", "Banner name is required.");
      }

      if (!position.value) {
        isValid = false;
        displayError("errPosition", "Please select a position.");
      }

      if (imageCount !== 1) {
        isValid = false;
        displayError("errImage", "Please upload 1 image.");
      }

      return isValid;
    }

    // Logout Modal Logic
    document.addEventListener('DOMContentLoaded', function() {
      const logoutModal = document.getElementById('logout-modal');
      const confirmLogoutBtn = document.getElementById('confirm-logout');
      const cancelLogoutBtn = document.getElementById('cancel-logout');

      confirmLogoutBtn.addEventListener('click', () => {
        logoutModal.style.display = 'none';
        window.location.href = '/tezgrani/logout';
      });

      cancelLogoutBtn.addEventListener('click', () => {
        logoutModal.style.display = 'none';
      });

      window.addEventListener('click', function(e) {
        if (e.target === logoutModal) {
          logoutModal.style.display = 'none';
        }
      });
    });
  </script>
</body>

</html>