    async function getCoordinates(pincode) {
      console.log(`Get Coordinates: Fetching coordinates for pincode: ${pincode}`);
      try {
        const response = await fetch(`https://maps.googleapis.com/maps/api/geocode/json?address=${pincode}&key=<%= GOOGLE_API_KEY %>`);
        const data = await response.json();
        if (data.status === "OK" && data.results.length > 0) {
          const location = data.results[0].geometry.location;
          console.log(`Get Coordinates: Coordinates found: ${location.lat}, ${location.lng}`);
          return {
            latitude: location.lat,
            longitude: location.lng
          };
        } else {
          console.log(`Get Coordinates: No coordinates found for pincode: ${pincode}, Status: ${data.status}`);
          return null;
        }
      } catch (error) {
        console.error("Get Coordinates: Geocoding API error:", error);
        return null;
      }
    }

    function calculateDistance(lat1, lon1, lat2, lon2) {
      const R = 6371; // Earth's radius in kilometers
      const dLat = toRadians(lat2 - lat1);
      const dLon = toRadians(lon2 - lon1);
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRadians(lat1)) * Math.cos(toRadians(lat2)) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      const distance = R * c;
      console.log(`Calculate Distance: Calculated distance: ${distance.toFixed(2)} km`);
      return distance;
    }

    function toRadians(degrees) {
      return degrees * (Math.PI / 180);
    }

    async function checkDeliveryEligibility(pincode) {
      console.log(`Check Delivery Eligibility: Checking for pincode: ${pincode}`);
      const customerCoords = await getCoordinates(pincode);
      if (!customerCoords) {
        console.log('Check Delivery Eligibility: Unable to get customer coordinates.');
        return {
          eligible: false,
          message: "Unable to determine delivery location"
        };
      }

      const distance = calculateDistance(
        shopCoords.latitude, shopCoords.longitude,
        customerCoords.latitude, customerCoords.longitude
      );

      const eligible = distance <= 5; // Assuming 5 km limit
      const message = eligible ? "Delivery available" : `Delivery not available beyond 5 km (current: ${distance.toFixed(2)} km)`;
      console.log(`Check Delivery Eligibility: Result - Eligible: ${eligible}, Message: ${message}`);
      return {
        eligible: eligible,
        message: message
      };
    }

    async function selectAddress(index) {
