<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="stylesheet" href="/User-css/checkout-user.css">
  <%- include("../../views/Partials/user/header-ho") %>
  <hr style="margin: 0rem 0rem 1rem 0rem; background-color: #535353;">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout - TezBag</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.13/lottie.min.js"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>
<style>
  #toast-container>.toast {
    opacity: 1;
  }

  .toast-success {
    background-color: #4CAF50;
  }

  .toast-error {
    background-color: #e92e20;
  }

  .modal {
    display: none;
    position: fixed;
    z-index: 1055;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .modal.show {
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  .modal-dialog {
    position: relative;
    width: auto;
    margin: 0 auto;
    max-width: 600px;
    pointer-events: none;
  }

  .modal-content {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    pointer-events: auto;
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid rgba(0, 0, 0, .125);
    border-radius: 0.5rem;
    outline: 0;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, .15);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1rem;
    border-bottom: 1px solid #dee2e6;
    border-top-left-radius: calc(0.5rem - 1px);
    border-top-right-radius: calc(0.5rem - 1px);
  }

  .modal-title {
    margin: 0;
    line-height: 1.5;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #000;
    opacity: 0.5;
    line-height: 1;
    padding: 0;
    width: 1em;
    height: 1em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-btn:hover {
    opacity: 0.75;
  }

  .modal-body {
    position: relative;
    flex: 1 1 auto;
    padding: 1rem;
    max-height: 60vh;
    overflow-y: auto;
  }

  .modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-top: 1px solid #dee2e6;
    border-bottom-right-radius: calc(0.5rem - 1px);
    border-bottom-left-radius: calc(0.5rem - 1px);
  }

  .form-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .input-wrapper {
    flex: 1;
    min-width: 200px;
  }

  .input-wrapper.full-width {
    flex: 1 1 100%;
  }

  .input-wrapper label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.5rem;
    color: #333;
  }

  .input-wrapper input,
  .input-wrapper select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    font-size: 1rem;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
  }

  .input-wrapper input:focus,
  .input-wrapper select:focus {
    border-color: #28a745;
    outline: 0;
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
  }

  .optional {
    color: #6c757d;
    font-weight: 400;
  }

  .errr-msg {
    color: #dc3545;
    font-size: 0.875rem;
    margin-top: 0.25rem;
    display: none;
  }

  .errr-msg.show {
    display: block;
  }

  .default-checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .default-checkbox-wrapper input[type="checkbox"] {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: #28a745;
  }

  .default-checkbox-wrapper label {
    margin: 0;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .btn {
    display: inline-block;
    font-weight: 400;
    text-align: center;
    vertical-align: middle;
    cursor: pointer;
    border: 1px solid transparent;
    padding: 0.375rem 0.75rem;
    font-size: 1rem;
    line-height: 1.5;
    border-radius: 0.375rem;
    transition: all 0.15s ease-in-out;
    text-decoration: none;
  }

  .btn-success {
    color: #fff;
    background-color: #28a745;
    border-color: #28a745;
  }

  .btn-success:hover {
    background-color: #218838;
    border-color: #1e7e34;
  }

  .btn-secondary {
    color: #fff;
    background-color: #6c757d;
    border-color: #6c757d;
  }

  .btn-secondary:hover {
    background-color: #5a6268;
    border-color: #545b62;
  }

  .demo-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .demo-button {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
    margin: 10px;
  }

  .demo-button:hover {
    background-color: #0056b3;
  }

  .errr-msg {
    color: red;
    font-size: 0.9rem;
    display: none;
    margin-top: 5px;
    font-family: 'Poppins', sans-serif;
  }

  @media (max-width: 768px) {
    .modal-dialog {
      margin: 1rem;
      max-width: calc(100% - 2rem);
    }

    .modal-content {
      width: 100%;
    }
  }

  .delivery-status {
    background-color: #f8d7da91;
    color: #721c24;
    border: 1px solid #721c24;
    padding: 10px;
    border-radius: 5px;
    margin-bottom: 2rem;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 1.4rem;
  }

  .place-order-btn.disabled {
    background-color: #6c757d !important;
    cursor: not-allowed;
    border-color: #6c757d !important;
  }
</style>

<body>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <% breadcrumbs.forEach((crumb, index) => { %>
      <li class="breadcrumb-item <%= index === breadcrumbs.length - 1 ? 'active' : '' %>">
        <% if (index !== breadcrumbs.length - 1) { %>
        <a href="<%= crumb.url %>"><%= crumb.name %></a>
        <% } else { %>
        <%= crumb.name %>
        <% } %>
      </li>
      <% }) %>
    </ol>
  </nav>

  <div class="checkout-container">
    <h1 class="checkout-title">Checkout</h1>
    <div id="delivery-status" class="delivery-status" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#721c24">
        <path d="m40-120 440-760 440 760H40Zm440-120q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Z" />
      </svg>
      Delivery is not available to this address.
    </div>

    <div class="row">
      <div class="col-lg-8">
        <div class="delivery-section">
          <div class="section-header">
            <h4 class="section-title">Delivery Info<br><span style="font-weight: 400; font-size: small; opacity: 0.9;">Confirm Address before placing order</span></h4>
            <button class="add-address-btn" id="changeAddressBtn" onclick="openAddressModal()">
              <i class="fas fa-plus"></i> Add Address
            </button>
          </div>

          <div class="addresses-grid" id="addressesContainer">
            <% if (savedAddresses && savedAddresses.length > 0) { %>
            <% savedAddresses.forEach((address, index) => { %>
            <div class="address-card <%= address.isDefault ? 'default' : '' %>" data-index="<%= index %>" onclick="selectAddress('<%= index %>')">
              <% if (address.isDefault) { %>
              <div class="default-badge">Default</div>
              <% } %>
              <div class="address-info">
                <h4><%= address.firstName %> <%= address.lastName %></h4>
                <p><%= address.streetAddress %><%= address.landmark ? ', ' + address.landmark : '' %>, <%= address.city %>, <%= address.state %> <%= address.pinCode %></p>
                <p><strong>Phone:</strong> <%= address.phone %></p>
              </div>
              <div class="address-actions">
                <button class="action-btn edit-btn" onclick="editAddress('<%= index %>')">
                  <span class="material-symbols-outlined">edit</span>
                </button>
                <button class="action-btn delete-btn" onclick="showOrderConfirmModal('<%= index %>', 'delete')">
                  <span class="material-symbols-outlined">delete</span>
                </button>
                <button class="action-btn use-btn" onclick="selectAddress('<%= index %>')">
                  Use this
                </button>
              </div>
            </div>
            <% }) %>
            <% } else { %>
            <div class="no-address" id="noAddressState">
              <svg xmlns="http://www.w3.org/2000/svg" height="60px" viewBox="0 -960 960 960" width="60px" fill="#737373">
                <path d="M522-82v-60q45-6 87.5-23.5T689-212l41 44q-46 38-98 59T522-82Zm269-148-43-41q27-36 45-77.5t25-89.5h61q-8 60-30.5 112.5T791-230Zm27-292q-7-48-25-89t-45-78l43-41q38 50 58 99t30 109h-61ZM437-82Q284-99 182.5-212.5T81-480q0-154 101.5-267.5T437-878v60q-128 17-212 113t-84 225q0 129 84 225t212 113v60Zm253-666q-39-27-81.5-44.5T524-818v-60q54 8 107 29t99 57l-40 44ZM480-269q-60-51-113.5-110T313-516q0-71 48.5-121.5T480-688q70 0 118.5 50.5T647-516q0 78-53.5 137T480-269Zm0-209q19 0 32-13t13-32q0-17-13-31t-32-14q-19 0-32 14t-13 31q0 19 13 32t32 13Z" />
              </svg>
              <h3>No Addresses Found</h3>
              <p>You haven't added any addresses yet. Add your first address.</p>
            </div>
            <% } %>
          </div>
        </div>

        <div class="coupon-section">
          <h4 class="section-title">Available Coupons</h4>
          <% if (coupons && coupons.length > 0) { %>
          <div class="coupon-list">
            <% coupons.forEach(coupon => { %>
            <div class="coupon-item" data-coupon-code="<%= coupon.code %>" data-min-price="<%= coupon.minPrice %>" data-max-price="<%= coupon.maxPrice %>" data-offer-price="<%= coupon.offerPrice %>">
              <div class="coupon-details">
                <div class="coupon-code"><%= coupon.code %></div>
                <div class="coupon-description"><%= coupon.description %></div>
              </div>
              <button class="coupon-apply-btn" onclick="applyCoupon('<%= coupon.code %>')">Apply</button>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <p>No coupons available at this time.</p>
          <% } %>
        </div>

        <div class="additional-info-section">
          <h4 class="section-title">Additional Info</h4>
          <label class="additional-info-label">Order Notes (Optional)</label>
          <textarea class="notes-textarea" placeholder="Notes about your order, e.g. special notes for delivery" id="orderNotes"></textarea>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="order-summary">
          <h4 class="section-title">Order Summary</h4>

          <div id="order-items">
            <% if (orderItems && orderItems.length > 0) { %>
            <% orderItems.forEach(item => { %>
            <div class="summary-item">
              <img src="<%= item.image %>" alt="<%= item.name %>" class="item-image">
              <div class="item-details">
                <div class="item-name"><%= item.name %></div>
                <div class="item-quantity">Qty: <%= item.quantity %></div>
                <% if (item.cuttingStyle) { %>
                <div class="item-cutting-style" style=" font-size: small; font-weight: 300;"><%= item.cuttingStyle %></div>
                <% } %>
              </div>
              <div class="item-total"><%= item.total.toFixed(2) %>₹</div>
            </div>
            <% }) %>
            <% } else { %>
            <p>No items in the order.</p>
            <% } %>
          </div>

          <div class="summary-totals">
            <div class="total-row">
              <span>Subtotal:</span>
              <span id="subtotal"><%= subtotal %>₹</span>
            </div>
            <div class="total-row">
              <span>Shipping:</span>
              <span class="shipping-free"><%= shipping %>₹</span>
            </div>
            <div class="total-row final">
              <span>Total:</span>
              <span id="finalTotal"><%= finalTotal %></span>
            </div>
          </div>

          <div class="payment-method-section">
            <h5 class="payment-method-title">Payment Method</h5>
            <div class="payment-methods">
              <div class="payment-option selected" data-payment="cod">
                <input type="radio" name="payment" value="cod" class="payment-radio" checked>
                <span class="payment-icon">💰</span>
                <div><strong>Cash on Delivery</strong></div>
              </div>
              <div class="payment-option" data-payment="upi">
                <input type="radio" name="payment" value="upi" class="payment-radio">
                <span class="payment-icon">💸</span>
                <div><strong>UPI</strong></div>
              </div>
              <div class="payment-option" data-payment="wallet">
                <input type="radio" name="payment" value="wallet" class="payment-radio">
                <span class="payment-icon">💳</span>
                <div><strong>Wallet</strong><br><span class="wallet-balance">Balance: <%= wallet.balance.toFixed(2) %>₹</span></div>
              </div>
            </div>
          </div>

          <button class="place-order-btn" onclick="showOrderConfirmModal(null, 'order')">Place Order</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addressModalLabel">Add Address</h5>
          <button type="button" class="close-btn" id="closePopup" onclick="closeAddressModal()" aria-label="Close">×</button>
        </div>
        <div class="modal-body">
          <form id="addressForm" novalidate>
            <input type="hidden" id="editIndex" name="index">

            <div class="form-group">
              <div class="input-wrapper">
                <label for="modalFirstName">First name</label>
                <input type="text" id="modalFirstName" name="firstName" placeholder="First name">
                <div id="errFirstName" class="errr-msg"></div>
              </div>
              <div class="input-wrapper">
                <label for="modalLastName">Last name</label>
                <input type="text" id="modalLastName" name="lastName" placeholder="Last name">
                <div id="errModalLastName" class="errr-msg"></div>
              </div>
              <div class="input-wrapper">
                <label for="modalCompany">Company name <span class="optional">(optional)</span></label>
                <input type="text" id="modalCompany" name="company" placeholder="Company Name (optional)">
              </div>
            </div>

            <div class="form-group">
              <div class="input-wrapper full-width">
                <label for="modalStreetAddress">Street address</label>
                <input type="text" id="modalStreetAddress" name="streetAddress" placeholder="Street Address">
                <div id="errStreetAddress" class="errr-msg"></div>
              </div>
            </div>

            <div class="form-group">
              <div class="input-wrapper full-width">
                <label for="modalCity">City</label>
                <input type="text" id="modalCity" name="city" placeholder="City">
                <div id="errCity" class="errr-msg"></div>
              </div>
            </div>

            <div class="form-group">
              <div class="input-wrapper">
                <label for="modalCountrySelect">Country</label>
                <select id="modalCountrySelect" name="country">
                  <option value="" disabled selected hidden>Select Country</option>
                </select>
                <div id="errCountry" class="errr-msg"></div>
              </div>
              <div class="input-wrapper">
                <label for="modalStateSelect">State</label>
                <select id="modalStateSelect" name="state">
                  <option value="" disabled selected hidden>Select State</option>
                </select>
                <div id="errState" class="errr-msg"></div>
              </div>
              <div class="input-wrapper">
                <label for="modalLandmark">Landmark</label>
                <input type="text" id="modalLandmark" name="landmark" placeholder="Landmark">
                <div id="errLandmark" class="errr-msg"></div>
              </div>
              <div class="input-wrapper">
                <label for="modalZipcode">Zip Code</label>
                <input type="text" id="modalZipcode" name="zipcode" placeholder="Zip Code">
                <div id="errZipcode" class="errr-msg"></div>
              </div>
            </div>

            <div class="form-group">
              <div class="input-wrapper">
                <label for="modalEmail">Email <span class="optional">(optional)</span></label>
                <input type="email" id="modalEmail" name="email" placeholder="Email (optional)">
              </div>
              <div class="input-wrapper">
                <label for="modalPhone">Phone Number</label>
                <input type="tel" id="modalPhone" name="phone" placeholder="Phone">
                <div id="errPhone" class="errr-msg"></div>
              </div>
              <div class="input-wrapper">
                <label for="modalAltPhone">Alternative Phone <span class="optional">(optional)</span></label>
                <input type="tel" id="modalAltPhone" name="altPhone" placeholder="Alternative Phone (optional)">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <div class="default-checkbox-wrapper">
            <input type="checkbox" id="makeDefaultCheckbox" name="isDefault">
            <label for="makeDefaultCheckbox">Make this address as default</label>
          </div>
          <div class="ms-auto">
            <button type="button" class="btn btn-success" onclick="saveAddress()">ADD</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="order-confirm-modal" class="modal" style="display:none;">
    <div class="modaal-content">
      <h3>Are you sure?</h3>
      <div class="modal-buttons">
        <button id="order-cancel" class="btn-no">NO</button>
        <button id="order-confirm" class="btn-yes">YES</button>
      </div>
    </div>
  </div>

  <div id="order-success-animation" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgb(255, 255, 255); z-index: 1000;"></div>

  <div id="loading-overlay" class="loading-overlay">
    <div class="loading-spinner"></div>
  </div>

  <script>
    const savedAddresses = <%- JSON.stringify(savedAddresses) %>;
    let appliedCoupon = null;
    let currentDeleteIndex = null;
    let currentSubtotal = parseFloat('<%= subtotal %>');
    let currentShipping = parseFloat('<%= shipping %>');
    let currentTotal = parseFloat('<%= finalTotal %>');
    let selectedAddressIndex = null;
    const walletBalance = parseFloat('<%= wallet.balance %>');

    // --- New variables for Buy Now flow ---
    const productId = '<%= (typeof orderItems !== "undefined" && orderItems[0]) ? orderItems[0].productId : "" %>';
    const quantity = '<%= (typeof orderItems !== "undefined" && orderItems[0]) ? orderItems[0].quantity : "" %>';
    const cuttingStyle = '<%= (typeof orderItems !== "undefined" && orderItems[0] && orderItems[0].cuttingStyle) ? orderItems[0].cuttingStyle : "" %>';

    toastr.options = {
      timeOut: 3000,
      preventDuplicates: true
    };

    document.querySelectorAll('.payment-option').forEach(option => {
      option.addEventListener('click', function() {
        if (!this.classList.contains('disabled')) {
          document.querySelectorAll('.payment-option').forEach(opt => opt.classList.remove('selected'));
          this.classList.add('selected');
          this.querySelector('.payment-radio').checked = true;
        }
      });
    });

    function checkWalletBalance() {
      const walletOption = document.querySelector('.payment-option[data-payment="wallet"]');
      const walletRadio = walletOption.querySelector('.payment-radio');
      if (walletBalance >= currentTotal) {
        walletOption.classList.remove('disabled');
        walletOption.style.pointerEvents = 'auto';
        walletRadio.disabled = false;
      } else {
        walletOption.classList.add('disabled');
        walletOption.style.pointerEvents = 'none';
        walletRadio.disabled = true;
        if (walletOption.classList.contains('selected')) {
          document.querySelector('.payment-option[data-payment="cod"]').classList.add('selected');
          document.querySelector('.payment-option[data-payment="cod"] .payment-radio').checked = true;
        }
      }
    }

    function checkCODLimit() {
      const codOption = document.querySelector('.payment-option[data-payment="cod"]');
      const codRadio = codOption.querySelector('.payment-radio');
      if (currentTotal >= 1000) {
        codOption.classList.add('disabled');
        codOption.style.pointerEvents = 'none';
        codRadio.disabled = true;
        if (codOption.classList.contains('selected')) {
          document.querySelector('.payment-option[data-payment="upi"]').classList.add('selected');
          document.querySelector('.payment-option[data-payment="upi"] .payment-radio').checked = true;
        }
      } else {
        codOption.classList.remove('disabled');
        codOption.style.pointerEvents = 'auto';
        codRadio.disabled = false;
      }
    }

    function applyCoupon(couponCode) {
      const couponItem = document.querySelector(`.coupon-item[data-coupon-code="${couponCode}"]`);
      if (!couponItem) return;

      const minPrice = parseFloat(couponItem.dataset.minPrice);
      const maxPrice = parseFloat(couponItem.dataset.maxPrice);
      const offerPrice = parseFloat(couponItem.dataset.offerPrice);

      if (currentSubtotal < minPrice || currentSubtotal > maxPrice) {
        toastr.error(`This coupon is only valid for orders between ${minPrice}₹ and ${maxPrice}₹. Your current subtotal is ${currentSubtotal}₹.`);
        return;
      }

      if (appliedCoupon) removeCoupon(appliedCoupon.code);

      document.querySelectorAll('.coupon-item').forEach(item => {
        item.classList.remove('selected');
        const button = item.querySelector('.coupon-apply-btn');
        button.disabled = false;
        button.textContent = 'Apply';
        button.onclick = () => applyCoupon(item.dataset.couponCode);
      });

      couponItem.classList.add('selected');
      const applyButton = couponItem.querySelector('.coupon-apply-btn');
      applyButton.textContent = 'Remove';
      applyButton.onclick = () => removeCoupon(couponCode);
      appliedCoupon = {
        code: couponCode,
        offerPrice
      };

      currentTotal -= offerPrice;
      if (currentTotal < 0) currentTotal = 0;
      updateTotals();
      addCouponRow(couponCode, offerPrice);
      checkWalletBalance();
      checkCODLimit(); // Check COD limit after applying coupon
      toastr.success(`Coupon ${couponCode} applied successfully! You saved ${offerPrice}₹.`);
    }

    function removeCoupon(couponCode) {
      const couponItem = document.querySelector(`.coupon-item[data-coupon-code="${couponCode}"]`);
      if (!couponItem) return;

      couponItem.classList.remove('selected');
      const removeButton = couponItem.querySelector('.coupon-apply-btn');
      removeButton.textContent = 'Apply';
      removeButton.disabled = false;
      removeButton.onclick = () => applyCoupon(couponCode);

      if (appliedCoupon && appliedCoupon.code === couponCode) {
        currentTotal += appliedCoupon.offerPrice;
        appliedCoupon = null;
        removeCouponRow();
        updateTotals();
        checkWalletBalance();
        checkCODLimit(); // Check COD limit after removing coupon
        toastr.success(`Coupon ${couponCode} removed successfully!`);
      }
    }

    function addCouponRow(couponCode, offerPrice) {
      let couponRow = document.querySelector('.total-row.coupon-row');
      if (!couponRow) {
        couponRow = document.createElement('div');
        couponRow.className = 'total-row coupon-row';
        document.querySelector('.summary-totals').insertBefore(couponRow, document.querySelector('.total-row.final'));
      }
      couponRow.innerHTML = `<span>${couponCode}:</span><span>-${offerPrice}₹</span>`;
    }

    function removeCouponRow() {
      const couponRow = document.querySelector('.total-row.coupon-row');
      if (couponRow) couponRow.remove();
    }

    function updateTotals() {
      document.getElementById('subtotal').textContent = `${currentSubtotal.toFixed(2)}₹`;
      document.getElementById('finalTotal').textContent = `${currentTotal.toFixed(2)}₹`;
      checkWalletBalance();
      checkCODLimit(); // Update COD status whenever totals change
    }

    function openAddressModal(index = null) {
      const modalElement = document.getElementById('addressModal');
      if (!modalElement) return;
      const modal = new bootstrap.Modal(modalElement, {
        backdrop: true,
        keyboard: true
      });
      const modalTitle = document.getElementById('addressModalLabel');
      const makeDefaultCheckbox = document.getElementById('makeDefaultCheckbox');
      const editIndexInput = document.getElementById('editIndex');

      document.querySelectorAll('.errr-msg').forEach(err => {
        err.style.display = 'none';
        err.innerHTML = '';
      });

      if (index !== null) {
        modalTitle.textContent = 'Edit Address';
        editIndexInput.value = index;
        const address = savedAddresses[index];
        populateForm(address);
        makeDefaultCheckbox.checked = address.isDefault || false;
      } else {
        modalTitle.textContent = 'Add Address';
        editIndexInput.value = '';
        clearForm();
        makeDefaultCheckbox.checked = false;
      }
      modal.show();
    }

    function closeAddressModal() {
      const modal = bootstrap.Modal.getInstance(document.getElementById('addressModal'));
      if (modal) modal.hide();
    }

    function editAddress(index) {
      openAddressModal(index);
    }

    function showOrderConfirmModal(index = null, action = 'order') {
      currentDeleteIndex = index;
      const modal = document.getElementById('order-confirm-modal');
      if (modal) {
        modal.style.display = 'flex';
        modal.dataset.action = action;
      }
    }

    function closeOrderConfirmModal() {
      const modal = document.getElementById('order-confirm-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.dataset.action = '';
        currentDeleteIndex = null;
      }
    }

    function deleteAddress() {
      if (!currentDeleteIndex) return;
      fetch(`/account-settings/delete-address/${currentDeleteIndex}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            index: currentDeleteIndex
          })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            toastr.success('Address deleted successfully');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            toastr.error(data.message || 'Failed to delete address');
          }
        })
        .catch(error => {
          toastr.error('An error occurred while deleting the address');
        });
    }

    function initiateRazorpayPayment(orderId, amount, razorpayKey, razorpayOrderId) {
      const urlParams = new URLSearchParams(window.location.search);
      const isRetry = urlParams.get('retry');
      const options = {
        key: razorpayKey,
        amount: amount * 100,
        currency: 'INR',
        name: 'TezBag',
        description: 'Order Payment' + (isRetry ? ' (Retry)' : ''),
        order_id: razorpayOrderId,
        handler: function(response) {
          verifyPayment(response, orderId);
        },
        prefill: {
          name: '<%= userId.f_Name %>',
          email: '<%= userId.email %>',
        },
        notes: {
          orderId: orderId,
          userId: '<%= userId %>'
        },
        theme: {
          color: '#00B207'
        },
        modal: {
          ondismiss: function() {
            fetch(`/cancel-order/${orderId}`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
              })
              .then(res => res.json())
              .catch(err => {});
            const loadingOverlay = document.getElementById('loading-overlay');
            loadingOverlay.style.display = 'none';
            setTimeout(() => {
              window.location.href = '/retry-payment';
            }, 100);
          }
        }
      };

      const rzp = new Razorpay(options);
      rzp.open();
    }

    async function verifyPayment(paymentResponse, orderId) {
      try {
        const res = await fetch('/order/verify-payment', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            paymentResponse,
            orderId
          })
        });
        const data = await res.json();
        if (data.success) {
          toastr.success('Payment Successful! Redirecting...');
          setTimeout(() => window.location.href = `/order-confirmation/${orderId}`, 1000);
        } else {
          fetch(`/cancel-order/${orderId}`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
            })
            .then(res => res.json())
            .catch(err => {});
          toastr.error(data.message || 'Payment verification failed');
        }
      } catch (error) {
        toastr.error('Something went wrong');
      }
    }

    function placeOrder() {
      if (selectedAddressIndex === null) {
        toastr.error('Please select a delivery address.');
        return;
      }
      const paymentMethod = document.querySelector('input[name="payment"]:checked')?.value || '';
      const address = savedAddresses[selectedAddressIndex];

      const orderData = {
        paymentMethod,
        orderNotes: document.getElementById('orderNotes').value || '',
        address: address,
        coupon: appliedCoupon ? appliedCoupon.code : null,
        finalAmount: currentTotal
      };

      // --- New logic to include product details for "Buy Now" orders ---
      if (productId) {
        orderData.productId = productId;
        orderData.quantity = quantity;
        if (cuttingStyle) {
          orderData.cuttingStyle = cuttingStyle;
        }
      }

      const loadingOverlay = document.getElementById('loading-overlay');
      loadingOverlay.style.display = 'flex';

      fetch('/order/place', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(orderData)
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            loadingOverlay.style.display = 'none';
            closeOrderConfirmModal();
            if (paymentMethod === 'upi') {
              initiateRazorpayPayment(data.orderId, currentTotal, data.razorpayKey, data.razorpayOrderId);
            } else {
              const animationContainer = document.getElementById('order-success-animation');
              animationContainer.style.display = 'block';
              lottie.loadAnimation({
                container: animationContainer,
                renderer: 'svg',
                loop: false,
                autoplay: true,
                path: '/Order_success.json'
              });
              setTimeout(() => {
                animationContainer.style.display = 'none';
                window.location.href = `/order-confirmation/${data.orderId}`;
              }, 3700);
            }
          } else {
            if (data.message === 'Product is out-of-stock') {
              toastr.error(data.message);
              setTimeout(() => window.location.href = '/shop', 2000);
            } else {
              toastr.error(data.message || 'Failed to place order.');
            }
            loadingOverlay.style.display = 'none';
          }
        })
        .catch(error => {
          toastr.error('An error occurred while placing the order.');
          loadingOverlay.style.display = 'none';
          closeOrderConfirmModal();
        });
    }

    // Define shop's location
    const shopCoords = {
      latitude: 10.553513235812982,
      longitude: 76.05424695935642
    };

    async function getCoordinates(pincode) {
      try {
        const response = await fetch(`https://maps.googleapis.com/maps/api/geocode/json?address=${pincode}&key=<%= GOOGLE_API_KEY %>`);
        const data = await response.json();
        if (data.status === "OK" && data.results.length > 0) {
          const location = data.results[0].geometry.location;
          return {
            latitude: location.lat,
            longitude: location.lng
          };
        } else {
          return null;
        }
      } catch (error) {
        console.error("Geocoding error:", error);
        return null;
      }
    }

    // Function to calculate distance using Haversine formula
    function calculateDistance(lat1, lon1, lat2, lon2) {
      const R = 6371; // Earth's radius in kilometers
      const dLat = toRadians(lat2 - lat1);
      const dLon = toRadians(lon2 - lon1);
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRadians(lat1)) * Math.cos(toRadians(lat2)) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    function toRadians(degrees) {
      return degrees * (Math.PI / 180);
    }

    // Function to check delivery eligibility
    async function checkDeliveryEligibility(pincode) {
      const customerCoords = await getCoordinates(pincode);
      if (!customerCoords) {
        return {
          eligible: false,
          message: "Unable to determine delivery location"
        };
      }

      const distance = calculateDistance(
        shopCoords.latitude, shopCoords.longitude,
        customerCoords.latitude, customerCoords.longitude
      );

      return distance <= 5 ? {
        eligible: true,
        message: "Delivery available"
      } : {
        eligible: false,
        message: "Delivery not available beyond 5 km"
      };
    }

    // Update selectAddress to check delivery eligibility
    async function selectAddress(index) {
      if (index === null || index < 0 || index >= savedAddresses.length) {
        selectedAddressIndex = null;
        return;
      }
      selectedAddressIndex = index;
      document.querySelectorAll('.address-card').forEach(card => card.classList.remove('selected'));
      const selectedCard = document.querySelector(`.address-card[data-index="${index}"]`);
      if (selectedCard) selectedCard.classList.add('selected');

      // Check delivery eligibility when address is selected
      const address = savedAddresses[index];
      const deliveryCheck = await checkDeliveryEligibility(address.pinCode);
      updateDeliveryStatus(deliveryCheck.eligible, deliveryCheck.message);
    }

    // Function to update delivery status and button
    function updateDeliveryStatus(isEligible, message) {
      const deliveryStatusDiv = document.getElementById('delivery-status');
      const placeOrderBtn = document.querySelector('.place-order-btn');

      if (!isEligible) {
        deliveryStatusDiv.style.display = 'block';
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add('disabled');
      } else {
        deliveryStatusDiv.style.display = 'none';
        placeOrderBtn.disabled = false;
        placeOrderBtn.classList.remove('disabled');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const cancelOrderButton = document.getElementById('order-cancel');
      const confirmOrderButton = document.getElementById('order-confirm');
      if (cancelOrderButton && confirmOrderButton) {
        cancelOrderButton.addEventListener('click', () => closeOrderConfirmModal());
        confirmOrderButton.addEventListener('click', () => {
          const action = document.getElementById('order-confirm-modal').dataset.action;
          if (action === 'delete') deleteAddress();
          else if (action === 'order') placeOrder();
          closeOrderConfirmModal();
        });
      }

      loadCountries();
      const countrySelect = document.getElementById('modalCountrySelect');
      countrySelect.addEventListener('change', () => {
        const selectedCountry = countrySelect.value;
        if (selectedCountry) loadStates(selectedCountry);
        else document.getElementById('modalStateSelect').innerHTML = '<option value="" disabled selected hidden>Select State</option>';
      });

      document.querySelectorAll('.address-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const index = card.getAttribute('data-index');
          selectAddress(index);
          e.preventDefault();
        });
      });

      if (savedAddresses && savedAddresses.length > 0) {
        const defaultAddress = savedAddresses.find(addr => addr.isDefault);
        if (defaultAddress) selectAddress(savedAddresses.indexOf(defaultAddress));
        else selectAddress(0);
      }
      checkWalletBalance();
      checkCODLimit(); // Initial check on page load

      // Retry payment logic
      const urlParams = new URLSearchParams(window.location.search);
      const isRetry = urlParams.get('retry');
      const orderId = urlParams.get('orderId');
      const amount = urlParams.get('amount');
      const razorpayKey = urlParams.get('razorpayKey');
      const razorpayOrderId = urlParams.get('razorpayOrderId');

      if (isRetry && orderId && amount && razorpayKey && razorpayOrderId) {
        initiateRazorpayPayment(orderId, amount, razorpayKey, razorpayOrderId);
      }
    });

    function validateAddressForm() {
      let isValid = true;

      const fields = [{
          id: 'modalFirstName',
          name: 'firstName',
          errId: 'errFirstName',
          label: 'First name'
        },
        {
          id: 'modalLastName',
          name: 'lastName',
          errId: 'errModalLastName',
          label: 'Last name'
        },
        {
          id: 'modalStreetAddress',
          name: 'streetAddress',
          errId: 'errStreetAddress',
          label: 'Street address'
        },
        {
          id: 'modalCity',
          name: 'city',
          errId: 'errCity',
          label: 'City'
        },
        {
          id: 'modalCountrySelect',
          name: 'country',
          errId: 'errCountry',
          label: 'Country'
        },
        {
          id: 'modalStateSelect',
          name: 'state',
          errId: 'errState',
          label: 'State'
        },
        {
          id: 'modalLandmark',
          name: 'landmark',
          errId: 'errLandmark',
          label: 'Landmark'
        },
        {
          id: 'modalZipcode',
          name: 'zipcode',
          errId: 'errZipcode',
          label: 'Zip code'
        },
        {
          id: 'modalPhone',
          name: 'phone',
          errId: 'errPhone',
          label: 'Phone number'
        }
      ];

      const namePattern = /^[A-Za-z ]+$/;
      const phonePattern = /^\+?[1-9]\d{1,14}$/;
      const zipPattern = /^[1-9]\d{0,9}$/;

      fields.forEach(field => {
        const input = document.getElementById(field.id);
        const errDiv = document.getElementById(field.errId);
        const val = input.value.trim();

        errDiv.style.display = 'none';
        errDiv.innerHTML = '';

        if (!val) {
          errDiv.innerHTML = `${field.label} is required`;
          errDiv.style.display = 'block';
          isValid = false;
        } else if ((field.id === 'modalFirstName' || field.id === 'modalLastName') && val.length < 2) {
          errDiv.innerHTML = `Minimum 2 characters required`;
          errDiv.style.display = 'block';
          isValid = false;
        } else if ((field.id === 'modalFirstName' || field.id === 'modalLastName') && !namePattern.test(val)) {
          errDiv.innerHTML = `Only alphabets allowed`;
          errDiv.style.display = 'block';
          isValid = false;
        } else if (field.id === 'modalPhone' && !phonePattern.test(val)) {
          errDiv.innerHTML = `Please enter a valid phone number`;
          errDiv.style.display = 'block';
          isValid = false;
        } else if (field.id === 'modalZipcode' && !zipPattern.test(val)) {
          errDiv.innerHTML = `Zip code must be 1-10 digits and start with 1-9`;
          errDiv.style.display = 'block';
          isValid = false;
        }
      });

      return isValid;
    }

    function saveAddress() {
      if (!validateAddressForm()) return;

      const form = document.getElementById('addressForm');
      const formData = new FormData(form);
      const data = {};
      formData.forEach((value, key) => {
        data[key] = value;
      });
      data.isDefault = document.getElementById('makeDefaultCheckbox').checked;

      const url = document.getElementById('editIndex').value === '' ? '/account-settings/add-address' : '/account-settings/edit-address';
      const successMessage = document.getElementById('editIndex').value === '' ? 'Address added successfully' : 'Address updated successfully';

      fetch(url, {
          method: url === '/account-settings/add-address' ? 'POST' : 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(data),
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            toastr.success(successMessage);
            const modal = bootstrap.Modal.getInstance(document.getElementById('addressModal'));
            modal.hide();
            setTimeout(() => window.location.reload(), 1300);
          } else {
            toastr.error(data.message || 'Failed to save address');
          }
        })
        .catch(error => {
          toastr.error('An error occurred while saving the address');
        });
    }

    function populateForm(data) {
      document.getElementById('modalFirstName').value = data.firstName || '';
      document.getElementById('modalLastName').value = data.lastName || '';
      document.getElementById('modalCompany').value = data.company || '';
      document.getElementById('modalStreetAddress').value = data.streetAddress || '';
      document.getElementById('modalCity').value = data.city || '';
      document.getElementById('modalLandmark').value = data.landmark || '';
      document.getElementById('modalZipcode').value = data.pinCode || '';
      document.getElementById('modalEmail').value = data.email || '';
      document.getElementById('modalPhone').value = data.phone || '';
      document.getElementById('modalAltPhone').value = data.altPhone || '';

      if (data.country) {
        document.getElementById('modalCountrySelect').value = data.country;
        if (data.state) {
          loadStates(data.country).then(() => {
            document.getElementById('modalStateSelect').value = data.state;
          });
        }
      }
    }

    function clearForm() {
      document.getElementById('addressForm').reset();
      document.getElementById('modalStateSelect').innerHTML = '<option value="" disabled selected hidden>Select State</option>';
      document.getElementById('makeDefaultCheckbox').checked = false;
    }

    async function loadCountries() {
      try {
        const response = await fetch('https://countriesnow.space/api/v0.1/countries', {
          method: 'GET',
          headers: {
            'Accept': 'application/json'
          }
        });
        if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
        const data = await response.json();
        const countrySelect = document.getElementById('modalCountrySelect');
        countrySelect.innerHTML = '<option value="" disabled selected hidden>Select Country</option>';
        data.data.forEach(country => {
          const option = document.createElement('option');
          option.value = country.country;
          option.textContent = country.country;
          countrySelect.appendChild(option);
        });
      } catch (error) {
        const countrySelect = document.getElementById('modalCountrySelect');
        countrySelect.innerHTML = '<option value="" disabled selected hidden>Select Country</option><option value="" disabled>No countries available</option>';
        toastr.error('Failed to load countries. Please try again later.');
      }
    }

    async function loadStates(countryName) {
      try {
        const response = await fetch('https://countriesnow.space/api/v0.1/countries/states', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            country: countryName
          })
        });
        if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
        const data = await response.json();
        const stateSelect = document.getElementById('modalStateSelect');
        stateSelect.innerHTML = '<option value="" disabled selected hidden>Select State</option>';
        data.data.states.forEach(state => {
          const option = document.createElement('option');
          option.value = state.name;
          option.textContent = state.name;
          stateSelect.appendChild(option);
        });
      } catch (error) {
        const stateSelect = document.getElementById('modalStateSelect');
        stateSelect.innerHTML = '<option value="" disabled selected hidden>Select State</option><option value="" disabled>No states available</option>';
        toastr.error('Failed to load states. Please try again later.');
      }
    }

    window.onclick = function(event) {
      const orderModal = document.getElementById('order-confirm-modal');
      const addressModal = document.getElementById('addressModal');
      if (event.target === orderModal) closeOrderConfirmModal();
      if (event.target === addressModal) closeAddressModal();
    };
  </script>
</body>

