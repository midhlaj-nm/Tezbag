      document.querySelectorAll('.address-card').forEach(card => card.classList.remove('selected'));
      const selectedCard = document.querySelector(`.address-card[data-index="${index}"]`);
      if (selectedCard) selectedCard.classList.add('selected');

      const deliveryCheck = await checkDeliveryEligibility(selectedAddr.pinCode);
      updateDeliveryStatus(deliveryCheck.eligible, deliveryCheck.message);
    }

