      if (!addressToDelete || !addressToDelete._id) {
        console.error('Delete Address: Address object or _id not found for deletion.');
        toastr.error('Address information missing for deletion.');
        return;
      }

      console.log(`Delete Address: Attempting to delete address with ID: ${addressToDelete._id}`);
      fetch(`/account-settings/delete-address/${addressToDelete._id}`, { // Use _id in URL
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        })
        .then(response => {
          if (!response.ok) {
            // Handle HTTP errors
            return response.json().then(err => {
              throw new Error(err.message || 'Server error');
            });
          }
          return response.json();
        })
        .then(data => {
