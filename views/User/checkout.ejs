    function initiateRazorpayPayment(orderId, amount, razorpayKey, razorpayOrderId) {
      console.log(`Initiate Razorpay: Order ID: ${orderId}, Amount: ${amount}, RZ Key: ${razorpayKey}, RZ Order ID: ${razorpayOrderId}`);

      const urlParams = new URLSearchParams(window.location.search);
      const isRetryPayment = urlParams.get('retry'); // Use a different var name to avoid confusion with `retryOrderId`

      const options = {
        key: razorpayKey,
        amount: amount * 100, // Amount in paise
        currency: 'INR',
        name: 'TezBag',
        description: 'Order Payment' + (isRetryPayment ? ' (Retry)' : ''),
        order_id: razorpayOrderId,
        handler: function(response) {
          console.log('Razorpay Handler: Payment successful, verifying payment.');
          verifyPayment(response, orderId);
        },
        prefill: {
          name: '<%= userId.f_Name %>',
          email: '<%= userId.email %>',
        },
        notes: {
          orderId: orderId,
          userId: '<%= userId._id %>' // Use userId._id to match server expectations
        },
        theme: {
          color: '#00B207'
        },
        modal: {
          ondismiss: function() {
            console.log('Razorpay Modal: Payment dismissed by user.');
            // Only cancel the order if it's a new order (not a retry)
            // If it's a retry, the backend already has the order as 'Payment Failed'
            if (!isRetryPayment) {
              console.log(`Razorpay Modal: Cancelling order ${orderId} due to dismissal (new order).`);
              fetch(`/cancel-order/${orderId}`, {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json'
                  },
                })
                .then(res => res.json())
                .catch(err => {
                  console.error('Razorpay Modal: Error cancelling order on dismiss:', err);
                });
            } else {
              console.log(`Razorpay Modal: Not cancelling order ${orderId} on dismiss (it's a retry).`);
            }

            const loadingOverlay = document.getElementById('loading-overlay');
            loadingOverlay.style.display = 'none';
            // Redirect to payment failed/retry page after dismissal
            setTimeout(() => {
              window.location.href = '/retry-payment';
            }, 100);
          }
        }
      };

      const rzp = new Razorpay(options);
      rzp.open();
    }

    async function verifyPayment(paymentResponse, orderId) {
      console.log(`Verify Payment: Attempting to verify payment for order ID: ${orderId}`);
      try {
        const res = await fetch('/order/verify-payment', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            paymentResponse,
            orderId
          })
        });
        const data = await res.json();
        if (data.success) {
          toastr.success('Payment Successful! Redirecting...');
          console.log(`Verify Payment: Payment verification successful for order ${orderId}. Redirecting.`);
          setTimeout(() => window.location.href = `/order-confirmation/${orderId}`, 1000);
        } else {
          console.error(`Verify Payment: Payment verification failed for order ${orderId}: ${data.message || 'Unknown error'}`);
          // If verification fails, ensure the order is marked as failed on backend
          fetch(`/cancel-order/${orderId}`, { // Using cancel-order to mark it as failed
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
            })
            .then(res => res.json())
            .catch(err => {
              console.error('Verify Payment: Error cancelling/failing order after verification failure:', err);
            });
          toastr.error(data.message || 'Payment verification failed');
          // Always redirect to retry page on verification failure
          setTimeout(() => {
            window.location.href = '/retry-payment';
          }, 100);
        }
      } catch (error) {
        console.error('Verify Payment: An error occurred during payment verification:', error);
        toastr.error('Something went wrong during payment verification.');
      }
    }

    function placeOrder() {
      if (selectedAddressId === null) { // Check for selectedAddressId
        toastr.error('Please select a delivery address.');
        console.log('Place Order: No address selected.');
        return;
      }

      const paymentMethod = document.querySelector('input[name="payment"]:checked')?.value || '';
      if (!paymentMethod) {
        toastr.error('Please select a payment method.');
        console.log('Place Order: No payment method selected.');
        return;
      }

      const orderData = {
        paymentMethod,
        orderNotes: document.getElementById('orderNotes').value || '',
        addressId: selectedAddressId, // Send only the _id of the address
        coupon: appliedCoupon ? appliedCoupon.code : null,
        finalAmount: currentTotal
      };

      // Include retryOrderId if present (for payment retries of existing orders)
      if (retryOrderId) {
        orderData.retryOrderId = retryOrderId;
        console.log(`Place Order: Including retryOrderId: ${retryOrderId} in order data.`);
      }

      // Include product details for "Buy Now" orders
      if (productId) {
        orderData.productId = productId;
        orderData.quantity = quantity;
        if (cuttingStyle) {
          orderData.cuttingStyle = cuttingStyle;
        }
        console.log('Place Order: Including Buy Now product details.');
      }

      const loadingOverlay = document.getElementById('loading-overlay');
      loadingOverlay.style.display = 'flex';
      console.log('Place Order: Sending order data:', orderData);

      fetch('/order/place', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(orderData)
        })
        .then(response => {
          loadingOverlay.style.display = 'none';
          if (!response.ok) {
            // If the response is not ok, parse the error message from the backend
            return response.json().then(err => {
              throw new Error(err.message || 'Server error');
            });
          }
          return response.json();
        })
        .then(data => {
          closeOrderConfirmModal();
          if (data.success) {
            console.log(`Place Order: Order placement successful. Order ID: ${data.orderId}, Payment Method: ${paymentMethod}`);
            if (paymentMethod === 'upi') {
              initiateRazorpayPayment(data.orderId, currentTotal, data.razorpayKey, data.razorpayOrderId);
            } else {
              const animationContainer = document.getElementById('order-success-animation');
              animationContainer.style.display = 'block';
              lottie.loadAnimation({
                container: animationContainer,
                renderer: 'svg',
                loop: false,
                autoplay: true,
                path: '/Order_success.json'
              });
              console.log('Place Order: Showing success animation for non-UPI payment.');
              setTimeout(() => {
                animationContainer.style.display = 'none';
                window.location.href = `/order-confirmation/${data.orderId}`;
              }, 3700);
            }
          } else {
            console.error('Place Order: Failed to place order:', data.message);
            if (data.message === 'Some products are out of stock') {
              toastr.error(data.message);
              setTimeout(() => window.location.href = '/shop', 2000); // Redirect to shop if out of stock
            } else if (data.redirect) {
              toastr.error(data.message || 'Failed to place order. Redirecting...');
              setTimeout(() => window.location.href = data.redirect, data.delay || 1000); // Use redirect from server
            } else {
              toastr.error(data.message || 'Failed to place order.');
            }
          }
        })
        .catch(error => {
          console.error('Place Order: An error occurred while placing the order:', error);
          toastr.error(error.message || 'An unexpected error occurred. Please try again.');
          loadingOverlay.style.display = 'none';
          closeOrderConfirmModal();
        });
    }

