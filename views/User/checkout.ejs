    function validateAddressForm() {
      let isValid = true;
      console.log('Validate Address Form: Starting validation.');

      const fields = [{
          id: 'modalFirstName',
          name: 'firstName',
          errId: 'errFirstName',
          label: 'First name'
        },
        {
          id: 'modalLastName',
          name: 'lastName',
          errId: 'errModalLastName',
          label: 'Last name'
        },
        {
          id: 'modalStreetAddress',
          name: 'streetAddress',
          errId: 'errStreetAddress',
          label: 'Street address'
        },
        {
          id: 'modalCity',
          name: 'city',
          errId: 'errCity',
          label: 'City'
        },
        {
          id: 'modalCountrySelect',
          name: 'country',
          errId: 'errCountry',
          label: 'Country'
        },
        {
          id: 'modalStateSelect',
          name: 'state',
          errId: 'errState',
          label: 'State'
        },
        {
          id: 'modalLandmark',
          name: 'landmark',
          errId: 'errLandmark',
          label: 'Landmark'
        },
        {
          id: 'modalZipcode',
          name: 'pinCode', // Changed to pinCode to match backend
          errId: 'errZipcode',
          label: 'Zip code'
        },
        {
          id: 'modalPhone',
          name: 'phone',
          errId: 'errPhone',
          label: 'Phone number'
        }
      ];

      const namePattern = /^[A-Za-z ]+$/;
      const phonePattern = /^\+?[1-9]\d{1,14}$/;
      const zipPattern = /^[1-9]\d{5}$/; // Standard 6-digit Indian PIN code, starting 1-9

      fields.forEach(field => {
        const input = document.getElementById(field.id);
        const errDiv = document.getElementById(field.errId);
        const val = input ? input.value.trim() : '';

        if (errDiv) { // Ensure errDiv exists
          errDiv.style.display = 'none';
          errDiv.innerHTML = '';
        }

        if (!val) {
          if (errDiv) {
            errDiv.innerHTML = `${field.label} is required`;
            errDiv.style.display = 'block';
          }
          isValid = false;
          console.log(`Validate Address Form: ${field.label} is empty.`);
        } else if ((field.id === 'modalFirstName' || field.id === 'modalLastName') && val.length < 2) {
          if (errDiv) {
            errDiv.innerHTML = `Minimum 2 characters required`;
            errDiv.style.display = 'block';
          }
          isValid = false;
          console.log(`Validate Address Form: ${field.label} too short.`);
        } else if ((field.id === 'modalFirstName' || field.id === 'modalLastName') && !namePattern.test(val)) {
          if (errDiv) {
            errDiv.innerHTML = `Only alphabets allowed`;
            errDiv.style.display = 'block';
          }
          isValid = false;
          console.log(`Validate Address Form: ${field.label} contains invalid characters.`);
        } else if (field.id === 'modalPhone' && !phonePattern.test(val)) {
          if (errDiv) {
            errDiv.innerHTML = `Please enter a valid phone number (e.g., +919876543210 or 9876543210)`;
            errDiv.style.display = 'block';
          }
          isValid = false;
          console.log(`Validate Address Form: Invalid phone number format.`);
        } else if (field.id === 'modalZipcode' && !zipPattern.test(val)) {
          if (errDiv) {
            errDiv.innerHTML = `Zip code must be 6 digits and start with 1-9`;
            errDiv.style.display = 'block';
          }
          isValid = false;
          console.log(`Validate Address Form: Invalid zip code format.`);
        }
      });

      console.log(`Validate Address Form: Validation result: ${isValid}`);
      return isValid;
    }

    function saveAddress() {
      if (!validateAddressForm()) {
        console.log('Save Address: Address form validation failed.');
        return;
      }

      const form = document.getElementById('addressForm');
      const formData = new FormData(form);
      const data = {};
      formData.forEach((value, key) => {
        data[key] = value;
      });
      data.isDefault = document.getElementById('makeDefaultCheckbox').checked;
      data.pinCode = data.zipcode; // Ensure pinCode is sent
      delete data.zipcode; // Remove if not needed by backend

      const editAddressId = document.getElementById('editAddressId').value;
      const url = editAddressId === '' ? '/account-settings/add-address' : `/account-settings/edit-address/${editAddressId}`; // Use _id for edit
      const method = editAddressId === '' ? 'POST' : 'PATCH';
      const successMessage = editAddressId === '' ? 'Address added successfully' : 'Address updated successfully';

      console.log(`Save Address: Sending data to ${url} with method ${method}. Data:`, data);

      fetch(url, {
          method: method,
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(data),
        })
        .then(response => {
          if (!response.ok) {
            return response.json().then(err => {
              throw new Error(err.message || 'Server error');
            });
          }
          return response.json();
        })
        .then(data => {
          if (data.success) {
            toastr.success(successMessage);
            const modal = bootstrap.Modal.getInstance(document.getElementById('addressModal'));
            if (modal) modal.hide();
            console.log(`Save Address: ${successMessage}. Reloading page.`);
            setTimeout(() => window.location.reload(), 1300);
          } else {
            toastr.error(data.message || 'Failed to save address');
            console.error('Save Address: Server reported failure:', data.message);
          }
        })
        .catch(error => {
          toastr.error('An error occurred while saving the address');
          console.error('Save Address: Fetch error:', error);
        });
    }

    function populateForm(data) {
      console.log('Populate Form: Populating address form with data:', data);
      document.getElementById('modalFirstName').value = data.firstName || '';
      document.getElementById('modalLastName').value = data.lastName || '';
      document.getElementById('modalCompany').value = data.company || '';
      document.getElementById('modalStreetAddress').value = data.streetAddress || '';
      document.getElementById('modalCity').value = data.city || '';
      document.getElementById('modalLandmark').value = data.landmark || '';
      document.getElementById('modalZipcode').value = data.pinCode || ''; // Use pinCode here
      document.getElementById('modalEmail').value = data.email || '';
      document.getElementById('modalPhone').value = data.phone || '';
      document.getElementById('modalAltPhone').value = data.altPhone || '';

      if (data.country) {
        document.getElementById('modalCountrySelect').value = data.country;
        if (data.state) {
          loadStates(data.country).then(() => {
            document.getElementById('modalStateSelect').value = data.state;
            console.log(`Populate Form: Set country: ${data.country}, state: ${data.state}`);
          }).catch(err => console.error('Populate Form: Error loading states after country selection:', err));
        } else {
          // If country is set but state is not, just load states for the country
          loadStates(data.country).catch(err => console.error('Populate Form: Error loading states for country:', err));
        }
      }
    }

    function clearForm() {
      console.log('Clear Form: Resetting address form.');
      document.getElementById('addressForm').reset();
      document.getElementById('modalStateSelect').innerHTML = '<option value="" disabled selected hidden>Select State</option>';
      document.getElementById('makeDefaultCheckbox').checked = false;
    }

    async function loadCountries() {
      console.log('Load Countries: Fetching countries from API.');
      try {
        const response = await fetch('https://countriesnow.space/api/v0.1/countries', {
          method: 'GET',
          headers: {
            'Accept': 'application/json'
          }
        });
        if (!response.ok) {
          const errorText = await response.text();
          throw new Error(`HTTP error! Status: ${response.status}, Body: ${errorText}`);
        }
        const data = await response.json();
        const countrySelect = document.getElementById('modalCountrySelect');
        if (countrySelect) {
          countrySelect.innerHTML = '<option value="" disabled selected hidden>Select Country</option>';
          data.data.forEach(country => {
            const option = document.createElement('option');
            option.value = country.country;
            option.textContent = country.country;
            countrySelect.appendChild(option);
          });
          console.log('Load Countries: Countries loaded successfully.');
        } else {
          console.error('Load Countries: modalCountrySelect element not found.');
        }
      } catch (error) {
        const countrySelect = document.getElementById('modalCountrySelect');
        if (countrySelect) {
          countrySelect.innerHTML = '<option value="" disabled selected hidden>Select Country</option><option value="" disabled>No countries available</option>';
        }
        toastr.error('Failed to load countries. Please try again later.');
        console.error('Load Countries: Error fetching countries:', error);
      }
    }

    async function loadStates(countryName) {
      console.log(`Load States: Fetching states for country: ${countryName} from API.`);
      try {
        const response = await fetch('https://countriesnow.space/api/v0.1/countries/states', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            country: countryName
          })
        });
        if (!response.ok) {
          const errorText = await response.text();
          throw new Error(`HTTP error! Status: ${response.status}, Body: ${errorText}`);
        }
        const data = await response.json();
        const stateSelect = document.getElementById('modalStateSelect');
        if (stateSelect) {
          stateSelect.innerHTML = '<option value="" disabled selected hidden>Select State</option>';
          if (data.data && data.data.states && data.data.states.length > 0) {
            data.data.states.forEach(state => {
              const option = document.createElement('option');
              option.value = state.name;
              option.textContent = state.name;
              stateSelect.appendChild(option);
            });
            console.log(`Load States: States loaded successfully for ${countryName}.`);
          } else {
            console.log(`Load States: No states found for ${countryName}.`);
            stateSelect.innerHTML = '<option value="" disabled selected hidden>Select State</option><option value="" disabled>No states available</option>';
          }
        } else {
          console.error('Load States: modalStateSelect element not found.');
        }
      } catch (error) {
        const stateSelect = document.getElementById('modalStateSelect');
        if (stateSelect) {
          stateSelect.innerHTML = '<option value="" disabled selected hidden>Select State</option><option value="" disabled>No states available</option>';
        }
        toastr.error('Failed to load states. Please try again later.');
        console.error('Load States: Error fetching states:', error);
      }
    }

    window.onclick = function(event) {
      const orderModal = document.getElementById('order-confirm-modal');
      const addressModal = document.getElementById('addressModal');
      if (event.target === orderModal) {
        closeOrderConfirmModal();
        console.log('Window Click: Closed order confirm modal.');
      }
      if (event.target === addressModal) {
        closeAddressModal();
        console.log('Window Click: Closed address modal.');
      }
    };
  </script>
</body>

