<%- include("../../views/Partials/user/header-ho") %>
<hr style="margin: 0rem 0rem 1rem 0rem; background-color: #535353;">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checkout - TezBag</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    
    body {
        font-family: 'Poppins', sans-serif;
        color: #333;
    }

    /* Breadcrumb */
    .breadcrumb {
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        padding: 1rem 5%;
        margin: 0;
        background: none;
    }
    .breadcrumb-item {
        font-size: 14px;
        color: #6c757d;
        display: flex;
        align-items: center;
    }
    .breadcrumb-item + .breadcrumb-item::before {
        content: "/";
        color: #adb5bd;
        margin: 0 8px;
    }
    .breadcrumb-item a {
        color: #2f2f2f;
        font-weight: 500;
    }
    .breadcrumb-item a:hover {
        text-decoration: underline;
    }
    .breadcrumb-item.active {
        color: #575757;
        font-weight: 500;
    }
    
    /* Main Container Styling */
    .checkout-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .checkout-title {
        text-align: center;
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 2rem;
        color: #333;
    }
    
    /* Box styling similar to cart */
    .delivery-section, .order-summary, .coupon-section, .additional-info-section {
        border: 1px solid #Ccc;
        background: white;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 2rem;
    }
    
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }
    
    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin: 0 0 10px 0;
    }
    
    .change-btn {
        background: #00B207;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
    }
    
    .change-btn:hover {
        background: #009006;
    }
    
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-control {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 1rem;
        font-size: 1rem;
        font-family: 'Poppins', sans-serif;
    }
    
    .form-control:focus {
        border-color: #00B207;
        box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
    }
    
    .form-control::placeholder {
        color: #999;
    }
    
    .form-select {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 1rem;
        font-size: 1rem;
        background-color: white;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
    }
    
    .form-select:focus {
        border-color: #00B207;
        box-shadow: 0 0 0 0 rgba(0, 178, 7, 0.25);
    }

    /* Coupon Section Styles */
    .coupon-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .coupon-item {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s;
    }

    .coupon-item:hover {
        border-color: #00B207;
        background-color: #f8fff8;
    }

    .coupon-item.selected {
        border-color: #00B207;
        background-color: #f0fff0;
    }

    .coupon-details {
        flex: 1;
    }

    .coupon-code {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.3rem;
    }

    .coupon-description {
        color: #666;
        font-size: 0.9rem;
    }

    .coupon-apply-btn {
        background: #00B207;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
    }

    .coupon-apply-btn:hover {
        background: #009006;
    }

    .coupon-apply-btn:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    /* Additional Info Section */
    .additional-info-label {
        font-size: 1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.8rem;
        display: block;
    }

    .notes-textarea {
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 1rem;
        font-size: 1rem;
        font-family: 'Poppins', sans-serif;
        resize: vertical;
        min-height: 100px;
    }

    .notes-textarea:focus {
        border-color: #00B207;
        box-shadow: 0 0 0 0 rgba(0, 178, 7, 0.25);
        outline: none;
    }

    .notes-textarea::placeholder {
        color: #999;
    }
    
    .payment-methods {
        display: grid;
        gap: 0.8rem;
        margin-top: 1rem;
    }
    
    .payment-option {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 0.8rem;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    
    .payment-option:hover {
        border-color: #00B207;
        background-color: #f8fff8;
    }
    
    .payment-option.selected {
        border-color: #00B207;
        background-color: #f0fff0;
    }
    
    .payment-radio {
        margin-right: 0.3rem;
    }
    
    .payment-icon {
        font-size: 1.2rem;
    }
    
    .order-summary {
        height: fit-content;
        position: sticky;
        top: 2rem;
    }
    
    .summary-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #eee;
    }
    
    .summary-item:last-child {
        border-bottom: none;
    }
    
    .item-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
    }
    
    .item-details {
        flex: 1;
    }
    
    .item-name {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.3rem;
    }
    
    .item-quantity {
        color: #999;
        font-size: 0.85rem;
    }
    
    .item-total {
        font-weight: 600;
        color: #00B207;
    }
    
    .summary-totals {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 2px solid #eee;
    }
    
    .total-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.8rem;
    }
    
    .total-row.final {
        font-weight: 700;
        font-size: 1.1rem;
        color: #333;
        border-top: 1px solid #eee;
        padding-top: 0.8rem;
        margin-top: 1rem;
    }
    
    .shipping-free {
        color: #00B207;
        font-weight: 600;
    }
    
    /* Payment Method in Order Summary */
    .payment-method-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 2px solid #eee;
    }
    
    .payment-method-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1rem;
    }
    
    .place-order-btn {
        width: 100%;
        background: #00B207;
        color: white;
        border: none;
        padding: 1rem;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        margin-top: 1.5rem;
        transition: all 0.3s;
        font-family: 'Poppins', sans-serif;
    }
    
    .place-order-btn:hover {
        background: #009006;
        transform: translateY(-2px);
    }
    
    .place-order-btn:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }
    
    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }
    
    .modal-content {
        background-color: white;
        margin: 3% auto;
        border-radius: 12px;
        width: 90%;
        max-width: 600px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        border: 1px solid #Ccc;
    }

    /* Address Selection and Add Address Modal Specific Styles */
    #address-modal .modal-content,
    #add-address-modal .modal-content {
        height: 90vh;
    }

    /* Modal Header */
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        border-bottom: 1px solid #ccc;
        background-color: #fff;
        flex-shrink: 0;
    }
    
    #address-modal .modal-header,
    #add-address-modal .modal-header {
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .modal-header h3 {
        margin: 0;
        color: #333;
    }
    
    .close-btn {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #666;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .close-btn:hover {
        color: #333;
    }

    /* Modal Body */
    .modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
    }
    
    .saved-address {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        cursor: pointer;
        position: relative;
    }
    
    .saved-address:hover {
        border-color: #00B207;
        background-color: #f8fff8;
    }
    
    .saved-address.selected {
        border-color: "00B207";
        background-color: #f0fff0;
    }
    
    .address-header {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }
    
    .address-details {
        color: #666;
        line-height: 1.4;
    }
    
    .deliver-btn {
        position: absolute;
        top: 50%;
        right: 1.5rem;
        transform: translateY(-50%);
        background: #00B207;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: background 0.3s;
        font-family: 'Poppins', sans-serif;
    }
    
    .deliver-btn:hover {
        background: #009006;
    }

    /* Modal Footer */
    .modal-footer {
        padding: 1rem 2rem;
        border-top: 1px solid #ccc;
        background-color: #fff;
        flex-shrink: 0;
    }

    #address-modal .modal-footer,
    #add-address-modal .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 1;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }
    
    .add-address-btn {
        border: 1px solid #00B207;
        background: #00B207;
        color: #ffffff;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: 'Poppins', sans-serif;
    }
    
    .add-address-btn:hover {
        background: #f0fff0;
    }
    
    .modal-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }
    
    .btn-no, .btn-yes {
        padding: 0.8rem 2rem;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        font-family: 'Poppins', sans-serif;
    }
    
    .btn-no {
        background: #6c757d;
        color: white;
    }
    
    .btn-no:hover {
        background: #5a6268;
    }
    
    .btn-yes {
        background: #00B207;
        color: white;
    }
    
    .btn-yes:hover {
        background: #009006;
    }
    
    @media (max-width: 768px) {
        .header .container {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .nav-links {
            gap: 1rem;
        }
        
        .checkout-container {
            padding: 10px;
        }
        
        .checkout-title {
            font-size: 1.5rem;
        }
        
        .delivery-section,
        .order-summary,
        .coupon-section,
        .additional-info-section {
            margin-bottom: 1rem;
            padding: 20px;
        }
        
        .section-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
        
        .saved-address {
            padding: 1rem;
        }
        
        .deliver-btn {
            position: static;
            transform: none;
            margin-top: 1rem;
            width: 100%;
        }
        
        .order-summary {
            position: static;
        }
        
        .modal-content {
            margin: 10% auto;
            width: 95%;
        }

        #address-modal .modal-content,
        #add-address-modal .modal-content {
            height: 90vh;
        }

        .coupon-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .coupon-apply-btn {
            width: 100%;
        }
    }
</style>
</head>
<body>
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <% breadcrumbs.forEach((crumb, index) => { %>
                <li class="breadcrumb-item <%= index === breadcrumbs.length - 1 ? 'active' : '' %>">
                    <% if (index !== breadcrumbs.length - 1) { %>
                        <a href="<%= crumb.url %>"><%= crumb.name %></a>
                    <% } else { %>
                        <%= crumb.name %>
                    <% } %>
                </li>
            <% }) %>
        </ol>
    </nav>

    <!-- Main Content -->
    <div class="checkout-container">
        <h1 class="checkout-title">Checkout</h1>
        
        <div class="row">
            <!-- Left Column - Delivery Info -->
            <div class="col-lg-8">
                <!-- Delivery Information -->
                <div class="delivery-section">
                    <div class="section-header">
                        <h4 class="section-title">Delivery Info<br><span style="font-weight: 400; font-size: large; opacity: 0.9;">Confirm Address before placing order</span></h4>
                        <button class="change-btn" onclick="showAddressModal()">Change</button>
                    </div>
                    
                    <form id="addressForm" novalidate>
                        <!-- Hidden field for index when editing -->
                        <input type="hidden" id="editIndex" name="index">

                        <!-- Row 1: First Name, Last Name -->
                        <div class="form-group row">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalFirstName">First name</label>
                                <input type="text" class="form-control" id="modalFirstName" name="firstName" placeholder="First name" required>
                                <div id="errFirstName" class="errr-msg"></div>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalLastName">Last name</label>
                                <input type="text" class="form-control" id="modalLastName" name="lastName" placeholder="Last name" required>
                                <div id="errLastName" class="errr-msg"></div>
                            </div>
                        </div>

                        <!-- Row 2: Company Name -->
                        <div class="form-group row">
                            <div class="col-12 mb-3">
                                <label for="modalCompany">Company name <span class="optional">(optional)</span></label>
                                <input type="text" class="form-control" id="modalCompany" name="company" placeholder="Company Name (optional)">
                            </div>
                        </div>

                        <!-- Row 3: Street Address -->
                        <div class="form-group row">
                            <div class="col-12 mb-3">
                                <label for="modalStreetAddress">Street address</label>
                                <input type="text" class="form-control" id="modalStreetAddress" name="streetAddress" placeholder="Street Address" required>
                                <div id="errStreetAddress" class="errr-msg"></div>
                            </div>
                        </div>

                        <!-- Row 4: City -->
                        <div class="form-group row">
                            <div class="col-12 mb-3">
                                <label for="modalCity">City</label>
                                <input type="text" class="form-control" id="modalCity" name="city" placeholder="City" required>
                                <div id="errCity" class="errr-msg"></div>
                            </div>
                        </div>

                        <!-- Row 5: Country, State -->
                        <div class="form-group row">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalCountrySelect">Country</label>
                                <select class="form-select" id="modalCountrySelect" name="country" required>
                                    <option value="" disabled selected hidden>Select Country</option>
                                    <option value="India">India</option>
                                    <option value="USA">USA</option>
                                    <option value="UK">UK</option>
                                </select>
                                <div id="errCountry" class="errr-msg"></div>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalStateSelect">State</label>
                                <select class="form-select" id="modalStateSelect" name="state" required>
                                    <option value="" disabled selected hidden>Select State</option>
                                </select>
                                <div id="errState" class="errr-msg"></div>
                            </div>
                        </div>

                        <!-- Row 6: Landmark, Zipcode -->
                        <div class="form-group row">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalLandmark">Landmark</label>
                                <input type="text" class="form-control" id="modalLandmark" name="landmark" placeholder="Landmark" required>
                                <div id="errLandmark" class="errr-msg"></div>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalZipcode">Zip Code</label>
                                <input type="text" class="form-control" id="modalZipcode" name="zipcode" placeholder="Zip Code" required>
                                <div id="errZipcode" class="errr-msg"></div>
                            </div>
                        </div>

                        <!-- Row 7: Email -->
                        <div class="form-group row">
                            <div class="col-12 mb-3">
                                <label for="modalEmail">Email <span class="optional">(optional)</span></label>
                                <input type="email" class="form-control" id="modalEmail" name="email" placeholder="Email (optional)">
                            </div>
                        </div>

                        <!-- Row 8: Phone, Alt Phone -->
                        <div class="form-group row">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalPhone">Phone Number</label>
                                <input type="tel" class="form-control" id="modalPhone" name="phone" placeholder="Phone" required>
                                <div id="errPhone" class="errr-msg"></div>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label for="modalAltPhone">Alternative Phone <span class="optional">(optional)</span></label>
                                <input type="tel" class="form-control" id="modalAltPhone" name="altPhone" placeholder="Alternative Phone (optional)">
                            </div>
                        </div>

                        <!-- Row 9: Default Address Checkbox -->
                        <div class="form-group row">
                            <div class="col-12">
                                <div class="default-checkbox-wrapper">
                                    <input type="checkbox" id="makeDefaultCheckbox" name="isDefault">
                                    <label for="makeDefaultCheckbox">Make this address as default</label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Coupon Section (Dynamic) -->
                <div class="coupon-section">
                    <h4 class="section-title">Available Coupons</h4>
                    <% if (coupons && coupons.length > 0) { %>
                        <div class="coupon-list">
                            <% coupons.forEach(coupon => { %>
                                <div class="coupon-item" data-coupon-code="<%= coupon.code %>" 
                                    data-min-price="<%= coupon.minPrice %>" 
                                    data-max-price="<%= coupon.maxPrice %>" 
                                    data-offer-price="<%= coupon.offerPrice %>">
                                    <div class="coupon-details">
                                        <div class="coupon-code"><%= coupon.code %></div>
                                        <div class="coupon-description"><%= coupon.description %></div>
                                    </div>
                                    <button class="coupon-apply-btn" onclick="applyCoupon('<%= coupon.code %>')">Apply</button>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p>No coupons available at this time.</p>
                    <% } %>
                </div>

                <!-- Additional Info Section -->
                <div class="additional-info-section">
                    <h4 class="section-title">Additional Info</h4>
                    <label class="additional-info-label">Order Notes (Optional)</label>
                    <textarea class="notes-textarea" placeholder="Notes about your order, e.g. special notes for delivery" id="orderNotes"></textarea>
                </div>
            </div>
            
            <!-- Right Column - Order Summary -->
            <div class="col-lg-4">
                <div class="order-summary">
                    <h4 class="section-title">Order Summary</h4>
                    
                    <div id="order-items">
                        <% if (orderItems && orderItems.length > 0) { %>
                            <% orderItems.forEach(item => { %>
                                <div class="summary-item">
                                    <img src="<%= item.image %>" alt="<%= item.name %>" class="item-image">
                                    <div class="item-details">
                                        <div class="item-name"><%= item.name %></div>
                                        <div class="item-quantity">Qty: <%= item.quantity %></div>
                                        <% if (item.cuttingStyle) { %>
                                            <div class="item-cutting-style">Cutting Style: <%= item.cuttingStyle %></div>
                                        <% } %>
                                    </div>
                                    <div class="item-total">$<%= item.total.toFixed(2) %></div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p>No items in the order.</p>
                        <% } %>
                    </div>
                    
                    <div class="summary-totals">
                        <div class="total-row">
                            <span>Subtotal:</span>
                            <span id="subtotal">$<%= subtotal %></span>
                        </div>
                        <div class="total-row">
                            <span>Shipping:</span>
                            <span class="shipping-free">$<%= shipping %></span>
                        </div>
                        <div class="total-row final">
                            <span>Total:</span>
                            <span id="finalTotal">$<%= finalTotal %></span>
                        </div>
                    </div>
                    
                    <!-- Payment Method Section in Order Summary -->
                    <div class="payment-method-section">
                        <h5 class="payment-method-title">Payment Method</h5>
                        
                        <div class="payment-methods">
                            <div class="payment-option selected" data-payment="cod">
                                <input type="radio" name="payment" value="cod" class="payment-radio" checked>
                                <span class="payment-icon">💰</span>
                                <div>
                                    <strong>Cash on Delivery</strong>
                                </div>
                            </div>
                            
                            <div class="payment-option" data-payment="paypal">
                                <input type="radio" name="payment" value="paypal" class="payment-radio">
                                <span class="payment-icon">💳</span>
                                <div>
                                    <strong>Paypal</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <button class="place-order-btn" onclick="showOrderConfirmation()">
                        Place Order
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Address Selection Modal -->
    <div id="address-modal" class="modal">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h3>Choose from Saved Addresses</h3>
                <button class="close-btn" onclick="closeAddressModal()">×</button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <% if (savedAddresses && savedAddresses.length > 0) { %>
                    <% savedAddresses.forEach((address, index) => { %>
                        <div class="saved-address" data-address-id="<%= index %>">
                            <div class="address-header"><%= address.firstName %> <%= address.lastName %></div>
                            <div class="address-details">
                                <%= address.streetAddress %>,<br>
                                <%= address.city %>, <%= address.state %> <%= address.pinCode %>
                            </div>
                            <button class="deliver-btn" onclick="selectAddress('<%= index %>')">Use this</button>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>No saved addresses found.</p>
                <% } %>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button class="add-address-btn" onclick="showAddAddressModal()">
                    <span class="material-symbols-outlined">add</span>
                    Add Address
                </button>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmation-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Confirm Your Order</h3>
            </div>
            <div class="modal-body">
                <p style="text-align: center; margin-bottom: 2rem;">Are you sure you want to place this order?</p>
                <div class="modal-buttons">
                    <button class="btn-no" onclick="closeModal()">Cancel</button>
                    <button class="btn-yes" onclick="placeOrder()">Confirm Order</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Address Modal -->
    <div id="add-address-modal" class="modal">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h3>Add New Address</h3>
                <button class="close-btn" onclick="closeAddAddressModal()">×</button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <form id="add-address-form" novalidate>
                    <!-- Hidden field for index when editing -->
                    <input type="hidden" id="editIndexAdd" name="index">

                    <!-- Row 1: First Name, Last Name -->
                    <div class="form-group row">
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalFirstNameAdd">First name</label>
                            <input type="text" class="form-control" id="modalFirstNameAdd" name="firstName" placeholder="First name" required>
                            <div id="errFirstNameAdd" class="errr-msg"></div>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalLastNameAdd">Last name</label>
                            <input type="text" class="form-control" id="modalLastNameAdd" name="lastName" placeholder="Last name" required>
                            <div id="errLastNameAdd" class="errr-msg"></div>
                        </div>
                    </div>

                    <!-- Row 2: Company Name -->
                    <div class="form-group row">
                        <div class="col-12 mb-3">
                            <label for="modalCompanyAdd">Company name <span class="optional">(optional)</span></label>
                            <input type="text" class="form-control" id="modalCompanyAdd" name="company" placeholder="Company Name (optional)">
                        </div>
                    </div>

                    <!-- Row 3: Street Address -->
                    <div class="form-group row">
                        <div class="col-12 mb-3">
                            <label for="modalStreetAddressAdd">Street address</label>
                            <input type="text" class="form-control" id="modalStreetAddressAdd" name="streetAddress" placeholder="Street Address" required>
                            <div id="errStreetAddressAdd" class="errr-msg"></div>
                        </div>
                    </div>

                    <!-- Row 4: City -->
                    <div class="form-group row">
                        <div class="col-12 mb-3">
                            <label for="modalCityAdd">City</label>
                            <input type="text" class="form-control" id="modalCityAdd" name="city" placeholder="City" required>
                            <div id="errCityAdd" class="errr-msg"></div>
                        </div>
                    </div>

                    <!-- Row 5: Country, State -->
                    <div class="form-group row">
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalCountrySelectAdd">Country</label>
                            <select class="form-select" id="modalCountrySelectAdd" name="country" required>
                                <option value="" disabled selected hidden>Select Country</option>
                                <option value="India">India</option>
                                <option value="USA">USA</option>
                                <option value="UK">UK</option>
                            </select>
                            <div id="errCountryAdd" class="errr-msg"></div>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalStateSelectAdd">State</label>
                            <select class="form-select" id="modalStateSelectAdd" name="state" required>
                                <option value="" disabled selected hidden>Select State</option>
                            </select>
                            <div id="errStateAdd" class="errr-msg"></div>
                        </div>
                    </div>

                    <!-- Row 6: Landmark, Zipcode -->
                    <div class="form-group row">
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalLandmarkAdd">Landmark</label>
                            <input type="text" class="form-control" id="modalLandmarkAdd" name="landmark" placeholder="Landmark" required>
                            <div id="errLandmarkAdd" class="errr-msg"></div>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalZipcodeAdd">Zip Code</label>
                            <input type="text" class="form-control" id="modalZipcodeAdd" name="zipcode" placeholder="Zip Code" required>
                            <div id="errZipcodeAdd" class="errr-msg"></div>
                        </div>
                    </div>

                    <!-- Row 7: Email -->
                    <div class="form-group row">
                        <div class="col-12 mb-3">
                            <label for="modalEmailAdd">Email <span class="optional">(optional)</span></label>
                            <input type="email" class="form-control" id="modalEmailAdd" name="email" placeholder="Email (optional)">
                        </div>
                    </div>

                    <!-- Row 8: Phone, Alt Phone -->
                    <div class="form-group row">
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalPhoneAdd">Phone Number</label>
                            <input type="tel" class="form-control" id="modalPhoneAdd" name="phone" placeholder="Phone" required>
                            <div id="errPhoneAdd" class="errr-msg"></div>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="modalAltPhoneAdd">Alternative Phone <span class="optional">(optional)</span></label>
                            <input type="tel" class="form-control" id="modalAltPhoneAdd" name="altPhone" placeholder="Alternative Phone (optional)">
                        </div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button class="btn-no" onclick="closeAddAddressModal()">Cancel</button>
                <button class="btn-yes" onclick="saveAddress()">Save Address</button>
            </div>
        </div>
    </div>

    <!-- Pass savedAddresses to JavaScript -->
<script>
    const savedAddresses = <%- JSON.stringify(savedAddresses) %>;
    let appliedCoupon = null;
    let currentSubtotal = parseFloat('<%= subtotal %>');
    let currentShipping = parseFloat('<%= shipping %>');
    let currentTotal = parseFloat('<%= finalTotal %>');

    // Payment option selection
    document.querySelectorAll('.payment-option').forEach(option => {
        option.addEventListener('click', function() {
            document.querySelectorAll('.payment-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            this.classList.add('selected');
            const radio = this.querySelector('.payment-radio');
            radio.checked = true;
        });
    });

    // Coupon functionality
    function applyCoupon(couponCode) {
        const couponItem = document.querySelector(`.coupon-item[data-coupon-code="${couponCode}"]`);
        if (!couponItem) return;

        const minPrice = parseFloat(couponItem.dataset.minPrice);
        const maxPrice = parseFloat(couponItem.dataset.maxPrice);
        const offerPrice = parseFloat(couponItem.dataset.offerPrice);

        if (currentSubtotal < minPrice || currentSubtotal > maxPrice) {
            toastr.error(`This coupon is only valid for orders between $${minPrice} and $${maxPrice}. Your current subtotal is $${currentSubtotal}.`);
            return;
        }

        if (appliedCoupon) {
            currentTotal = currentSubtotal + currentShipping;
            updateTotals();
        }

        document.querySelectorAll('.coupon-item').forEach(item => {
            item.classList.remove('selected');
            const button = item.querySelector('.coupon-apply-btn');
            button.disabled = false;
            button.textContent = 'Apply';
        });

        couponItem.classList.add('selected');
        const applyButton = couponItem.querySelector('.coupon-apply-btn');
        applyButton.disabled = true;
        applyButton.textContent = 'Applied';

        currentTotal -= offerPrice;
        if (currentTotal < 0) currentTotal = 0;
        appliedCoupon = { code: couponCode, offerPrice };

        updateTotals();

        toastr.success(`Coupon ${couponCode} applied successfully! You saved $${offerPrice}.`);
    }

    function updateTotals() {
        document.getElementById('subtotal').textContent = `$${currentSubtotal.toFixed(2)}`;
        document.getElementById('finalTotal').textContent = `$${currentTotal.toFixed(2)}`;
    }

    // Validation function
    function validateForm(formId, isAddModal = false) {
        const form = document.getElementById(formId);
        const prefix = isAddModal ? 'Add' : '';
        let isValid = true;
        const errors = {};

        const requiredFields = [
            { id: `modalFirstName${prefix}`, label: 'First Name' },
            { id: `modalLastName${prefix}`, label: 'Last Name' },
            { id: `modalStreetAddress${prefix}`, label: 'Street Address' },
            { id: `modalCity${prefix}`, label: 'City' },
            { id: `modalCountrySelect${prefix}`, label: 'Country' },
            { id: `modalStateSelect${prefix}`, label: 'State' },
            { id: `modalLandmark${prefix}`, label: 'Landmark' },
            { id: `modalZipcode${prefix}`, label: 'Zip Code' },
            { id: `modalPhone${prefix}`, label: 'Phone Number' }
        ];

        requiredFields.forEach(field => {
            const errorElement = document.getElementById(`err${field.label.replace(/\s+/g, '')}${prefix}`);
            errorElement.textContent = '';
        });

        requiredFields.forEach(field => {
            const input = document.getElementById(field.id);
            if (!input.value.trim()) {
                errors[field.label] = `${field.label} is required.`;
                isValid = false;
                const errorElement = document.getElementById(`err${field.label.replace(/\s+/g, '')}${prefix}`);
                errorElement.textContent = errors[field.label];
            }
        });

        const emailInput = document.getElementById(`modalEmail${prefix}`);
        if (emailInput.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
            errors['Email'] = 'Please enter a valid email address.';
            isValid = false;
            const errorElement = document.getElementById(`errEmail${prefix}`);
            if (errorElement) errorElement.textContent = errors['Email'];
        }

        const phoneInput = document.getElementById(`modalPhone${prefix}`);
        if (phoneInput.value.trim() && !/^\d{10}$/.test(phoneInput.value.replace(/\D/g, ''))) {
            errors['Phone Number'] = 'Please enter a valid 10-digit phone number.';
            isValid = false;
            const errorElement = document.getElementById(`errPhone${prefix}`);
            errorElement.textContent = errors['Phone Number'];
        }

        const zipInput = document.getElementById(`modalZipcode${prefix}`);
        if (zipInput.value.trim() && !/^\d{5,6}$/.test(zipInput.value)) {
            errors['Zip Code'] = 'Please enter a valid zip code (5-6 digits).';
            isValid = false;
            const errorElement = document.getElementById(`errZipcode${prefix}`);
            errorElement.textContent = errors['Zip Code'];
        }

        if (!isValid) {
            const errorMessages = Object.values(errors).join(' ');
            toastr.error(errorMessages);
        }

        return isValid;
    }

    // Modal functions
    function showAddressModal() {
        document.getElementById('address-modal').style.display = 'block';
    }

    function closeAddressModal() {
        document.getElementById('address-modal').style.display = 'none';
    }

    function selectAddress(index) {
        const address = savedAddresses[index];
        if (!address) {
            toastr.error('Invalid address selected.');
            return;
        }

        // Clear previous error messages
        const errorFields = [
            'errFirstName', 'errLastName', 'errStreetAddress', 'errCity',
            'errCountry', 'errState', 'errLandmark', 'errZipcode',
            'errEmail', 'errPhone'
        ];
        errorFields.forEach(field => {
            const errorElement = document.getElementById(field);
            if (errorElement) errorElement.textContent = '';
        });

        document.getElementById('modalFirstName').value = address.firstName || '';
        document.getElementById('modalLastName').value = address.lastName || '';
        document.getElementById('modalCompany').value = address.company || '';
        document.getElementById('modalStreetAddress').value = address.streetAddress || '';
        document.getElementById('modalCity').value = address.city || '';
        document.getElementById('modalCountrySelect').value = address.country || '';
        document.getElementById('modalStateSelect').value = address.state || '';
        document.getElementById('modalLandmark').value = address.landmark || '';
        document.getElementById('modalZipcode').value = address.pinCode || '';
        document.getElementById('modalEmail').value = address.email || '';
        document.getElementById('modalPhone').value = address.phone || '';
        document.getElementById('modalAltPhone').value = address.altPhone || '';
        document.getElementById('makeDefaultCheckbox').checked = address.isDefault || false;

        toastr.success('Address selected successfully!');
        closeAddressModal();
    }

    function showAddAddressModal() {
        closeAddressModal();
        document.getElementById('add-address-modal').style.display = 'block';
    }

    function closeAddAddressModal() {
        document.getElementById('add-address-modal').style.display = 'none';
    }

    function saveAddress() {
        if (!validateForm('add-address-form', true)) {
            return;
        }

        const form = document.getElementById('add-address-form');
        const formData = new FormData(form);
        const addressData = Object.fromEntries(formData);

        fetch('/user/save-address', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(addressData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                toastr.success('Address saved successfully!');
                closeAddAddressModal();
                window.location.reload();
            } else {
                toastr.error(data.message || 'Failed to save address.');
                if (data.redirect) {
                    setTimeout(() => {
                        window.location.href = data.redirect;
                    }, 2000);
                }
            }
        })
        .catch(error => {
            console.error('Error saving address:', error);
            toastr.error('An error occurred while saving the address.');
        });
    }

    function showOrderConfirmation() {
        document.getElementById('confirmation-modal').style.display = 'block';
    }

    function closeModal() {
        document.getElementById('confirmation-modal').style.display = 'none';
    }

    function placeOrder() {
        if (!validateForm('addressForm')) {
            return;
        }

        const paymentMethod = document.querySelector('input[name="payment"]:checked').value;
        const orderNotes = document.getElementById('orderNotes').value;
        const address = {
            firstName: document.getElementById('modalFirstName').value,
            lastName: document.getElementById('modalLastName').value,
            company: document.getElementById('modalCompany').value,
            streetAddress: document.getElementById('modalStreetAddress').value,
            city: document.getElementById('modalCity').value,
            country: document.getElementById('modalCountrySelect').value,
            state: document.getElementById('modalStateSelect').value,
            landmark: document.getElementById('modalLandmark').value,
            zipcode: document.getElementById('modalZipcode').value,
            email: document.getElementById('modalEmail').value,
            phone: document.getElementById('modalPhone').value,
            altPhone: document.getElementById('modalAltPhone').value,
            isDefault: document.getElementById('makeDefaultCheckbox').checked
        };

        const orderData = {
            paymentMethod,
            orderNotes,
            address,
            coupon: appliedCoupon ? appliedCoupon.code : null,
            total: currentTotal
        };

        fetch('/order/place', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(orderData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                toastr.success('Order placed successfully!');
                closeModal();
                setTimeout(() => {
                    window.location.href = '/order-confirmation';
                }, 2000);
            } else {
                toastr.error(data.message || 'Failed to place order.');
                closeModal();
                if (data.redirect) {
                    setTimeout(() => {
                        window.location.href = data.redirect;
                    }, 2000);
                }
            }
        })
        .catch(error => {
            console.error('Error placing order:', error);
            toastr.error('An error occurred while placing the order.');
            closeModal();
        });
    }

    window.onclick = function(event) {
        const modals = document.querySelectorAll('.modal');
        modals.forEach(modal => {
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });
    }

    window.onload = function() {
        const defaultAddress = savedAddresses.find(addr => addr.isDefault);
        if (defaultAddress) {
            const index = savedAddresses.indexOf(defaultAddress);
            selectAddress(index);
        }
    };
</script>
</body>
</html>