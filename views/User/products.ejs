<%- include("../../views/Partials/user/header-ho") %>
<hr style="margin: 0rem 0rem 1rem 0rem; background-color: #535353;">
<link rel="stylesheet" href="/User-css/products-user.css">

<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">

<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    <% breadcrumbs.forEach((crumb, index) => { %>
    <li class="breadcrumb-item <%= index === breadcrumbs.length - 1 ? 'active' : '' %>">
      <% if (index !== breadcrumbs.length - 1) { %>
      <a href="<%= crumb.url %>"><%= crumb.name %></a>
      <% } else { %>
      <%= crumb.name %>
      <% } %>
    </li>
    <% }) %>
  </ol>
</nav>
<div class="prdctData-wrapper">
  <div class="prdctData">
    <div class="left">
      <div class="subs">
        <% const images = Array.isArray(product.productImage) ? product.productImage : (product.productImage ? [product.productImage] : []); %>
        <% images.forEach((image, index) => { %>
        <div class="subImg <%= index === 0 ? 'active' : '' %>" data-image="<%= image %>">
          <img src="<%= image %>" alt="Product Thumbnail <%= index + 1 %>">
        </div>
        <% }) %>
      </div>
      <div class="mainImage">
        <img id="mainImage" src="<%= Array.isArray(product.productImage) && product.productImage.length > 0 ? product.productImage[0] : '/default-product.png' %>" alt="<%= product.productName %>">
      </div>
    </div>
    <div class="right">
      <div class="prdctname">
        <h2 class="name"><%= product.productName %></h2>
        <div class="stockstatus <%= product.quantity > 0 ? 'stock-available' : 'stock-out' %>">
          <%= product.quantity > 0 ? 'Available' : 'Out Of Stock' %>
        </div>
      </div>
      <div class="prdctdata">
        <span class="stars">
          <% if (reviews && reviews.length > 0) { %>
          <% const averageRating = Math.round(reviews.reduce((sum, review) => sum + review.rating, 0) / reviews.length); %>
          <%= '⭐'.repeat(averageRating) %><%= '☆'.repeat(5 - averageRating) %>
          <% } else { %>
          ☆☆☆☆☆
          <% } %>
        </span>
        <span class="many">
          <%= reviews ? reviews.length : 0 %> <%= (reviews && reviews.length === 1) ? 'review' : 'reviews' %>
        </span>
        <span class="dot">•</span>
        <span class="sku">SKU:</span><span class="skuu"><%= product.SKU %></span>
      </div>
      <div class="price-section">
        <% if (product.largestOffer && product.largestOffer > 0) { %>
        <span class="new-price"><%= product.price.toFixed(2) %>₹</span>
        <% if (product.price < product.regularPrice) { %>
        <span class="old-price"><del><%= product.regularPrice.toFixed(2) %>₹</del></span>
        <% } %>
        <% } else { %>
        <span class="new-price"><%= product.regularPrice.toFixed(2) %>₹</span>
        <% if (product.salePrice !== product.regularPrice) { %>
        <span class="old-price"><del><%= product.salePrice.toFixed(2) %>₹</del></span>
        <% } %>
        <% } %>
      </div>

      <% if (product.quantity <= 0) { %>
      <div class="out-of-stock-message" style="color: red; font-weight: bold; font-size: 1.5rem; margin: 15px 0;">
        The Product is out of stock
      </div>
      <% } else { %>
      <% if (product.category?.name === 'Meat' || product.category?.name === 'Fish') { %>
      <div class="cutting-style-selector">
        <label for="cuttingStyle">Cutting Style:</label>
        <select id="cuttingStyle" name="cuttingStyle">
          <option value="" disabled selected>Select Cutting Style</option>
          <% (product.cuttingStyle || []).forEach(style => { %>
          <option value="<%= style %>"><%= style %></option>
          <% }) %>
        </select>
      </div>
      <% } %>

      <hr style="width: 120%; border: 1px solid #898989; margin-top: 15px;">
      <div class="cart-containerr">
        <div class="quantity-selector">
          <button class="decrease">−</button>
          <span class="quantity">1</span>
          <button class="increase">+</button>
        </div>
        <button class="buy-now-btn">
          Buy Now <span class="cart-icon material-icons">local_mall</span>
        </button>
        <div class="cart-icon-container" id="shoppingCartIconContainer">
          <% if (inCart) { %>
            <svg id="shoppingCartIcon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM208-800h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Z"/></svg>
          <% } else { %>
            <svg id="shoppingCartIcon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM246-720l96 200h280l110-200H246Zm-38-80h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Zm134 280h280-280Z"/></svg>
          <% } %>
        </div>
        <div class="wishlist-container">
          <span class="material-icons" id="wishlistIcon">favorite_border</span>
        </div>
      </div>
      <% } %>
      <hr style="width: 120%; border: 1px solid #898989; margin-top: 10px;">
      <div class="product-meta">
        <p>
          <strong>Category:</strong> <span class="veg"><%= product.category?.name || 'Not specified' %></span>
          <br>
        </p>
        <span class="stock-info" style="margin-top: 20px;">
          <strong>Stock Left:</strong>
          <% if (product.quantity > 10) { %>
          <span style="color: green;"><%= product.quantity %> units</span>
          <% } else if (product.quantity > 0) { %>
          <span style="color: orange;">Only <%= product.quantity %> units left!</span>
          <% } else { %>
          <span style="color: red;">Out of stock</span>
          <% } %>
        </span>
      </div>
    </div>
  </div>
</div>
<div class="product-info">
  <ul class="tab-menu">
    <li class="tab-item active" onclick="showTab('description',this)">Descriptions</li>
    <li class="tab-item" onclick="showTab('feedback',this)">Customer Feedback</li>
  </ul>
  <div class="tab-content">
    <div id="description" class="tab-pane active section-wrapper">
      <div class="left-area">
        <span class="product-des">
          <h2 style="margin-bottom: 1%;">Product Description:-</h2>
          <p style="text-align: justify;"><%= product.description %></p>
        </span>
      </div>
    </div>
    <div id="feedback" class="tab-pane section-wrapper">
      <p>This is customer feedback section.</p>
    </div>
  </div>
</div>
<% if (products.length > 0) { %>
<section class="featured-products">
  <div class="container">
    <div class="header">
      <h2>Recommended Products</h2>
    </div>
    <div class="product-list">
      <% products.slice(0, 4).forEach(product => { %>
      <% if (product.status !== 'Out Of Stock') { %>
      <div class="product-card <%= product.status === 'Out Of Stock' ? 'out-of-stock' : '' %>">
        <span class="out-of-stock-label">
          <%= product.status === 'Out Of Stock' ? 'Out of Stock' : (product.discountPercentage > 0 ? `-${product.discountPercentage}% off` : '') %>
        </span>
        <a href="/product/<%= product._id %>" class="product-link">
          <img src="<%= product.image || '/default-product.png' %>" alt="<%= product.name %>">
          <h3><%= product.name %></h3>
          <p class="price">
            <% if (product.largestOffer && product.largestOffer > 0) { %>
            <%= product.price.toFixed(2) %>
            <% if (product.price < product.regularPrice) { %>
            <del class="old-price"><%= product.regularPrice.toFixed(2) %></del>
            <% } %>
            <% } else { %>
            <%= product.regularPrice.toFixed(2) %>
            <% if (product.salePrice !== product.regularPrice) { %>
            <del class="old-price"><%= product.salePrice.toFixed(2) %></del>
            <% } %>
            <% } %>
          </p>
        </a>
      </div>
      <% } %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include("../../views/Partials/user/footer") %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
  document.querySelectorAll(".subImg").forEach((img) => {
    img.addEventListener("click", function() {
      document.querySelectorAll(".subImg").forEach((el) => el.classList.remove("active"));
      this.classList.add("active");
      const newImage = this.getAttribute("data-image");
      document.getElementById("mainImage").src = newImage;
    });
  });

  function showTab(tabId, element) {
    document.querySelectorAll('.tab-pane').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.tab-item').forEach(el => el.classList.remove('active'));
    document.getElementById(tabId).style.display = 'flex';
    element.classList.add('active');
  }

  document.addEventListener("DOMContentLoaded", function() {
    showTab('description', document.querySelector('.tab-item[onclick*="description"]'));
  });

  // Quantity Selector Logic
  const quantitySpan = document.querySelector('.quantity');
  const decreaseBtn = document.querySelector('.decrease');
  const increaseBtn = document.querySelector('.increase');
  const buyNowBtn = document.querySelector('.buy-now-btn');
  const shoppingCartIconContainer = document.querySelector('#shoppingCartIconContainer');
  const cuttingStyleSelect = document.querySelector('#cuttingStyle');
  const wishlistIcon = document.querySelector('#wishlistIcon');
  
  // Define SVG content
  const fullCartSvg = `<svg id="shoppingCartIcon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM208-800h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Z"/></svg>`;
  const emptyCartSvg = `<svg id="shoppingCartIcon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM246-720l96 200h280l110-200H246Zm-38-80h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Zm134 280h280-280Z"/></svg>`;

  let quantity = parseInt(quantitySpan.textContent);
  const wishlist = <%- JSON.stringify(wishlist) || '[]' %>;
  let inWishlist = wishlist.includes('<%= product._id.toString() %>');
  let inCart = <%- JSON.stringify(inCart) %>;
  
  // Set initial icon states
  wishlistIcon.textContent = inWishlist ? 'favorite' : 'favorite_border';
  // The cart icon is set dynamically in the HTML, no need to set here on load
  
  decreaseBtn.addEventListener('click', () => {
    if (quantity > 1) {
      quantity--;
      quantitySpan.textContent = quantity;
    }
  });

  increaseBtn.addEventListener('click', () => {
    // Client-side stock check when increasing quantity
    const maxQuantity = parseInt('<%= product.quantity %>');
    if (quantity < maxQuantity) {
      quantity++;
      quantitySpan.textContent = quantity;
    }
  });

  // Event listener for the "Buy Now" button
  buyNowBtn.addEventListener('click', () => {
    const productId = '<%= product._id %>';
    const userRequestedQuantity = parseInt(quantitySpan.textContent);
    const stockQuantity = parseInt('<%= product.quantity %>');
    let cuttingStyle = cuttingStyleSelect ? cuttingStyleSelect.value : null;

    if (cuttingStyleSelect && !cuttingStyle) {
      toastr.error('Please select a cutting style.');
      return;
    }

    // Client-side stock check before navigating
    if (userRequestedQuantity > stockQuantity) {
      toastr.error('Insufficient Stock.');
      return;
    }

    let checkoutUrl = `/cart/checkout?productId=${productId}&quantity=${userRequestedQuantity}`;
    if (cuttingStyle) {
      checkoutUrl += `&cuttingStyle=${cuttingStyle}`;
    }

    window.location.href = checkoutUrl;
  });

  // Event listener for the shopping cart icon container
  shoppingCartIconContainer.addEventListener('click', async () => {
    const productId = '<%= product._id %>';
    const userRequestedQuantity = parseInt(quantitySpan.textContent);
    const stockQuantity = parseInt('<%= product.quantity %>');
    let cuttingStyle = cuttingStyleSelect ? cuttingStyleSelect.value : null;

    if (cuttingStyleSelect && !cuttingStyle && !inCart) {
      toastr.error('Please select a cutting style to add to cart.');
      return;
    }

    // Client-side stock check for "Add to Cart"
    if (userRequestedQuantity > stockQuantity) {
      toastr.error('Insufficient Stock.');
      return;
    }

    const cartData = {
      productId,
      quantity: userRequestedQuantity,
      ...(cuttingStyle && { cuttingStyle }),
    };

    try {
      const response = await fetch('/cart/toggle', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(cartData),
      });

      const data = await response.json();

      if (data.success) {
        inCart = data.inCart;
        // Dynamically update the SVG icon based on the new cart status
        if (inCart) {
          shoppingCartIconContainer.innerHTML = fullCartSvg;
        } else {
          shoppingCartIconContainer.innerHTML = emptyCartSvg;
        }
        toastr.success(data.message);
      } else {
        toastr.error(data.message || 'Unknown error');
      }
    } catch (error) {
      console.error('Error updating cart:', error);
      toastr.error('An error occurred while updating the cart.');
    }
  });

  // Existing wishlist logic
  wishlistIcon.addEventListener('click', async () => {
    const productId = '<%= product._id %>';
    console.log(`Attempting to toggle wishlist for product ${productId}`);

    try {
      const response = await fetch('/wishlist/add-or-remove', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          productId
        }),
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const data = await response.json();
      console.log('Server response:', data);

      if (data.success) {
        inWishlist = data.inWishlist;
        wishlistIcon.textContent = inWishlist ? 'favorite' : 'favorite_border';
        toastr.success(inWishlist ? 'Added to wishlist!' : 'Removed from wishlist!');
      } else {
        toastr.error(data.message || 'Unknown error');
      }
    } catch (error) {
      console.error('Error updating wishlist:', error);
      toastr.error('An error occurred while updating the wishlist.');
    }
  });
</script>