<%-include("../../views/Partials/user/header-simple")%>
<link rel="stylesheet" href="/User-css/login-user.css">

        <!-- Login Form -->
        <div class="login-container">
            <div class="login-box">
                <h2 class="login-title">Log In</h2>
                
                <form method="POST" action="/login" novalidate autocomplete="off">
                    
                  <% const type = typeof messageType !== 'undefined' ? messageType : 'error'; %>
                  <% if (message) { %>
                    <div class="<%= type === 'success' ? 'success-msg' : 'server-error-message' %>">
                      <%- message %>
                    </div>
                  <% } %>
                  
                  <div id="client-message" style="display: none;"></div>
                      
                
                    <div class="form-group">
                        <input type="email" name="email" class="form-control" placeholder="Email">
                        <div id="err1" class="errr-msg"></div>
                    </div>
                
                    <div class="form-group password-group">
                        <input type="password" name="password" id="password" class="form-control" placeholder="Password">
                        <span class="eye-icon" onclick="togglePassword('password', this)">👁️</span>
                        <div id="err2" class="errr-msg"></div>
                    </div>
                
                    <div class="form-group remember-me">
                        <label>
                            <input type="checkbox" name="rememberMe"> Remember me
                        </label>
                        <div class="forgot-password-container">
                            <a href="/forget-password" class="forgot-password">Forget Password?</a>
                        </div>
                    </div>                    
                
                    <button type="submit" class="login-btn">Login</button>
                
                    <!-- Google Sign-in Button -->
                    <div class="google-signin">
                        <a href="/auth/google/login" class="google-signin-btn">
                          <img src="/g-logo-removebg-preview.png" alt="Google Logo">
                          <span>Sign in with Google</span>
                      </a>                    
                      </div>
                </form>
                
                
                <p class="register-link">Don't have an account? <a href="/register">Register</a></p>
            </div>
        </div>

<script>

  // Check for message in sessionStorage and display it
  document.addEventListener("DOMContentLoaded", () => {
    const message = sessionStorage.getItem('message');
    const messageType = sessionStorage.getItem('messageType');
    const clientMessageDiv = document.getElementById('client-message');

    if (message && messageType && message !== 'none' && messageType !== 'none') {
      // Display the message in the DOM
      clientMessageDiv.style.display = 'block';
      clientMessageDiv.textContent = message;
      clientMessageDiv.className = messageType === 'success' ? 'success-msg' : 'server-error-message';

      // Clear the message from sessionStorage so it doesn't show again
      sessionStorage.removeItem('message');
      sessionStorage.removeItem('messageType');
    }
  });

  // Get form input elements
  const emailid = document.getElementsByName('email')[0];
  const passwordid = document.getElementById('password');

  // Get corresponding error message containers
  const err1id = document.getElementById('err1');
  const err2id = document.getElementById('err2');

  // Get the login form element
  const loginform = document.querySelector('form');

  // -------------------------------
  // Email Validation Function
  // -------------------------------
  function emailValidateCheck() {
    const val = emailid.value.trim();
    const pattern = /^[a-z0-9._%+-]+@[a-z.-]+\.[a-z]{2,}$/;

    if (!val) {
      err1id.innerHTML = "Email is required";
      err1id.style.display = 'block';

    } else if (!pattern.test(val)) {
      err1id.innerHTML = "Please enter a valid email address";
      err1id.style.display = 'block';

    } else {
      err1id.innerHTML = "";
      err1id.style.display = 'none';
    }
  }

  // -------------------------------
  // Password Validation Function
  // -------------------------------
  function passwordValidateCheck() {
    const val = passwordid.value;

    if (!val) {
      err2id.innerHTML = "Password is required";
      err2id.style.display = 'block';

    } else {
      err2id.innerHTML = "";
      err2id.style.display = 'none';
    }
  }

  // --------------------------------
  // Toggle Password Visibility
  // --------------------------------
  function togglePassword(inputId, iconElement) {
    const input = document.getElementById(inputId);
    const isVisible = input.type === "text";

    input.type = isVisible ? "password" : "text";

    // Optional: Toggle the icon text
    iconElement.textContent = isVisible ? "👁️" : "🙈";
  }

  // --------------------------------
  // Form Submission Validation
  // --------------------------------
  document.addEventListener('DOMContentLoaded', () => {
    loginform.addEventListener('submit', function (e) {
      
      // Run both validations
      emailValidateCheck();
      passwordValidateCheck();

      // If any errors are present, prevent form submission
      if (err1id.innerHTML || err2id.innerHTML) {
        e.preventDefault();
      }
    });
  });
</script>

<%-include("../../views/Partials/user/footer")%>