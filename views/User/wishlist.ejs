<%- include("../../views/Partials/user/header-ho") %>
<hr style="margin: 0;">
<link rel="stylesheet" href="/User-css/wishlist.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<title>Wishlist</title>
</head>
<style>
    #toast-container>.toast {
        opacity: 1;
    }
    .toast-success {
        background-color: #4CAF50;
    }
    .toast-error {
        background-color: #e92e20;
    }
</style>
<body style="min-height: 100vh;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <% breadcrumbs.forEach((crumb, index) => { %>
            <li class="breadcrumb-item <%= index === breadcrumbs.length - 1 ? 'active' : '' %>">
                <% if (index !== breadcrumbs.length - 1) { %>
                <a href="<%= crumb.url %>"><%= crumb.name %></a>
                <% } else { %>
                <%= crumb.name %>
                <% } %>
            </li>
            <% }) %>
        </ol>
    </nav>
    <div class="shop-wrapper">
        <div class="shop-container">
            <div class="main-content">
                <p id="prdct-count"><%= wishlist ? wishlist.products.length : 0 %> items in wishlist</p>
                <div class="products-grid">
                    <div class="product-grid">
                        <div class="product-list">
                            <% if (wishlist && wishlist.products.length > 0) { %>
                            <div class="row">
                                <% wishlist.products.forEach(product => { %>
                                <div>
                                    <div class="product-card <%= product.productId.status === 'Out Of Stock' ? 'out-of-stock' : '' %>">
                                        <span class="out-of-stock-label">
                                            <%= product.productId.status === 'Out Of Stock' ? 'Out of Stock' : (product.productId.discountPercentage > 0 ? `-${product.productId.discountPercentage}% off` : '') %>
                                        </span>
                                        <a href="/product/<%= product.productId._id %>" class="product-link">
                                            <img src="<%= product.productId.image %>" alt="<%= product.productId.name %>">
                                            <p class="product-name"><%= product.productId.name %></p>
                                            <p class="price">
                                                <%= product.productId.regularPrice ? product.productId.regularPrice.toFixed(2) : 'N/A' %>
                                                <% if (product.productId.salePrice) { %>
                                                <del class="old-price"><%= product.productId.salePrice ? product.productId.salePrice.toFixed(2) : 'N/A' %></del>
                                                <% } %>
                                            </p>
                                        </a>
                                        <button id="wishlistBtn-<%= product.productId._id %>" class="cart-btn" data-product-id="<%= product.productId._id %>">
                                            <span class="fav-icon-wrapper"></span>
                                        </button>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                            <% } else { %>
                            <div class="no-items-message">
                                No items in wishlist!
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include("../../views/Partials/user/footer") %>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        const wishlist = <%- JSON.stringify(wishlist && wishlist.products ? wishlist.products.map(p => p.productId && p.productId._id ? p.productId._id.toString() : null).filter(id => id !== null) : []) %>;
        const unfilledSvg = `<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ff0000"><path d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Zm0-108q96-86 158-147.5t98-107q36-45.5 50-81t14-70.5q0-60-40-100t-100-40q-47 0-87 26.5T518-680h-76q-15-41-55-67.5T300-774q-60 0-100 40t-40 100q0 35 14 70.5t50 81q36 45.5 98 107T480-228Zm0-273Z"/></svg>`;
        const filledSvg = `<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ff0000"><path d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Z"/></svg>`;

        document.querySelectorAll('[id^="wishlistBtn-"]').forEach(button => {
            const productId = button.dataset.productId;
            const wishlistIconWrapper = button.querySelector('.fav-icon-wrapper');
            let inWishlist = true;
            wishlistIconWrapper.innerHTML = filledSvg;

            button.addEventListener('click', async () => {
                if (button.disabled) return;
                if (!productId) {
                    toastr.error('Failed to identify product. Please try again.');
                    return;
                }
                try {
                    const response = await fetch('/wishlist/add-or-remove', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({productId})
                    });
                    if (!response.ok) {
                        const errorText = await response.text();
                        throw new Error(`HTTP error! status: ${response.status}, message: ${errorText}`);
                    }
                    const data = await response.json();
                    if (data.success) {
                        inWishlist = !inWishlist;
                        wishlistIconWrapper.innerHTML = inWishlist ? filledSvg : unfilledSvg;
                        toastr.success(inWishlist ? 'Added to wishlist!' : 'Removed from wishlist!');
                        setTimeout(() => {location.reload();}, 2000);
                    } else {
                        toastr.error(data.message || 'Unknown error');
                    }
                } catch (error) {
                    toastr.error(error.message || 'An error occurred while updating the wishlist.');
                }
            });
        });

        window.onload = function () {
            if (typeof toastr === 'undefined') {
                console.error('Toastr is not loaded. Check the CDN link.');
            } else {
                toastr.options = {
                    positionClass: "toast-top-right",
                    timeOut: 5000,
                    showDuration: 300,
                    hideDuration: 300,
                    newestOnTop: true,
                    preventDuplicates: true,
                    showMethod: 'fadeIn',
                    hideMethod: 'fadeOut'
                };
            }
        };
    </script>
</body>
</html>