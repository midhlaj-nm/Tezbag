<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wallet</title>

  <!-- jQuery (required for Toastr) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <!-- Toastr CSS & JS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link rel="stylesheet" href="/User-css/wallet.css">

  <!-- Font Awesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Font & icon -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<style>
  #toast-container>.toast {
    opacity: 1;
  }

  .toast-success {
    background-color: #4CAF50;
  }

  .toast-error {
    background-color: #e92e20;
  }
</style>

<body>
  <!-- Header Section -->
  <header class="header">
    <div class="container d-flex justify-content-between align-items-center">
      <!-- Logo -->
      <div class="logo">
        <img src="/logo.png" alt="TezBag">
      </div>

      <!-- Search Bar -->
      <div class="search-bar">
        <form action="/wallet" method="GET">
          <div class="input-wrapper">
            <input type="text" name="query" placeholder="Search" value="<%= typeof walletData.searchQuery !== 'undefined' ? walletData.searchQuery : '' %>">
            <% if (typeof walletData.searchQuery !== 'undefined' && walletData.searchQuery.trim() !== '') { %>
            <a href="/wallet?page=<%= walletData.currentPage %>" class="clear-icon">
              <span class="material-symbols-outlined">cancel</span>
            </a>
            <% } %>
          </div>
          <button type="submit" class="search-btn">Search</button>
        </form>
      </div>

      <!-- Google Fonts Icons Version -->
      <div class="cart-container">
        <a href="/wishlist" class="heart-link">
          <div class="heart-container">
            <span class="material-symbols-outlined icon">favorite</span>
          </div>
        </a>

        <div class="divider"></div>

        <a href="/cart" class="cart-link">
          <div class="cart-content">
            <span class="material-symbols-outlined icon">shopping_bag</span>
            <div class="cart-text">
              <p class="cart-label">Shopping cart:</p>
              <span class="cart-total">0.00₹</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </header>

  <div id="middle" class="container-fluid">
    <ul id="list">
      <li><a href="/">Home</a></li>
      <li><a href="/shop">Shop</a></li>
      <li><a href="/pages">Pages</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/account">Account</a></li>
    </ul>
    <div id="right-section">
      <div id="call">
        <img src="/PhoneCall 1.svg">
      </div>
      <span id="num">
        <p>7907700456</p>
      </span>
    </div>
  </div>

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active">Wallet</li>
    </ol>
  </nav>

  <div class="page-wrapper">
    <!-- Left Navigation Panel -->
    <div class="navigation-panel">
      <div class="nav-header">Navigation</div>
      <div class="nav-item" onclick="window.location.href='/account'">
        <span class="material-symbols-outlined">Dashboard</span>Dashboard
      </div>
      <div class="nav-item" onclick="window.location.href='/order-history'">
        <i class="fa-solid fa-rotate"></i> Order History
      </div>
      <div class="nav-item" onclick="window.location.href='/wishlist'">
        <span class="material-symbols-outlined">favorite</span>Wishlist
      </div>
      <div class="nav-item" onclick="window.location.href='/cart'">
        <span class="material-symbols-outlined">shopping_cart</span>Shopping Cart
      </div>
      <div class="nav-item" onclick="window.location.href='/account-settings'">
        <span class="material-symbols-outlined">settings</span>Settings
      </div>
      <div class="nav-item active" onclick="window.location.href='/wallet'">
        <span class="material-symbols-outlined">wallet</span>Wallet
      </div>
      <div class="nav-item" onclick="window.location.href='/logout'">
        <span class="material-symbols-outlined">logout</span>Log-out
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
      <div class="wallet-container">
        <div class="wallet-header">
          <h2>Wallet</h2>
          <p>Current Balance: <%= walletData.wallet.balance.toFixed(2) %>₹</p>
        </div>

        <div class="table-responsive">
          <table class="wallet-table table table-hover">
            <thead>
              <tr>
                <th>Type</th>
                <th>Amount</th>
                <th>Reason</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (walletData.transactions && walletData.transactions.length > 0) { %>
              <% walletData.transactions.forEach(transaction => { %>
              <tr>
                <td><%= transaction.type.charAt(0).toUpperCase() + transaction.type.slice(1) %></td>
                <td><%= transaction.amount.toFixed(2) %>₹</td>
                <td><%= transaction.reason %></td>
                <td><%= new Date(transaction.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
              </tr>
              <% }) %>
              <% } else { %>
              <tr>
                <td colspan="4">
                  <div style="
                    height: 230px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 500;
                    font-size: 1.1rem;
                    color: #666;
                  ">
                    No data to show right now!
                  </div>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <% if (walletData.totalPages >= 1) { %>
  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center mt-4">
      <li class="page-item <%= walletData.currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="/wallet?query=<%= encodeURIComponent(walletData.searchQuery) %>&page=<%= walletData.currentPage - 1 %>">Previous</a>
      </li>
      <% for (let i = 1; i <= walletData.totalPages; i++) { %>
      <li class="page-item <%= walletData.currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="/wallet?query=<%= encodeURIComponent(walletData.searchQuery) %>&page=<%= i %>"><%= i %></a>
      </li>
      <% } %>
      <li class="page-item <%= walletData.currentPage === walletData.totalPages || (walletData.transactions && walletData.transactions.length === 0) ? 'disabled' : '' %>">
        <a class="page-link" href="/wallet?query=<%= encodeURIComponent(walletData.searchQuery) %>&page=<%= walletData.currentPage + 1 %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>

  <div class="footer-wrapper">
    <%- include("../../views/Partials/user/footer") %>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
  </script>
</body>

</html>