<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order History</title>

  <!-- jQuery (required for Toastr) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <!-- Toastr CSS & JS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link rel="stylesheet" href="/User-css/order-history.css">

  <!-- Font Awesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Font & icon -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>
<style>
  /* Ensure Toastr container is styled */
  #toast-container {
    opacity: 1;
  }

  #toast-container>.toast {
    opacity: 1 !important;
    /* Override any default opacity */
    background-color: transparent !important;
    /* Reset to allow custom backgrounds */
    border: none !important;
  }

  #toast-container>.toast-success {
    background-color: #4CAF50 !important;
    /* Green for success */
    color: white !important;
    /* Ensure text is readable */
  }

  #toast-container>.toast-error {
    background-color: #e92e20 !important;
    /* Red for error */
    color: white !important;
    /* Ensure text is readable */
  }
</style>

<body>

  <!-- Header Section -->
  <header class="header">
    <div class="container d-flex justify-content-between align-items-center">

      <!-- Logo -->
      <div class="logo">
        <img src="/Logo.png" alt="TezBag">
      </div>

      <!-- Search Bar -->
      <div class="search-bar">
        <form action="/order-history" method="GET">
          <div class="input-wrapper">
            <input type="text" name="query" placeholder="Search" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <% if (typeof searchQuery !== 'undefined' && searchQuery.trim() !== '') { %>
            <a href="/order-history?page=<%= currentPage %>" class="clear-icon">
              <span class="material-symbols-outlined">cancel</span>
            </a>
            <% } %>
          </div>
          <button type="submit" class="search-btn">Search</button>
        </form>
      </div>

      <!-- Google Fonts Icons Version -->
      <div class="cart-container">
        <a href="/wishlist" class="heart-link">
          <div class="heart-container">
            <span class="material-symbols-outlined icon">favorite</span>
          </div>
        </a>

        <div class="divider"></div>

        <a href="/cart" class="cart-link">
          <div class="cart-content">
            <span class="material-symbols-outlined icon">shopping_bag</span>
            <div class="cart-text">
              <p class="cart-label">Shopping cart:</p>
              <% if (cartTotal) { %>
              <span class="cart-total"><%= cartTotal %></span>
              <% } else { %>
              <span class="cart-total">0.00₹</span>
              <% } %>
            </div>
          </div>
        </a>
      </div>
    </div>
  </header>

  <div id="middle" class="container-fluid">
    <ul id="list">
      <li><a href="/">Home</a></li>
      <li><a href="/shop">Shop</a></li>
      <li><a href="/pages">Pages</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/account">Account</a></li>
    </ul>
    <div id="right-section">
      <div id="call">
        <img src="/PhoneCall 1.svg">
      </div>
      <span id="num">
        <p>7907700456</p>
      </span>
    </div>
  </div>

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <% if (breadcrumbs && Array.isArray(breadcrumbs)) { %>
      <% breadcrumbs.forEach((crumb, index) => { %>
      <li class="breadcrumb-item <%= index === breadcrumbs.length - 1 ? 'active' : '' %>">
        <% if (index !== breadcrumbs.length - 1) { %>
        <a href="<%= crumb.url %>"><%= crumb.name %></a>
        <% } else { %>
        <%= crumb.name %>
        <% } %>
      </li>
      <% }) %>
      <% } %>
    </ol>
  </nav>

  <div class="page-wrapper">
    <!-- Left Navigation Panel -->
    <div class="navigation-panel">
      <div class="nav-header">Navigation</div>

      <div class="nav-item" onclick="window.location.href='/account'">
        <span class="material-symbols-outlined">Dashboard</span>Dashboard
      </div>
      <div class="nav-item active" onclick="window.location.href='/order-history'">
        <i class="fa-solid fa-rotate"></i> Order History
      </div>
      <div class="nav-item" onclick="window.location.href='/wishlist'">
        <span class="material-symbols-outlined">favorite</span>Wishlist
      </div>
      <div class="nav-item" onclick="window.location.href='/cart'">
        <span class="material-symbols-outlined">shopping_cart</span>Shopping Cart
      </div>
      <div class="nav-item" onclick="window.location.href='/account-settings'">
        <span class="material-symbols-outlined">settings</span>Settings
      </div>
      <div class="nav-item" onclick="window.location.href='/wallet'">
        <span class="material-symbols-outlined">wallet</span>Wallet
      </div>
      <div class="nav-item" onclick="window.location.href='/logout'">
        <span class="material-symbols-outlined">logout</span>Log-out
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
      <div class="order-history-container">
        <div class="order-history-header">
          <h2>Order History</h2>
        </div>

        <div class="table-responsive">
          <table class="order-table table table-hover">
            <thead>
              <tr>
                <th>ORDER ID</th>
                <th>DATE</th>
                <th>TOTAL</th>
                <th>STATUS</th>
                <th>ACTION</th>
              </tr>
            </thead>
            <tbody>
              <% if (orders && orders.length > 0) { %>
              <% orders.forEach(order => { %>
              <% if (order) { %>
              <tr>
                <td class="order-id">#<%= order.orderId.slice(0,6) %></td>
                <td class="order-date"><%= new Date(order.invoiceDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                <td class="order-total"><%= order.finalAmount.toFixed(2) %>₹ </td>
                <td>
                  <span class="order-status"><%= order.status %></span>
                </td>
                <td>
                  <button class="view-details-btn" onclick="window.location.href = '/order-confirmation/<%= order.orderId %>'">View Details</button>
                </td>
              </tr>
              <% } %>
              <% }) %>
              <% } else { %>
              <tr>
                <td colspan="5" class="no-orders">No orders found.</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <% if (totalPages >= 1) { %>
  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center mt-4">
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="/order-history?query=<%= encodeURIComponent(searchQuery) %>&page=<%= currentPage - 1 %>">Previous</a>
      </li>
      <% for (let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="/order-history?query=<%= encodeURIComponent(searchQuery) %>&page=<%= i %>"><%= i %></a>
      </li>
      <% } %>
      <li class="page-item <%= currentPage === totalPages || orders.length === 0 ? 'disabled' : '' %>">
        <a class="page-link" href="/order-history?query=<%= encodeURIComponent(searchQuery) %>&page=<%= currentPage + 1 %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>

  <div class="footer-wrapper">
    <%- include("../../views/Partials/user/footer") %>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Initialize Toastr with custom options
    toastr.options = {
      "debug": false,
      "newestOnTop": true,
      "positionClass": "toast-top-right",
      "preventDuplicates": false,
      "onclick": null,
      "showDuration": "300",
      "hideDuration": "1000",
      "timeOut": "5000",
      "extendedTimeOut": "1000",
      "showEasing": "swing",
      "hideEasing": "linear",
      "showMethod": "fadeIn",
      "hideMethod": "fadeOut",
      "backgroundColor": "transparent",
      "textColor": "white"
    };
  </script>
</body>

</html>