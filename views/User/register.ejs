<%-include("../../views/Partials/user/header-simple")%>
<link rel="stylesheet" href="/User-css/createAcc-user.css">
        <!-- Login Form -->
        <div class="login-container">
            <div class="login-box">
                <h2 class="login-title">Create Account</h2>
                
                <form id="signForm" method="POST" action="/register" novalidate>


                  <% if (message && message.length > 0) { %>
                    <div class="server-error-message <%= messageType %>">
                      <%= message %>
                    </div>
                  <% } %>
                  
                  


                    <div class="form-group">
                        <input type="text" class="form-control" name="f_name" placeholder="First Name">
                        <div id="err1" class="errr-msg"></div>
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-control" name="l_name" placeholder="Last Name">
                        <div id="err2" class="errr-msg"></div>
                    </div>
                    <div class="form-group">
                        <input type="email" class="form-control" name="email" placeholder="Email">
                        <div id="err3" class="errr-msg"></div>
                    </div>
                    <div class="form-group password-group">
                        <input type="password" class="form-control" name="password" id="password" placeholder="Password"> 
                        <span class="eye-icon" onclick="togglePassword('password', this)">👁️</span>                  
                        <div id="err4" class="errr-msg"></div>
                    </div>
                    
                    <div class="form-group password-group">
                        <input type="password" class="form-control" name="cPassword" id="cPassword" placeholder="Confirm Password">
                        <span class="eye-icon" onclick="togglePassword('cPassword', this)">👁️</span>
                        <div id="err5" class="errr-msg"></div>
                    </div>
                    <div class="form-group remember-me">
                        <label>
                            <input type="checkbox" id="termsCheckbox">Accept our terms & conditions
                            <div id="err6" class="errr-msg"></div>
                        </label>
                    </div>                    
                    <button type="submit" class="login-btn">Continue</button>


                    <!-- Google Sign-in Button -->
                    <div class="google-signin">
                      <a href="/auth/google/signup" class="google-signin-btn">
                        <img src="/g-logo-removebg-preview.png" alt="Google Logo">
                        <span>Sign in with Google</span>
                    </a>                    
                    </div>
                </form>
                
                <p class="register-link">Have an account?<a href="/login"> Log In</a></p>
            </div>
        </div>
        <%-include("../../views/Partials/user/footer")%>



<script>
//Password Hider
function togglePassword(inputId, iconElement) {
  const input = document.getElementById(inputId);
  const isVisible = input.type === "text";
  input.type = isVisible ? "password" : "text";

  // Optional: Toggle icon text
  iconElement.textContent = isVisible ? "👁️" : "🙈";
}

//Client Side Verification
        const f_nameid = document.getElementsByName('f_name')[0];
        const l_nameid = document.getElementsByName('l_name')[0];
        const emailid = document.getElementsByName('email')[0];
        const passwordid = document.getElementsByName('password')[0];
        const cPasswordid = document.getElementsByName('cPassword')[0];
        const termsCheckbox = document.getElementById('termsCheckbox');

        const err1id = document.getElementById('err1');
        const err2id = document.getElementById('err2');
        const err3id = document.getElementById('err3');
        const err4id = document.getElementById('err4');
        const err5id = document.getElementById('err5');
        const err6id = document.getElementById('err6');

        const signformid = document.getElementById('signForm');

        function f_nameValidateCheck() {
        const val = f_nameid.value.trim();
            const pattern = /^[A-Za-z]+$/;

            if (!val) {
              err1id.innerHTML = "First name is required";
              err1id.style.display = 'block';
            } else if (val.length < 2) {
              err1id.innerHTML = "Minimum 2 characters required";
              err1id.style.display = 'block';
            } else if (!pattern.test(val)) {
              err1id.innerHTML = "Only alphabets allowed";
              err1id.style.display = 'block';
            } else {
              err1id.style.display = 'none';
              err1id.innerHTML = "";
            }
        }

        function l_nameValidateCheck() {
            const val = l_nameid.value.trim();
            const pattern = /^[A-Za-z]+$/;

            if (!val) {
              err2id.innerHTML = "Last name is required";
              err2id.style.display = 'block';
            } else if (val.length < 2) {
              err2id.innerHTML = "Minimum 2 characters required";
              err2id.style.display = 'block';
            } else if (!pattern.test(val)) {
              err2id.innerHTML = "Only alphabets allowed";
              err2id.style.display = 'block';
            } else {
              err2id.style.display = 'none';
              err2id.innerHTML = "";
            }
        }

    
        function emailValidateCheck() {
          const val = emailid.value.trim();
          const pattern = /^[a-z0-9._%+-]+@[a-z.-]+\.[a-z]{2,}$/;
        
          if (!val) {
            err3id.innerHTML = "Email is required";
            err3id.style.display = 'block';
          } else if (!pattern.test(val)) {
            err3id.innerHTML = "Please enter a valid email-id";
            err3id.style.display = 'block';
          } else {
            err3id.style.display = 'none';
            err3id.innerHTML = "";
          }
        }
    
        function passValidateCheck() {
          const passval = passwordid.value;
          const cpassval = cPasswordid.value;
        
          const alpha = /[a-zA-Z]/;
          const digit = /\d/;
        
          if (passval.length < 8) {
            err4id.innerHTML = "Should contain at least 8 characters";
            err4id.style.display = 'block';
          } else if (!alpha.test(passval) || !digit.test(passval)) {
            err4id.innerHTML = "Password must contain letters and numbers";
            err4id.style.display = 'block';
          } else {
            err4id.style.display = 'none';
            err4id.innerHTML = "";
          }
      
          if (passval !== cpassval) {
            err5id.innerHTML = "Passwords do not match";
            err5id.style.display = 'block';
          } else {
            err5id.style.display = 'none';
            err5id.innerHTML = "";
          }
        }
    
        function termsValidation() {
          if (!termsCheckbox.checked) {
            err6id.innerHTML = "Please accept T&C";
            err6id.style.display = 'block';
          } else {
            err6id.style.display = 'none';
            err6id.innerHTML = "";
          }
        }
    
        document.addEventListener('DOMContentLoaded', () => {
          signformid.addEventListener("submit", function (e) {
            f_nameValidateCheck();
            l_nameValidateCheck();
            emailValidateCheck();
            passValidateCheck();
            termsValidation();

            if (
              err1id.innerHTML || err2id.innerHTML || err3id.innerHTML ||
              err4id.innerHTML || err5id.innerHTML || err6id.innerHTML
            ) {
              e.preventDefault();
            }
          });
        });


    </script>

