<%- include("../../views/Partials/user/header-ho") %>
<hr style="margin: 0rem 0rem 1rem 0rem;">
<link rel="stylesheet" href="/User-css/dashboard.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Toastr CSS & JS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

<!-- Font&Icon -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- breadcrumb -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <% breadcrumbs.forEach((crumb, index) => { %>
        <li class="breadcrumb-item <%= index === breadcrumbs.length - 1 ? 'active' : '' %>">
          <% if (index !== breadcrumbs.length - 1) { %>
            <a href="<%= crumb.url %>"><%= crumb.name %></a>
          <% } else { %>
            <%= crumb.name %>
          <% } %>
        </li>
      <% }) %>
    </ol>
  </nav>

<div class="page-wrapper">
  <!-- =======================Left area================= -->
  <div class="navigation-panel">
    <div class="nav-header">Navigation</div>
    
    <div class="nav-item active" onclick="window.location.href='/account'">
      <span class="material-symbols-outlined">Dashboard</span>Dashboard
    </div>
    <div class="nav-item" onclick="window.location.href=''">
      <i class="fa-solid fa-rotate"></i> Order History
    </div>
    <div class="nav-item" onclick="window.location.href=''">
      <span class="material-symbols-outlined">favorite</span>Wishlist
    </div>
    <div class="nav-item" onclick="window.location.href=''">
      <span class="material-symbols-outlined">shopping_cart</span>Shopping Cart
    </div>
    <div class="nav-item" onclick="window.location.href='/account-settings'">
      <span class="material-symbols-outlined">settings</span>Settings
    </div>
    <div class="nav-item" onclick="window.location.href='#'">
      <span class="material-symbols-outlined">wallet</span>Wallet
    </div>
    <div class="nav-item" onclick="window.location.href='/logout'">
      <span class="material-symbols-outlined">logout</span>Log-out
    </div>
  </div>

  <!-- =================== right container ======================= -->
  <div class="rgh-container">
    <img src="/profile pic.jpg" alt="TezBag Profile Pic">
    <h4><%= userName %></h4>
    <p class="user-role">Customer</p>
    <a href="/account-settings" class="custom-link">
      <h5>Edit Profile</h5>
    </a>      
  </div>  
  <div class="rgh-container2">
    <p class="add">ADDRESS</p>
    <h4><%= userName %></h4>
    <p class="mail"><%= userEmail%></p>
    <% if (address && address !== 'Not provided') { %>
        <p class="add">
          <%= address.streetAddress || '' %>
          <%= address.city ? ', ' + address.city : '' %>
          <%= address.state ? ', ' + address.state : '' %>
          <%= address.pinCode ? ', ' + address.pinCode : '' %>
        </p>
        <p class="num"><%= address.phone%></p>
      <% } else { %>
        <p style="color: #7b7b7b; margin: 1rem 0;">Add Address to see magic!</p>
      <% } %>
    <a href="/account-settings" class="custom-link-add">
      <h5>Add/Edit Address</h5>
    </a>
  </div>
  <div class="rgh-container3">
    <div class="order-history-header">
      <h2>Recent Order History</h2>
      <a href="#" class="view-all">View All</a>
    </div>
    
    <% if (orders.length > 0) { %>
      <table class="order-table">
        <thead>
          <tr>
            <th>ORDER ID</th>
            <th>DATE</th>
            <th>TOTAL</th>
            <th>STATUS</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(order => { %>
            <tr>
              <td>#<%= order.orderId.split('-')[0].slice(0, 3) %></td>
              <td><%= new Date(order.createdOn).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td><%= order.finalAmount.toFixed(2) %> ₹</td>
              <td class="status <%= order.status.toLowerCase().replace(/\s+/g, '-') %>">
                <%= order.status %>
              </td>
              <td><a href="/order-details/<%= order._id %>" class="view-details">View Details</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
        <div style="
        height: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        font-size: 1.1rem;
        color: #666;
      ">
        Buy Anything to see magic!
      </div>
    <% } %>
  </div>
</div>

<!-- ======================== logout modal ================================= -->
<div id="logout-modal" class="modal" style="display:none;">
  <div class="modal-content">
    <h3>Are you sure?</h3>
    <div class="modal-buttons">
      <button id="cancel-logout" class="btn-no">NO</button>
      <button id="confirm-logout" class="btn-yes">YES</button>
    </div>
  </div>
</div>

<script>
// JavaScript to handle the modal functionality
document.addEventListener('DOMContentLoaded', function() {
  const logoutBtn = document.querySelector('.nav-item[onclick*="logout"]') || document.querySelector('.log-out');
  const modal = document.getElementById('logout-modal');
  const cancelBtn = document.getElementById('cancel-logout');
  const confirmBtn = document.getElementById('confirm-logout');
  
  if (logoutBtn) {
    const originalOnClick = logoutBtn.getAttribute('onclick');
    logoutBtn.removeAttribute('onclick');
    
    logoutBtn.addEventListener('click', function(e) {
      e.preventDefault();
      modal.style.display = 'flex';
    });
  }
  
  cancelBtn.addEventListener('click', function() {
    modal.style.display = 'none';
  });
  
  confirmBtn.addEventListener('click', function() {
    window.location.href = '/logout';
  });
  
  window.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.style.display = 'none';
    }
  });
});
</script>

<%- include("../../views/Partials/user/footer") %>